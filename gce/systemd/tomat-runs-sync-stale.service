[Unit]
Description=tomat: full-sweep runs sync (every 30 min)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ryan
WorkingDirectory=/home/ryan/tomat
EnvironmentFile=-/etc/default/tomat-monitor
ExecStart=/home/ryan/tomat/gce/sync/runs-sync-stale.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
