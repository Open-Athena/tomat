[Unit]
Description=tomat: sync active runs (every 2 min)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ryan_williams_openathena_ai
WorkingDirectory=/home/ryan_williams_openathena_ai/tomat
# Put the existing iris-sync-venv on PATH first so `./tomat` (and the
# `python` shebang on it) picks up the venv's interpreter + installed
# deps. See `gce/README.md` for why we re-use the venv that the legacy
# crontab-based iris-sync/runs-sync already provisioned.
Environment=PATH=/home/ryan_williams_openathena_ai/iris-sync-venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/ryan_williams_openathena_ai
Environment=GOOGLE_APPLICATION_CREDENTIALS=/home/ryan_williams_openathena_ai/.config/gcloud/application_default_credentials.json
Environment=AWS_SHARED_CREDENTIALS_FILE=/home/ryan_williams_openathena_ai/.aws/credentials
Environment=AWS_PROFILE=cfo
# `~/.wandb-api-key` is the raw single-line key the legacy cron scripts
# read; `install.sh` synthesizes `~/.wandb-api-key.env` (KEY=VAL form) as
# a derivative for systemd's `EnvironmentFile=`.
EnvironmentFile=/home/ryan_williams_openathena_ai/.wandb-api-key.env
ExecStart=/home/ryan_williams_openathena_ai/tomat/gce/sync/runs-sync-active.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
