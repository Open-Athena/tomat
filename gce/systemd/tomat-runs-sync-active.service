[Unit]
Description=tomat: sync active runs (every 2 min)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ryan
WorkingDirectory=/home/ryan/tomat
EnvironmentFile=-/etc/default/tomat-monitor
ExecStart=/home/ryan/tomat/gce/sync/runs-sync-active.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
