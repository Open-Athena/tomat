@cli.group("iris")
def iris_grp():
    """iris job mgmt — wraps `uv run iris --cluster=marin job ...`."""


def _parent_jids_matching(substr: str) -> list[str]:
    """Return parent (top-level) iris job IDs whose name contains SUBSTR."""
    matches = []
    for line in iris_list_lines():
        jid = line.split()[0]
        # Skip child tasks (extra path segments beyond /<user>/<job>)
        if jid.count("/") > 2:
            continue
        if substr in jid:
            matches.append(jid)
    return matches


def _walk_pools(node, parent_name=None):
    """Yield `{name, status, ready, reason, counts}` for every autoscaler pool."""
    if isinstance(node, dict):
        nm = node.get("name", parent_name)
        if "availability_status" in node:
            counts = node.get("slice_state_counts") or {}
            yield {
                "name": nm,
                "status": node.get("availability_status"),
                "ready": counts.get("ready", 0),
                "counts": counts,
                "reason": (node.get("availability_reason") or "").strip(),
            }
        for v in node.values():
            yield from _walk_pools(v, nm)
    elif isinstance(node, list):
        for v in node:
            yield from _walk_pools(v, parent_name)


@iris_grp.command("avail")
@click.option("-a", "--all", "show_all", is_flag=True, help="show every pool, including empty/`available` ones")
@click.option("-j", "--json", "as_json", is_flag=True, help="emit JSON instead of the human table")
@click.option("-t", "--tpu", default=None, help="substring filter on pool name (e.g. 'v5p', 'v6e', 'v4-')")
def iris_avail(show_all: bool, as_json: bool, tpu: str | None):
    """Show TPU pool availability via `iris rpc controller get-autoscaler-status`.

    Default view: pools with non-zero `ready` slices or a non-`available`
    status (quota_exceeded, backoff, requesting, cooldown). Use `-a` for the
    full dump (~150 pools).
    """
    cmd = [IRIS_BIN, "--cluster=marin", "rpc", "controller", "get-autoscaler-status"]
    r = subprocess.run(cmd, cwd=str(MARIN_DIR), capture_output=True, text=True, timeout=60)
    if r.returncode != 0:
        err(f"iris rpc failed: rc={r.returncode}\n{r.stderr}")
        sys.exit(r.returncode)
    out = strip_iris_log(r.stdout).strip()
    data = json.loads(out)
    pools = [p for p in _walk_pools(data) if p["name"]]
    if tpu:
        pools = [p for p in pools if tpu in p["name"]]
    pools.sort(key=lambda p: (p["status"] != "available", -p["ready"], p["name"]))

    def interesting(p):
        return show_all or p["ready"] > 0 or p["status"] != "available"

    pools = [p for p in pools if interesting(p)]
    if as_json:
        print(json.dumps(pools, indent=1, default=str))
        return
    if not pools:
        print("(no pools matched)")
        return
    print(f"{'STATUS':18s}  {'READY':>5s}  POOL")
    for p in pools:
        suffix = f"  {p['reason'][:50]}" if p["reason"] else ""
        print(f"{p['status']:18s}  {p['ready']:>5d}  {p['name']}{suffix}")


# iris job-state codes (from marin/lib/iris/docs/task-states.md).
_IRIS_JOB_STATE = {
    1: "PENDING",
    2: "BUILDING",
    3: "RUNNING",
    4: "SUCCEEDED",
    5: "FAILED",
    6: "KILLED",
    7: "WORKER_FAILED",
    8: "UNSCHEDULABLE",
}


def _iris_attempts_dump(job_id: str, tail: int = 0, timeout: int = 90) -> dict | None:
    """Invoke `scripts/iris_attempts_dump.py` via marin's venv python.

    The helper registers a custom `attempts-dump` subcommand on iris's own
    Click group, which inherits all of iris's `--cluster=marin` /
    controller-URL / token-provider setup automatically. See its docstring.

    Returns the parsed payload, or `None` on subprocess failure (so a single
    bad label doesn't break a sweep across all training runs in `iris sync`).
    """
    helper = PROJECT_ROOT / "scripts" / "iris_attempts_dump.py"
    py = str(MARIN_DIR / ".venv" / "bin" / "python")
    cmd = [py, str(helper), "--cluster=marin", "attempts-dump",
           "--tail", str(tail), job_id]
    t0 = time.monotonic()
    try:
        r = subprocess.run(cmd, cwd=str(MARIN_DIR), capture_output=True,
                           text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        err(f"[iris-attempts {job_id}] TIMEOUT after {timeout}s")
        return None
    elapsed_ms = int((time.monotonic() - t0) * 1000)
    err(f"[iris-attempts {job_id} {elapsed_ms}ms]"
        + (" SLOW" if elapsed_ms > 10_000 else ""))
    if r.returncode != 0:
        err(f"iris attempts dump failed for {job_id}: rc={r.returncode}\n{r.stderr[-500:]}")
        return None
    # iris log lines may precede the JSON.
    i = r.stdout.find("{")
    if i < 0:
        err(f"iris attempts dump for {job_id}: no JSON in stdout")
        return None
    try:
        return json.loads(r.stdout[i:])
    except json.JSONDecodeError as e:
        err(f"iris attempts dump for {job_id}: JSON decode failed: {e}")
        return None


def _iris_query_json(sql: str, timeout: int = 60) -> list[dict]:
    """Run a controller SQL query and parse the JSON result.

    Times every call. Warns loudly if elapsed > 10 s — that's the Russell
    threshold for "you are putting load on the shared controller." See
    `memory/feedback_iris_controller_load.md`. The single user of this
    helper today is `tomat iris sync`, whose LEFT JOIN was exactly the
    pattern that prompted the complaint.
    """
    cmd = [IRIS_BIN, "--cluster=marin", "query", sql, "-f", "json"]
    t0 = time.monotonic()
    r = subprocess.run(cmd, cwd=str(MARIN_DIR), capture_output=True, text=True, timeout=timeout)
    elapsed_ms = int((time.monotonic() - t0) * 1000)
    if elapsed_ms > 10_000:
        err(f"⚠️  [iris-query {elapsed_ms}ms] SLOW — controller may be under load")
    else:
        err(f"[iris-query {elapsed_ms}ms]")
    if r.returncode != 0:
        err(f"iris query failed: rc={r.returncode}\n{r.stderr[-500:]}")
        sys.exit(r.returncode)
    return json.loads(strip_iris_log(r.stdout).strip())


def _iris_job_list_json(prefix: str, timeout: int = 60) -> list[dict]:
    """RPC-only: `iris job list --prefix PFX --json`. Safe to call on a cadence.

    Replaces the controller-SQL `_iris_query_json` for the dashboard sync.
    See `memory/feedback_iris_controller_load.md` — RPC is fine, SQL JOINs
    on `jobs × tasks` are what melt the shared controller.
    """
    cmd = [IRIS_BIN, "--cluster=marin", "job", "list",
           "--prefix", prefix, "--json"]
    t0 = time.monotonic()
    r = subprocess.run(cmd, cwd=str(MARIN_DIR), capture_output=True, text=True, timeout=timeout)
    elapsed_ms = int((time.monotonic() - t0) * 1000)
    if elapsed_ms > 10_000:
        err(f"⚠️  [iris-rpc {prefix} {elapsed_ms}ms] SLOW")
    else:
        err(f"[iris-rpc {prefix} {elapsed_ms}ms]")
    if r.returncode != 0:
        err(f"iris job list failed: rc={r.returncode}\n{r.stderr[-500:]}")
        return []
    return json.loads(strip_iris_log(r.stdout).strip())


# Regex mirrors site/src/runs/RunsPage.tsx :: `trainingRunIdFromIrisJob`.
# Used by `iris sync` to decide which parent jobs warrant a per-label
# attempts sidecar (training runs only — not the m-eval / tomat-eval
# sidecar jobs, which would just bloat the snapshot).
TRAINING_JOB_RE = re.compile(r"^/[^/]+/(train-[^/]+)$")


@iris_grp.command("attempts")
@click.argument("label")
@click.option("-o", "--out", default=None,
              help="write JSON here (default: stdout)")
@click.option("-t", "--tail", default=0, type=int,
              help="recent log lines per task (default 0 → skip log fetch; "
              "bug-report defaults to 50, but logs are slow and not needed)")
def iris_attempts(label: str, out: str | None, tail: int):
    """Dump per-attempt history for an iris job, as JSON.

    LABEL is either a full job id (`/ryan/train-mg-tz-11`) or just the
    trailing label (`train-mg-tz-11`, expanded to `/ryan/train-mg-tz-11`).

    Output shape mirrors iris's `AttemptReport` dataclass, with epoch_ms
