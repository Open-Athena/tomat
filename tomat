def _r2_get_json(bucket: str, key: str, timeout: int = 60) -> dict | list | None:
    """Fetch `s3://<bucket>/<key>` from R2 → parsed JSON, or None on 404."""
    import tempfile
    with tempfile.NamedTemporaryFile(suffix=".json", delete=False) as f:
        path = f.name
    try:
        r = subprocess.run(
            ["aws", "--profile", "cfo", "--endpoint-url", R2_ENDPOINT,
             "s3", "cp", f"s3://{bucket}/{key}", path],
            capture_output=True, text=True, timeout=timeout,
        )
        if r.returncode != 0:
            # NoSuchKey / 404 is common (cost.json doesn't exist yet for fresh
            # runs); only warn on truly unexpected failures.
            stderr = r.stderr or ""
            if "NoSuchKey" in stderr or "Not Found" in stderr or "404" in stderr:
                return None
            err(f"[r2 get] aws s3 cp s3://{bucket}/{key} failed: "
                f"rc={r.returncode} stderr={stderr[-300:]}")
            return None
        try:
            return json.loads(Path(path).read_text())
        except json.JSONDecodeError as e:
            err(f"[r2 get] {key}: JSON decode failed: {e}")
            return None
    finally:
        Path(path).unlink(missing_ok=True)


def _r2_list_keys(bucket: str, prefix: str) -> list[str]:
    """Return every R2 key under `s3://<bucket>/<prefix>` (no delimiter)."""
    r = subprocess.run(
        ["aws", "--profile", "cfo", "--endpoint-url", R2_ENDPOINT,
         "s3api", "list-objects-v2",
         "--bucket", bucket,
         "--prefix", prefix,
         "--query", "Contents[].Key",
         "--output", "text"],
        capture_output=True, text=True, timeout=60,
    )
    if r.returncode != 0:
        err(f"[r2 list-keys] failed: rc={r.returncode} stderr={r.stderr[-300:]}")
        return []
    keys: list[str] = []
    for tok in (r.stdout or "").replace("\t", "\n").split("\n"):
        tok = tok.strip()
        if not tok or tok == "None":
            continue
        keys.append(tok)
    return sorted(keys)


def _r2_delete_key(bucket: str, key: str) -> bool:
    """Delete one R2 object. Returns True on success."""
    r = subprocess.run(
        ["aws", "--profile", "cfo", "--endpoint-url", R2_ENDPOINT,
         "s3", "rm", f"s3://{bucket}/{key}"],
        capture_output=True, text=True, timeout=60,
    )
    if r.returncode != 0:
        err(f"[r2 rm] s3://{bucket}/{key} failed: rc={r.returncode} stderr={r.stderr[-300:]}")
        return False
    return True


def _r2_list_synced_runs(bucket: str, prefix: str) -> list[str]:
    """Return the sorted list of run labels under `s3://<bucket>/<prefix>/`."""
    r = subprocess.run(
        ["aws", "--profile", "cfo", "--endpoint-url", R2_ENDPOINT,
         "s3api", "list-objects-v2",
         "--bucket", bucket,
         "--prefix", f"{prefix}/",
         "--delimiter", "/",
         "--query", "CommonPrefixes[].Prefix",
         "--output", "text"],
        capture_output=True, text=True, timeout=60,
    )
    if r.returncode != 0:
        err(f"[r2 list] failed: rc={r.returncode} stderr={r.stderr[-300:]}")
        return []
    labels: list[str] = []
    # `--output text` returns space-/tab-separated tokens like
    # `tomat/runs/foo/\ttomat/runs/bar/`.
    for tok in (r.stdout or "").replace("\t", "\n").split("\n"):
        tok = tok.strip()
        if not tok or tok == "None":
            continue
        # Strip the prefix + trailing slash.
        if tok.startswith(f"{prefix}/") and tok.endswith("/"):
            label = tok[len(prefix) + 1 : -1]
            if label:
                labels.append(label)
    return sorted(labels)


def _compute_one_cost(
    run_label: str,
    *,
    bucket: str,
    runs_prefix: str,
    attempts_prefix: str,
    iris_state: dict | None,
    dry_run: bool,
    manifest: dict | None = None,
) -> dict | None:
    """Compute + (optionally) upload one run's cost.json. Returns the record.

    Skips runs we can't make a TPU MSRP estimate for (no recognisable TPU
    suffix AND no iris job AND not a Modal run). For Modal runs, we read
    the manifest (passed in or freshly fetched) to derive wallclock from
    wandb's tracked history span — Phase B of spec 46.
    """
    from tomat.cost import (
        build_cost_record,
        compute_modal_segment_from_manifest,
        compute_tpu_segment_from_manifest,
        compute_tpu_segments,
        compute_tpu_segments_from_job_window,
        CostSegment,
        detect_allocation_class,
        parse_tpu_hardware,
        parse_tpu_hardware_from_attempts,
        parse_tpu_hardware_from_manifest,
        TpuVariant,
    )
    from datetime import datetime, timezone

    now_ms = int(time.time() * 1000)
    now_iso = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    notes: list[str] = []

    # Attempts sidecar (TPU runs only). 404 is fine — we'll fall back to
    # iris-state for the full window.
    attempts = _r2_get_json(bucket, f"{attempts_prefix}/{run_label}.json")
    # Iris job (parent) entry from the snapshot.
    job: dict | None = None
    if iris_state is not None:
        job = iris_state.get("jobs", {}).get(f"/{IRIS_USER}/{run_label}")
    # Manifest — lazily fetched. Required for Modal runs (we read
    # `history.ts_min/max` for wallclock). Caller may pass it in to avoid
    # a redundant R2 round-trip when we just wrote it (see `runs_sync`).
    if manifest is None:
        manifest = _r2_get_json(bucket, f"{runs_prefix}/{run_label}/manifest.json")

    # Try to parse TPU hardware from the label. Modal runs (h100x8, h200x8,
    # b200x8) won't match — they get the Phase-B placeholder.
    is_modal_run = ("-modal-" in run_label
                    or re.search(r"-(?:h100|h200|b200|a100|l40s)x\d+\b", run_label, re.I) is not None)
    parsed = parse_tpu_hardware(run_label)
    # Fallback for run labels without an hw suffix (e.g. `train-mg-tz-11`):
    # sniff the slice out of the attempts sidecar's worker hostnames.
    if parsed is None and not is_modal_run:
        parsed = parse_tpu_hardware_from_attempts(attempts)
        if parsed is not None:
            notes.append(
                f"hardware inferred from attempts sidecar worker hostname: "
                f"{parsed[0]}-{parsed[1]}"
            )
    # Final fallback: read `summary.throughput/device_kind` + `num_devices`
    # from the wandb manifest. Catches in-flight TPU runs whose iris job has
    # churned past iris-state's snapshot AND whose attempts sidecar hasn't
    # been written yet (e.g. `kl-s05-tpu-cont-v3` mid-run).
    if parsed is None and not is_modal_run:
        parsed = parse_tpu_hardware_from_manifest(manifest)
        if parsed is not None:
            notes.append(
                f"hardware inferred from wandb summary device_kind: "
                f"{parsed[0]}-{parsed[1]}"
            )

    segments: list[CostSegment] = []
    is_complete = False

    if parsed is None and is_modal_run:
        # Phase B: derive Modal wallclock from the wandb manifest. The
        # parquet `history.ts_max - ts_min` span survives Modal-fn restarts
        # (same wandb run id across re-attaches) so it correctly aggregates
        # multi-session runs like `v4-epochwin`. Falls back to `_runtime`
        # when ts_min/ts_max aren't both populated (very fresh run).
        modal_seg = compute_modal_segment_from_manifest(
            run_label, manifest, now_ms=now_ms,
        )
        if modal_seg is not None:
            segments.append(modal_seg)
        else:
            # No usable wallclock signal yet (no manifest, no history rows).
            # Emit the "TBD" placeholder so the dashboard chip still
            # renders honestly rather than silently dropping to $0.
            notes.append("Modal MSRP: no usable wallclock signal yet "
                         "(manifest missing or no history rows)")
            segments.append(CostSegment(
                kind="modal",
                label="Modal MSRP TBD",
                wallclock_sec=0.0,
                rate_per_hr_usd=None,
                msrp_usd=None,
                source="awaiting-first-history-row",
            ))
        # is_complete: a Modal run is "done" when wandb reports a terminal
        # state (finished / crashed / failed / killed). Cheap signal from
        # the manifest we just read.
        if manifest is not None:
            wb_state = (manifest.get("run") or {}).get("state")
            is_complete = wb_state in {"finished", "crashed", "failed", "killed"}
        notes.append(
            "Modal MSRP is an estimate from wandb-tracked wallclock × "
            "published per-GPU-hour rates (snapshot pricing); see spec 46."
        )
    elif parsed is not None:
        family, num_chips = parsed
        alloc = detect_allocation_class(attempts)
        variant = TpuVariant(
            variant=family,
            num_chips=num_chips,
            allocation_class=alloc,
        )
        if variant.rate_usd_per_chip_hr is None:
            notes.append(f"no published rate for TPU variant={family}")
        elif attempts is not None:
            attempt_segs = compute_tpu_segments(attempts, variant, now_ms=now_ms)
            is_complete = attempts.get("finished_at_ms") is not None
            # iris's `gather_bug_report` only preserves the most-recent attempt
            # per task — prior failed/preempted cycles are dropped. When the
            # job's failure+preempt counters exceed what we see in the
            # sidecar, the per-attempt walk UNDERCOUNTS prior cycles.
            n_attempts_seen = len({
                a.get("attempt_id") for t in attempts.get("tasks", [])
                for a in t.get("attempts", []) if a.get("attempt_id") is not None
            })
            f = (attempts.get("job_failure_count") or 0)
            p = (attempts.get("job_preemption_count") or 0)
            historical_cycles = f + p
            undercounted = historical_cycles > n_attempts_seen
            # When the sidecar undercounts, try progressively wider sources
            # to surface a realistic chip number:
            #   1. iris-state job window: full submitted→finished wallclock
            #      for the CURRENT iris-job entry.
            #   2. wandb history ts span: covers ALL iris re-fires (the
            #      same wandb run id survives iris label re-submission).
            # Pick the LONGEST wallclock among the candidates that produced
            # a segment. Without this, runs with dropped historical cycles
            # report ~$1 instead of their real cost.
            chosen_seg: CostSegment | None = None
            chosen_source: str | None = None
            if undercounted:
                candidates: list[tuple[CostSegment, str]] = []
                if job is not None:
                    js = compute_tpu_segments_from_job_window(
                        job, variant, now_ms=now_ms,
                    )
                    if js:
                        candidates.append((js[0], "iris-state job window"))
                ms = compute_tpu_segment_from_manifest(variant, manifest)
                if ms is not None:
                    candidates.append((ms, "wandb history ts span (all re-fires)"))
                if candidates:
                    chosen_seg, chosen_source = max(
                        candidates, key=lambda x: x[0].wallclock_sec,
                    )
            if chosen_seg is not None:
                segments.append(chosen_seg)
                notes.append(
                    f"used {chosen_source}: {historical_cycles} historical "
                    f"failure/preempt cycles vs {n_attempts_seen} attempt(s) "
                    f"in sidecar — the sidecar's per-attempt detail would "
                    f"undercount."
                )
            else:
                segments.extend(attempt_segs)
                if not segments:
                    notes.append("no billable attempt windows in sidecar")
                elif undercounted:
                    notes.append(
                        f"undercount: {historical_cycles} historical "
                        f"failure/preempt cycles vs {n_attempts_seen} "
                        f"attempt(s) in sidecar (iris bug-report drops prior)"
                    )
        elif job is not None:
            # No attempts sidecar. Take the LONGER of the iris-state
            # job-window (current iris-job entry) and the wandb-tracked
            # history span (covers all iris re-fires) — same logic as the
            # undercounted-attempts branch.
            js = compute_tpu_segments_from_job_window(
                job, variant, now_ms=now_ms,
            )
            ms = compute_tpu_segment_from_manifest(variant, manifest)
            candidates: list[tuple[CostSegment, str]] = []
            if js:
                candidates.append((js[0], "iris-state job window"))
            if ms is not None:
                candidates.append((ms, "wandb history ts span (all re-fires)"))
            if candidates:
                seg, src = max(candidates, key=lambda x: x[0].wallclock_sec)
                segments.append(seg)
                notes.append(f"no attempts sidecar; used {src}")
            is_complete = job.get("finished_at_ms") is not None
        else:
            # No attempts sidecar AND no iris-state entry. Last fallback:
            # the wandb manifest's tracked history span. Honest about the
            # source in the tooltip.
            ms = compute_tpu_segment_from_manifest(variant, manifest)
            if ms is not None:
                segments.append(ms)
                notes.append("no attempts sidecar, no iris-state job entry; "
                             "used wandb history ts span")
            else:
                notes.append("no attempts sidecar AND no iris-state job entry "
                             "AND no wandb history span; MSRP estimate "
                             "unavailable for this TPU run")
    else:
        notes.append(f"unrecognised hardware for run {run_label!r} — "
                     f"no TPU suffix found; not a Modal run by name")

    record = build_cost_record(
        segments,
        is_complete=is_complete,
        computed_at_iso=now_iso,
        notes=notes,
    )
    key = f"{runs_prefix}/{run_label}/cost.json"
    data = json.dumps(record, separators=(",", ":")).encode("utf-8")
    if dry_run:
        err(f"[cost compute] dry-run: {run_label} → ${record['msrp_usd']:.2f} "
            f"({len(record['breakdown'])} segments, {len(data)} B) "
            f"→ s3://{bucket}/{key}")
    else:
        _r2_put_bytes(bucket, key, data, "application/json")
        err(f"[cost compute] {run_label}: ${record['msrp_usd']:.2f} "
            f"({len(record['breakdown'])} segments) "
            f"→ {R2_ENDPOINT}/{bucket}/{key}")
    return record


@cost_grp.command("compute")
@click.option("-b", "--bucket", default=R2_BUCKET, help="R2 bucket")
@click.option("-p", "--prefix", default=R2_RUNS_PREFIX,
              help="R2 key prefix for runs/<label>/cost.json")
@click.option("--attempts-prefix", default="tomat/iris-attempts",
              help="R2 prefix for attempts sidecars")
@click.option("-a", "--all", "all_runs", is_flag=True,
              help="iterate every synced run instead of one LABEL")
@click.option("-n", "--dry-run", is_flag=True,
              help="compute + print, but skip the R2 upload")
@click.argument("run_label", required=False)
def cost_compute(
    run_label: str | None,
    bucket: str,
    prefix: str,
    attempts_prefix: str,
    all_runs: bool,
    dry_run: bool,
):
    """Write `runs/<label>/cost.json` with the run's MSRP estimate.

    For an iris (TPU) run: walks the attempts sidecar, multiplying each
    task-attempt's wallclock × num_chips × rate. Falls back to the parent
    iris-state window (with a note) for older runs without a sidecar.

    For a Modal run: emits a placeholder `Modal MSRP TBD` segment so the
    dashboard chip renders an honest "pending" rather than $0 (Phase B).

    Idempotent: re-runs overwrite the sidecar with the freshest estimate.
    --all backfills every synced run; useful one-shot after a pricing
    table change.
    """
    if all_runs and run_label:
        raise click.UsageError("pass either RUN_LABEL or --all, not both")
    if not all_runs and not run_label:
        raise click.UsageError("provide RUN_LABEL or --all")

    # Iris-state is shared across all the runs we visit; fetch once.
    iris_state = _r2_get_json(bucket, "tomat/iris-state.json")
    if iris_state is None:
        err("[cost compute] WARN: iris-state.json not found on R2; "
            "fallback (job-window) estimates won't be available")

    if all_runs:
        labels = _r2_list_synced_runs(bucket, prefix)
        err(f"[cost compute] --all: {len(labels)} synced runs under "
            f"s3://{bucket}/{prefix}/")
        n_ok = n_skip = 0
        for label in labels:
            try:
                _compute_one_cost(
                    label,
                    bucket=bucket,
                    runs_prefix=prefix,
                    attempts_prefix=attempts_prefix,
                    iris_state=iris_state,
                    dry_run=dry_run,
                )
                n_ok += 1
            except Exception as e:
                err(f"[cost compute] {label}: FAILED ({type(e).__name__}: {e})")
                n_skip += 1
        err(f"[cost compute] --all done: {n_ok} ok, {n_skip} failed")
    else:
        assert run_label
        _compute_one_cost(
            run_label,
            bucket=bucket,
            runs_prefix=prefix,
            attempts_prefix=attempts_prefix,
            iris_state=iris_state,
            dry_run=dry_run,
        )


@cli.group("marin")
def marin_grp():
    """Manage the marin-* (marin/levanter/iris/...) SHA pin in marin/pyproject.toml."""


_MARIN_PIN_RE = re.compile(
    r'^(marin-\S+\s*=\s*\{\s*git\s*=\s*"https://github\.com/marin-community/marin",\s*rev\s*=\s*")[0-9a-f]{40}(",\s*subdirectory\s*=\s*"lib/\S+"\s*\})\s*$',
    re.MULTILINE,
)


def _read_current_marin_pin() -> str:
    """Read the current pinned SHA from marin/pyproject.toml. Asserts all 7
    marin-* lines pin the same SHA (which they always have)."""
    txt = (MARIN_DIR / "pyproject.toml").read_text()
    shas = re.findall(r'rev = "([0-9a-f]{40})"', txt)
    if not shas:
        raise click.ClickException("no marin-* SHA pins found in marin/pyproject.toml")
    if len(set(shas)) > 1:
        raise click.ClickException(f"marin-* pins disagree (found {len(set(shas))} distinct SHAs); fix manually")
    return shas[0]


def _rewrite_marin_pin(new_sha: str) -> int:
    """In-place rewrite all marin-* SHA pins. Returns number of lines changed."""
    pyp = MARIN_DIR / "pyproject.toml"
    txt = pyp.read_text()
    new_txt, n = _MARIN_PIN_RE.subn(rf"\g<1>{new_sha}\g<2>", txt)
    if n == 0:
        raise click.ClickException("no marin-* pin lines matched the rewrite regex; file format may have changed")
    pyp.write_text(new_txt)
    return n


def _resolve_marin_sha(sha: str) -> str:
    """Resolve 'latest', a branch name, or a short SHA to a full 40-char SHA
    via `gh api`. Raises if the ref doesn't exist."""
    ref = "main" if sha == "latest" else sha
    r = subprocess.run(
        ["gh", "api", f"repos/marin-community/marin/commits/{ref}", "--jq", ".sha"],
        capture_output=True, text=True,
    )
    if r.returncode != 0:
        raise click.ClickException(f"gh api failed to resolve marin-community/marin@{ref}: {r.stderr.strip()}")
    full = r.stdout.strip()
    if not re.fullmatch(r"[0-9a-f]{40}", full):
        raise click.ClickException(f"unexpected gh api response for {ref}: {full!r}")
    return full


@marin_grp.command("status")
def marin_status():
    """Show the current marin-* pin, the latest upstream main SHA, and
    how many commits we're behind."""
    cur = _read_current_marin_pin()
    print(f"current pin: {cur}")
    r = subprocess.run(
        ["gh", "api", f"repos/marin-community/marin/compare/{cur}...main",
         "--jq", "{behind: .behind_by, ahead: .ahead_by, latest: .merge_base_commit.sha}"],
        capture_output=True, text=True,
    )
    if r.returncode != 0:
        err(f"gh api compare failed: {r.stderr.strip()}")
        return
    info = json.loads(r.stdout)
    latest = _resolve_marin_sha("latest")
    print(f"latest main: {latest}")
    # gh api `compare/{base}...{head}` returns ahead_by = commits head has
    # that base doesn't = how many commits "main" is ahead of our pin.
    print(f"behind main: {info.get('ahead', '?')} commits  (commits in main we don't have — bump candidates)")
    print(f"ahead of main: {info.get('behind', '?')} commits  (should be 0; non-zero = we've diverged)")


def _fire_smoke_and_wait(
    label: str,
    tpu: str,
    steps: int,
    timeout_s: int,
    poll_s: int = 30,
) -> bool:
    """Fire a `tomat train` smoke and poll iris until it (a) emits a clear
    pass signal (task RUNNING for ≥60s, OR wandb shows step ≥ 1), (b) any
    task FAILS, or (c) timeout elapses.

    Returns True on success, False otherwise.
    """
    import time
    # Fire the smoke. Use --max-retries 0 so any failure surfaces immediately
    # (we want to catch real bugs, not retry past them).
    fire_cmd = [
        sys.executable, str(PROJECT_ROOT / "tomat"),
        "train", label,
        "--steps", str(steps),
        "--tpu", tpu,
        "--force",
        "--no-watch-preempts",
        "--max-retries", "0",
        "--queue",  # wait for capacity
        "--queue-poll", "60",
    ]
    err(f"[marin bump] firing: {' '.join(fire_cmd[1:])}")
    fire_log = PROJECT_ROOT / "tmp" / f"marin-bump-fire-{label}.log"
    fire_log.parent.mkdir(parents=True, exist_ok=True)
    with fire_log.open("w") as f:
        fire = subprocess.run(fire_cmd, stdout=f, stderr=subprocess.STDOUT)
    if fire.returncode != 0:
        err(f"[marin bump] `tomat train` exited {fire.returncode}; see {fire_log}")
        return False

    err(f"[marin bump] smoke submitted; polling every {poll_s}s up to {timeout_s}s …")
    deadline = time.time() + timeout_s
    last_state = ""
    running_since = None
    while time.time() < deadline:
        time.sleep(poll_s)
        # Pull summary
        r = subprocess.run(
            [IRIS_BIN, "job", "summary", label],
            capture_output=True, text=True, timeout=60,
        )
        out = strip_iris_log(r.stdout)
        # Check for FAILED task with non-zero exit (the bug we want to catch)
        if re.search(r"^\s*\d+\s+failed", out, re.MULTILINE):
            err(f"[marin bump] task FAILED — JAX-init-style bug or other smoke fault")
            err(f"  tail of fire log: {fire_log}")
            err(f"  iris logs:        ./tomat iris logs {label} -n 100")
            return False
        # Check for RUNNING task that's been alive ≥60s (signal: JAX init OK)
        # `iris job summary` lines look like:
        #   TASK  STATE    EXIT  DURATION   PEAK MEM  CUR MEM   ERROR
        #      0  running  -     0:02:13    ...
        for m in re.finditer(r"^\s*\d+\s+running\s+\S+\s+(\d+):(\d+):(\d+)", out, re.MULTILINE):
            hh, mm, ss = (int(x) for x in m.groups())
            dur_s = hh * 3600 + mm * 60 + ss
            if dur_s >= 60:
                err(f"[marin bump] task running for {dur_s}s — smoke ✓ (passed JAX init)")
                return True
            running_since = dur_s
        # Show one-line progress
        state = "pending"
        if "running" in out:
            state = f"running ({running_since}s)" if running_since else "running"
        elif "pending" in out:
            state = "pending"
        if state != last_state:
            err(f"[marin bump] state: {state}")
            last_state = state
    err(f"[marin bump] timed out after {timeout_s}s; current state: {last_state}")
    err(f"  ./tomat iris summary {label}")
    return False


@marin_grp.command("bump")
@click.argument("sha")
@click.option("--smoke/--no-smoke", "smoke", default=True,
              help="fire a quick iris job after `uv sync` to verify the new pin runs on real TPU before letting you commit. (Default on — this is the whole point of the cmd.)")
@click.option("-c", "--commit", "auto_commit", is_flag=True,
              help="auto-`git commit` the pin change + uv.lock after smoke passes. Off by default — print git-add cmd + leave WT dirty for review.")
@click.option("--smoke-tpu", default="v6e-8", show_default=True,
              help="TPU pool for the smoke run; should be the smallest available so capacity is easy to grab.")
@click.option("--smoke-steps", default=50, show_default=True, type=int,
              help="`tomat train --steps` for the smoke. We cancel as soon as the task has been RUNNING ≥60s, so this just bounds the worst case.")
@click.option("--smoke-timeout", default=1800, show_default=True, type=int,
              help="overall smoke deadline in seconds, INCLUDING queueing time. Default 30 min.")
def marin_bump(sha: str, smoke: bool, auto_commit: bool,
               smoke_tpu: str, smoke_steps: int, smoke_timeout: int):
    """Bump the marin-* SHA pin in marin/pyproject.toml, verify on real TPU,
    and (optionally) commit.

    Designed to catch dep-bump regressions in ~5 min, instead of after
    multiple multi-hour real runs fail (cf. 2026-05-30 JAX-distributed-init
    surprise that killed 6 jobs).

    SHA can be a full 40-char SHA, a short SHA (≥7), a branch name, or the
    literal `latest` (resolves to upstream main HEAD).

    On success:
      1. Rewrites all 7 marin-* SHA refs in marin/pyproject.toml
      2. `uv sync` in marin/  (fails fast if dep resolution breaks)
      3. Fires `tomat train smoke-<sha7>` on smallest TPU
      4. Polls iris until task is RUNNING ≥60s (= JAX init survived)
      5. Cancels the smoke (no need to burn TPU once init is verified)
      6. Optionally `git commit`s the change

    On failure (any step), leaves the WT dirty so you can debug.

    Examples:
      tomat marin bump latest                # bump to upstream main, smoke, leave dirty
      tomat marin bump latest -c             # bump + smoke + auto-commit
      tomat marin bump 7115c21d --no-smoke   # bump only, no real-TPU verify
    """
    import time
    full_sha = _resolve_marin_sha(sha)
    old_sha = _read_current_marin_pin()
    if old_sha == full_sha:
        err(f"[marin bump] pin already at {full_sha[:7]} — nothing to do")
        return

    err(f"[marin bump] {old_sha[:7]} → {full_sha[:7]}")
    n = _rewrite_marin_pin(full_sha)
    err(f"[marin bump] rewrote {n} pin lines in marin/pyproject.toml")

    err(f"[marin bump] uv sync in {MARIN_DIR}…")
    sync = subprocess.run(["uv", "sync"], cwd=MARIN_DIR)
    if sync.returncode != 0:
        err(f"[marin bump] uv sync FAILED — pin change left in place. Inspect:")
        err(f"  git diff marin/pyproject.toml")
        sys.exit(1)

    if smoke:
        label = f"smoke-{full_sha[:7]}"
        t0 = time.time()
        ok = _fire_smoke_and_wait(label, smoke_tpu, smoke_steps, smoke_timeout)
        dt = int(time.time() - t0)
        if not ok:
            err(f"[marin bump] SMOKE FAILED (after {dt}s) — pin change left in place for debug")
            sys.exit(1)
        err(f"[marin bump] smoke passed (took {dt}s, including queueing)")
        err(f"[marin bump] cancelling smoke job to free the TPU …")
        cancel = subprocess.run([IRIS_BIN, "job", "cancel", label],
                                capture_output=True, text=True, timeout=60)
        if cancel.returncode != 0:
            err(f"[marin bump] WARNING: cancel exited {cancel.returncode}: {cancel.stderr.strip()}")
            err(f"  Run manually: {IRIS_BIN} job cancel {label}")

    if auto_commit:
        err(f"[marin bump] committing pin change …")
        subprocess.run(["git", "add", "marin/pyproject.toml", "marin/uv.lock"],
                       cwd=PROJECT_ROOT, check=True)
        msg_lines = [f"marin: bump pin {old_sha[:7]} → {full_sha[:7]}"]
        if smoke:
            msg_lines.append(f"")
            msg_lines.append(f"Verified via `tomat marin bump` smoke on {smoke_tpu}:")
            msg_lines.append(f"  ./tomat iris logs smoke-{full_sha[:7]} -n 100")
        msg = "\n".join(msg_lines)
        subprocess.run(["git", "commit", "-m", msg], cwd=PROJECT_ROOT, check=True)
    else:
        err(f"[marin bump] done. Review then commit:")
        err(f"  git diff marin/pyproject.toml marin/uv.lock")
        err(f"  git add marin/pyproject.toml marin/uv.lock")
        err(f"  git commit -m 'marin: bump pin {old_sha[:7]} → {full_sha[:7]}'")


