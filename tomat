@cli.group("modal")
def modal_grp():
    """Modal app/container state snapshot for the /runs dashboard.

    The runs dashboard's "RUNNING" badge for Modal-hosted training
    (e.g. `train-mg-modal-h200x8-*`) used to come from wandb's session
    state, which is open for the entire cache-build / JIT-compile
    phase — well before training has actually started. `tomat modal
    sync` queries Modal's API for real app + container state and lands
    it on R2 so the dashboard can render an honest badge.
    """


# Modal apps we care about for the dashboard. Currently just the smoke
# training app, which also hosts the H100/H200/B200 bakeoff runs (see
# `scripts/train_smoke_modal.py:train_bakeoff_*`). Extend as we add more.
# The matching is exact-on-description; ANY app whose description matches
# one of these gets included in the snapshot.
TOMAT_MODAL_APP_NAMES = ("tomat-train-smoke",)

# Map `GenericStatus` enum int → friendly lowercase string. Mirrors
# modal/call_graph.py's `InputStatus`, but the wire format is the raw
# enum so we convert here. Values 0 (UNSPECIFIED) / unknown all map to
# `pending` to match Modal's `InputStatus._missing_` behavior — an input
# that hasn't started + has no terminal status is conceptually pending.
_MODAL_INPUT_STATUS_NAMES = {
    0: "pending",            # UNSPECIFIED — treat as pending
    1: "success",            # SUCCESS
    2: "failure",            # FAILURE
    3: "terminated",         # TERMINATED
    4: "timeout",            # TIMEOUT
    5: "init_failure",       # INIT_FAILURE
    6: "internal_failure",   # INTERNAL_FAILURE
    7: "idle_timeout",       # IDLE_TIMEOUT
}

# Modal AppState enum int → friendly lowercase. Mirrors modal/cli/utils.py.
_MODAL_APP_STATE_NAMES = {
    0: "unspecified",
    1: "ephemeral",
    2: "detached",
    3: "deployed",
    4: "stopping",
    5: "stopped",
    6: "initializing",
    7: "disabled",
    8: "detached_disconnected",
    9: "derived",
}


def _modal_snapshot_via_sdk(
    app_names: tuple[str, ...] = TOMAT_MODAL_APP_NAMES,
    extra_fc_ids: tuple[str, ...] = (),
) -> dict[str, dict]:
    """Query Modal's gRPC API (in-process, via the synchronous client wrapper)
    for our app + function-call state. Returns the `apps` dict for the snapshot.

    `extra_fc_ids` lets the caller probe specific function-call IDs (e.g.
    fc-IDs registered out-of-band by `tomat train modal …`) — useful because
    `FunctionCallList` per function is server-side-disabled for general use
    ("please contact support" error), but `FunctionCallFromId` and
    `FunctionGetCallGraph` per-fc are fine.
    """
    import asyncio
    try:
        from modal.client import _Client
        from modal_proto import api_pb2
    except ImportError as e:
        err(f"[modal sync] modal SDK not importable: {e}")
        return {}

    async def go() -> dict[str, dict]:
        client = await _Client.from_env()
        t0 = time.monotonic()
        app_resp: api_pb2.AppListResponse = await client.stub.AppList(
            api_pb2.AppListRequest(environment_name=""),
        )
        err(f"[modal-rpc AppList {int((time.monotonic()-t0)*1000)}ms]")
        # Index probed fc-IDs by app — every fc-id belongs to a single app
        # via its function_id, but we don't currently resolve that mapping;
        # we attach the probe results to whichever app the fc-id matches
        # OR to a synthetic `_other` bucket if no app matches.
        fc_probes: dict[str, dict] = {}
        for fc_id in extra_fc_ids:
            try:
                t1 = time.monotonic()
                cg = await client.stub.FunctionGetCallGraph(
                    api_pb2.FunctionGetCallGraphRequest(function_call_id=fc_id),
                )
                err(f"[modal-rpc FunctionGetCallGraph {fc_id} {int((time.monotonic()-t1)*1000)}ms]")
                if not cg.function_calls:
                    fc_probes[fc_id] = {"error": "no function_calls in graph"}
                    continue
                fc_proto = cg.function_calls[0]
                inputs = []
                for inp in cg.inputs:
                    if inp.function_call_id != fc_id:
                        continue
                    inputs.append({
                        "input_id": inp.input_id,
                        "task_id": inp.task_id or None,
                        "status": _MODAL_INPUT_STATUS_NAMES.get(inp.status, f"unknown_{inp.status}"),
                        "status_code": int(inp.status),
                    })
                fc_probes[fc_id] = {
                    "function_call_id": fc_id,
                    "function_name": fc_proto.function_name,
                    "module_name": fc_proto.module_name,
                    "inputs": inputs,
                }
            except Exception as e:
                err(f"[modal sync] FunctionGetCallGraph({fc_id}) failed: {e}")
                fc_probes[fc_id] = {"error": str(e)[:200]}

        apps: dict[str, dict] = {}
        for a in app_resp.apps:
            if a.description not in app_names:
                continue
            state_name = _MODAL_APP_STATE_NAMES.get(int(a.state), f"unknown_{a.state}")
            # Per-app function_name → function_id map (e.g. `train_bakeoff_h200x8` →
            # `fu-6YvCHXuJPPa1UNcKsC2QVH`). Modal's URL pattern for deep-linking to
            # a specific fc's logs requires the function_id, NOT just the function
            # name. `FunctionGetCallGraph` doesn't return the function_id, but
            # `AppGetLayout` does — one extra RPC per app, cheap.
            try:
                t2 = time.monotonic()
                layout = await client.stub.AppGetLayout(
                    api_pb2.AppGetLayoutRequest(app_id=a.app_id),
                )
                err(f"[modal-rpc AppGetLayout {a.app_id} {int((time.monotonic()-t2)*1000)}ms]")
                fn_ids = dict(layout.app_layout.function_ids)
            except Exception as e:
                err(f"[modal sync] AppGetLayout({a.app_id}) failed: {e}")
                fn_ids = {}
            app_entry = {
                "app_id": a.app_id,  # `ap-…` — populated for the TS `ModalApp.app_id` field
                "description": a.description,
                "state": state_name,
                "state_code": int(a.state),
                "n_running_tasks": int(a.n_running_tasks),
                "created_at_ms": int(a.created_at * 1000) if a.created_at else None,
                "stopped_at_ms": int(a.stopped_at * 1000) if a.stopped_at else None,
                "function_calls": {},  # fc_id → probe result (populated below)
                "function_ids": fn_ids,  # function_name → fu-id for deep-links
            }
            apps[a.app_id] = app_entry

        # Attach any fc probes to the right app. We don't know fc → app
        # mapping a priori, so just stash all fc probes on every matched
        # app for now — frontend filters by `function_name` / fc-id.
        # Better: dedup by attaching to the app whose name matches the
        # fc's `module_name` (every modal app has a single Python module
        # entrypoint, so this is a sound match for our setup).
        for fc_id, probe in fc_probes.items():
            mod = probe.get("module_name") if isinstance(probe, dict) else None
            # Module name is the python module the function lives in
            # (e.g. `train_smoke_modal`). Modal app descriptions are
            # custom (e.g. `tomat-train-smoke`); they often share a stem
            # — match by substring.
            target_app_id: str | None = None
            if mod:
                for aid, ae in apps.items():
                    desc = ae["description"].replace("-", "_").lower()
                    if mod.lower() in desc or desc in mod.lower():
                        target_app_id = aid
                        break
            if target_app_id is None and apps:
                # Fallback: attach to the first matched app (typically only one).
                target_app_id = next(iter(apps))
            if target_app_id is None:
                # No matched app — stash under a synthetic bucket so the
                # probe data isn't lost (frontend can still surface it).
                apps.setdefault("_unmatched", {
                    "description": "<unmatched-fc-probes>",
                    "state": "unknown",
                    "n_running_tasks": 0,
                    "created_at_ms": None,
                    "stopped_at_ms": None,
                    "function_calls": {},
                })
                target_app_id = "_unmatched"
            apps[target_app_id]["function_calls"][fc_id] = probe
        return apps
    return asyncio.run(go())


@modal_grp.command("sync")
@click.option("-b", "--bucket", default=R2_BUCKET, help="R2 bucket")
@click.option("-k", "--key", default="tomat/modal-state.json", help="R2 key")
@click.option("-d", "--dry-run", is_flag=True, help="print the JSON without uploading")
@click.option("-f", "--fc-id", "fc_ids", multiple=True,
              help="Modal function-call ID (fc-…) to probe for per-input "
              "status. Repeatable. Useful when a recent `tomat train` "
              "spawn returned an fc-id and we want its build / queue / "
              "run status visible on the dashboard ahead of the wandb "
              "session opening. App-level state is sourced regardless.")
@click.option("-A", "--all-pending", is_flag=True,
              help="Probe EVERY fc-id in R2's pending-fires.json — the union of "
                   "fc-ids that any spawn wrapper recorded. Used by the GCE "
                   "cron so modal-state.json keeps the active fcs probed each "
                   "minute without callers having to list them explicitly. "
                   "Composes with `--fc-id` (extra ids are merged).")
def modal_sync(bucket: str, key: str, dry_run: bool, fc_ids: tuple[str, ...],
               all_pending: bool):
    """Snapshot Modal app + function-call state → R2.

    Powers the Modal-state badge on tomat.oa.dev/runs (analog to the iris
    badge). Uses the Modal gRPC API (async, in-process via modal SDK) —
    one `AppList` + one `FunctionGetCallGraph` per --fc-id.

    Schema::

        {
          "schema_version": 1,
          "synced_at": "...",
          "count": <n_matched_apps>,
          "apps": {
            <app_id>: {
              "description": "tomat-train-smoke",
              "state": "deployed",   # APP_STATE_* minus prefix, lowercase
              "state_code": 3,
              "n_running_tasks": 1,
              "created_at_ms": ...,
              "stopped_at_ms": null,
              "function_calls": {
                <fc_id>: {
                  "function_call_id": "fc-…",
                  "function_name": "train_bakeoff_h200x8",
                  "module_name": "train_smoke_modal",
                  "inputs": [
                    {"input_id": "in-…", "task_id": "ta-…" | None,
                     "status": "pending" | "success" | "failure" | …,
                     "status_code": <int>}
                  ]
                }
              }
            }
          }
        }

    Notes:
      - `FunctionCallList` (enumerate ALL fc's per function) is server-side
        disabled for our account ("please contact support" — error code
        4E19UZIM). Per-fc probing via `FunctionGetCallGraph(fc_id)` works
        fine; pass `--fc-id fc-…` for the specific calls you care about.
      - When no --fc-id is passed we still write the app-state snapshot,
        which is what the runs dashboard's badge falls back to.
    """
    # Merge --all-pending fc-ids (from R2's pending-fires.json) into the
    # explicit --fc-id list. Used by the GCE cron so the periodic sync
    # keeps every spawned-but-unfinished fc probed.
    if all_pending:
        try:
            pending_doc = _load_pending_fires(bucket)
            pending_ids = tuple(
                f["fc_id"] for f in pending_doc.get("fires", []) if f.get("fc_id")
            )
            extra = tuple(fcid for fcid in pending_ids if fcid not in fc_ids)
            if extra:
                err(f"[modal sync] --all-pending adds {len(extra)} fc-id(s) "
                    f"from pending-fires.json: {list(extra)[:5]}"
                    f"{'…' if len(extra) > 5 else ''}")
                fc_ids = fc_ids + extra
        except Exception as e:
            err(f"[modal sync] WARN: --all-pending load failed ({type(e).__name__}: {e})")

    apps = _modal_snapshot_via_sdk(
        app_names=TOMAT_MODAL_APP_NAMES,
        extra_fc_ids=fc_ids,
    )
    payload = {
        "schema_version": 1,
        "synced_at": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds"),
        "count": len(apps),
        "apps": apps,
    }
    data = json.dumps(payload, indent=1).encode("utf-8")
    print(f"[modal sync] {len(apps)} apps → s3://{bucket}/{key} ({len(data)} bytes)")
    if dry_run:
        print(data.decode())
    else:
        _r2_put_bytes(bucket, key, data, "application/json")
        print(f"[modal sync] {R2_ENDPOINT}/{bucket}/{key}")


# ──────────────────────────────────────────────────────────────────────
# tomat modal pending-fire
# ──────────────────────────────────────────────────────────────────────
#
# `pending-fires.json` is a tiny R2 sidecar listing Modal-spawned training
# fires that the wandb-derived manifest doesn't know about yet. The /runs
# dashboard merges it with the manifest-derived run list so a freshly-fired
# Modal job shows up as a placeholder card immediately, well before the
# container starts logging to wandb (~15-30 min later).
#
# Lifecycle:
#   1. `tomat modal pending-fire add ...` (called by the spawn helper in
#      `scripts/train_smoke_modal.py` right after `fn.spawn(...)`) →
#      writes one entry to `pending-fires.json`.
#   2. `tomat runs sync ...` syncs the wandb run → R2 manifest. After
#      that, `tomat modal pending-fire gc` (called at the end of sync)
#      prunes the corresponding `pending-fires.json` entry.
#
# The R2 read-modify-write is not locked across concurrent writes. We
# accept the race window because spawn rate is < 1/sec in practice and a
# missed entry just delays a placeholder card by one sync cycle.

PENDING_FIRES_KEY = "tomat/pending-fires.json"
_PENDING_FIRES_SCHEMA_VERSION = 1


def _load_pending_fires(bucket: str = R2_BUCKET) -> dict:
    """Fetch pending-fires.json from R2; return a fresh empty doc if absent."""
    doc = _r2_get_json(bucket, PENDING_FIRES_KEY)
    if not isinstance(doc, dict) or "fires" not in doc:
        return {
            "schema_version": _PENDING_FIRES_SCHEMA_VERSION,
            "synced_at": datetime.datetime.now(datetime.timezone.utc)
                .isoformat(timespec="seconds"),
            "fires": [],
        }
    return doc


def _save_pending_fires(doc: dict, bucket: str = R2_BUCKET, dry_run: bool = False) -> None:
    """Stamp `synced_at` + push pending-fires.json back to R2."""
    doc["schema_version"] = _PENDING_FIRES_SCHEMA_VERSION
    doc["synced_at"] = datetime.datetime.now(datetime.timezone.utc)\
        .isoformat(timespec="seconds")
    data = json.dumps(doc, indent=1).encode("utf-8")
    if dry_run:
        print(data.decode())
        return
    _r2_put_bytes(bucket, PENDING_FIRES_KEY, data, "application/json")


@modal_grp.group("pending-fire")
def pending_fire_grp():
    """Track Modal-spawned training fires before their wandb session opens.

    `pending-fires.json` on R2 is read by the runs dashboard so a freshly-
    spawned run renders as a placeholder card immediately, instead of
    waiting ~15-30 min for the container to start logging to wandb.
    """


@pending_fire_grp.command("add")
@click.option("-b", "--bucket", default=R2_BUCKET, help="R2 bucket")
@click.option("-a", "--app-name", required=True, help="Modal app name (e.g. `tomat-train-smoke`)")
@click.option("-B", "--batch-size", type=int, required=True, help="train batch size")
@click.option("-f", "--fc-id", required=True, help="Modal function-call id (`fc-…`)")
@click.option("-F", "--function-name", required=True, help="Modal function (e.g. `train_bakeoff_h200x8`)")
@click.option("-H", "--hardware", required=True, help="hardware label (e.g. `h200x8`)")
@click.option("-k", "--kl-sigma", type=float, default=None, help="MaskGIT kl_gauss sigma (if loss_type=kl_gauss)")
@click.option("-L", "--loss-type", default="ce", help="loss type (`ce` / `emd` / `kl_gauss` / `crps` …)")
@click.option("-m", "--model-preset", default="200M", help="model size preset")
@click.option("-n", "--dry-run", is_flag=True, help="print the resulting JSON without uploading")
@click.option("-P", "--maskgit-prior", default="absorbing", help="MaskGIT prior")
@click.option("-r", "--results-label", required=True, help="results dir leaf (run_id minus `-bs<BS>-seed<S>`)")
@click.option("-R", "--run-id", default=None, help="canonical run id (defaults to `<results_label>-bs<BS>-seed<seed>`)")
@click.option("-s", "--seed", type=int, required=True, help="run seed")
@click.option("-S", "--intended-steps", type=int, required=True, help="`num_train_steps` the spawn requested")
@click.option("-t", "--tags", multiple=True, help="wandb tag (repeatable)")
@click.option("-T", "--spawned-at-ms", type=int, default=None,
              help="spawn epoch-ms (default: now)")
@click.option("-W", "--wandb-project", required=True, help="wandb project (e.g. `tomat-lmq-P19`)")
def pending_fire_add(
    app_name: str,
    batch_size: int,
    bucket: str,
    dry_run: bool,
    fc_id: str,
    function_name: str,
    hardware: str,
    intended_steps: int,
    kl_sigma: float | None,
    loss_type: str,
    maskgit_prior: str,
    model_preset: str,
    results_label: str,
    run_id: str | None,
    seed: int,
    spawned_at_ms: int | None,
    tags: tuple[str, ...],
    wandb_project: str,
):
    """Record one Modal-spawned training fire in `pending-fires.json`.

    Called by the spawn wrapper in `scripts/train_smoke_modal.py` right
    after `fn.spawn(...)` returns. Read-modify-write of the R2 sidecar;
    if an entry with the same `run_id` already exists, this overwrites it
    (e.g. a re-spawn of the same canonical name updates the fc_id).
    """
    rid = run_id or f"{results_label}-bs{batch_size}-seed{seed}"
    if spawned_at_ms is None:
        spawned_at_ms = int(time.time() * 1000)
    entry = {
        "run_id": rid,
        "fc_id": fc_id,
        "app_name": app_name,
        "function_name": function_name,
        "spawned_at_ms": spawned_at_ms,
        "hardware": hardware,
        "model_preset": model_preset,
        "batch_size": batch_size,
        "seed": seed,
        "intended_steps": intended_steps,
        "results_label": results_label,
        "wandb_project": wandb_project,
        "loss_type": loss_type,
        "kl_sigma": kl_sigma,
        "maskgit_prior": maskgit_prior,
        "tags": list(tags),
    }
    doc = _load_pending_fires(bucket)
    fires = [f for f in doc.get("fires", []) if f.get("run_id") != rid]
    fires.append(entry)
    fires.sort(key=lambda f: f.get("spawned_at_ms") or 0)
    doc["fires"] = fires
    print(f"[pending-fire add] {rid} (fc={fc_id}) → {len(fires)} total")
    _save_pending_fires(doc, bucket=bucket, dry_run=dry_run)
    if not dry_run:
        print(f"[pending-fire add] {R2_ENDPOINT}/{bucket}/{PENDING_FIRES_KEY}")


@pending_fire_grp.command("list")
@click.option("-b", "--bucket", default=R2_BUCKET, help="R2 bucket")
@click.option("--json", "as_json", is_flag=True, help="print raw JSON")
def pending_fire_list(bucket: str, as_json: bool):
    """List entries currently in `pending-fires.json`."""
    doc = _load_pending_fires(bucket)
    fires = doc.get("fires", [])
    if as_json:
        print(json.dumps(doc, indent=1))
        return
    print(f"synced_at: {doc.get('synced_at')}  n={len(fires)}")
    for f in fires:
        print(
            f"  {f.get('run_id')}  fc={f.get('fc_id')}  "
            f"hw={f.get('hardware')}  loss={f.get('loss_type')}  "
            f"steps={f.get('intended_steps')}  "
            f"spawned={f.get('spawned_at_ms')}"
        )


@pending_fire_grp.command("gc")
@click.option("-b", "--bucket", default=R2_BUCKET, help="R2 bucket")
@click.option("-p", "--prefix", default=R2_RUNS_PREFIX,
              help="R2 key prefix (under which per-run manifests live)")
@click.option("-n", "--dry-run", is_flag=True, help="report removals without uploading")
@click.option("-A", "--max-age-hours", type=float, default=48.0,
              help="also drop entries older than this many hours regardless of manifest "
              "(catches `failed-before-wandb-init` fires that would never GC otherwise)")
def pending_fire_gc(bucket: str, prefix: str, dry_run: bool, max_age_hours: float):
    """Prune pending-fire entries whose wandb manifest now exists on R2.

    Run after `tomat runs sync` so the dashboard stops double-rendering
    a (placeholder, manifested) pair as soon as the wandb session has
    been scraped.
    """
    doc = _load_pending_fires(bucket)
    fires = doc.get("fires", [])
    if not fires:
        print("[pending-fire gc] empty — nothing to do")
        return
    manifested = set(_r2_list_synced_runs(bucket, prefix))
    now_ms = int(time.time() * 1000)
    max_age_ms = int(max_age_hours * 3600 * 1000)
    kept: list[dict] = []
    dropped: list[tuple[str, str]] = []  # (run_id, reason)
    for f in fires:
        rid = f.get("run_id", "")
        spawned = f.get("spawned_at_ms") or 0
        if rid in manifested:
            dropped.append((rid, "manifested"))
            continue
        if spawned and now_ms - spawned > max_age_ms:
            dropped.append((rid, f"older than {max_age_hours}h"))
            continue
        kept.append(f)
    print(f"[pending-fire gc] kept={len(kept)} dropped={len(dropped)}")
    for rid, reason in dropped:
        print(f"  drop {rid} ({reason})")
    if not dropped:
        return
    doc["fires"] = kept
    _save_pending_fires(doc, bucket=bucket, dry_run=dry_run)
    if not dry_run:
        print(f"[pending-fire gc] {R2_ENDPOINT}/{bucket}/{PENDING_FIRES_KEY}")


