EVAL_MODAL_SCRIPT = PROJECT_ROOT / "scripts" / "eval_modal.py"


def _load_eval_modal_module():
    """Dynamically import `scripts/eval_modal.py` (the directory isn't a
    package). Returns the loaded module so callers can grab `app` and the
    function symbols.
    """
    import importlib.util
    spec = importlib.util.spec_from_file_location("tomat_eval_modal", EVAL_MODAL_SCRIPT)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"Failed to load {EVAL_MODAL_SCRIPT}")
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def _evals_fire_modal(
    *,
    step_list: list[int],
    set_list: list[str],
    num_tasks: int,
    per_task: int,
    run_label: str,
    leaf: str,
    eval_bucket: str,
    eval_label: str,
    model: str,
    decoder: str,
    eval_batch: int,
    mode: str,
    mg_k_steps: int,
    debug_dump_mat: str,
    dump_predictions: bool = False,
    voxel_zarrs: bool = False,
    resume_eval: bool = False,
) -> int:
    """Modal-backend eval fire: spawn one 8×H200 call per (step, set, task).

    Uses an ephemeral detached app — spawned calls survive after this Python
    process exits, and the result JSONs land at the same GCS path the iris
    path writes to (eval/results/<leaf>/<set>{-mode}/step-N{-task<i>}.json),
    courtesy of TOMAT_EVAL_RUN_LABEL=<leaf>.
    """
    import modal as _modal
    mod = _load_eval_modal_module()
    app = mod.app
    eval_fn = mod.eval_checkpoint_h200x8

    # Modal-trained ckpts have RL ≠ leaf — eval_mat_nmae.py would otherwise
    # compute parts[-4] = RL and write under eval/results/<RL>/, but we want
    # eval/results/<leaf>/ (matches the existing maskgit step-9969 layout).
    run_label_override = leaf if leaf != run_label else None

    fired = 0
    call_ids: list[tuple[int, str, int, str]] = []
    # Detached: the modal app keeps running after this process exits, so
    # all spawned calls survive a Ctrl-C / SSH drop. This matches the
    # train_smoke_modal `--detach` semantics.
    with _modal.enable_output():
        with app.run(detach=True):
            for step in step_list:
                for s in set_list:
                    ckpt = f"{eval_bucket}/results/{run_label}/checkpoints/{leaf}/step-{step}"
                    for task_i in range(num_tasks):
                        task_skip = task_i * per_task
                        task_n_mats = per_task
                        out_suffix = f"-task{task_i}" if num_tasks > 1 else ""
                        try:
                            call = eval_fn.spawn(
                                checkpoint=ckpt,
                                mat_set=s,
                                label=eval_label,
                                lmq_path=LMQ_PATH,
                                model=model,
                                n_mats=task_n_mats,
                                decoder=decoder,
                                batch=eval_batch,
                                debug_dump_mat=debug_dump_mat,
                                run_label=run_label_override,
                                mode=mode,
                                mg_k_steps=mg_k_steps,
                                eval_skip=task_skip,
                                output_suffix=out_suffix,
                                dump_predictions=dump_predictions,
                                voxel_zarrs=voxel_zarrs,
                                resume_eval=resume_eval,
                            )
                        except Exception as e:
                            err(f"[FAIL spawn step={step} set={s} task={task_i}] {e}")
                            continue
                        call_ids.append((step, s, task_i, call.object_id))
                        print(f"[fired modal step={step} set={s} task={task_i} "
                              f"call_id={call.object_id}]")
                        fired += 1
    # Summary block — easier to grep for later.
    if call_ids:
        print("\n[modal call IDs]")
        for step, s, task_i, cid in call_ids:
            print(f"  step={step:<6} set={s:<10} task={task_i}  {cid}")
        print("  watch with: modal call-logs <call_id>  (or `modal app logs tomat-eval`)")
    return fired


@cli.group()
def evals():
    """Mat-NMAE eval firing + harvesting."""


@evals.command("fire")
@click.option("-s", "--steps", required=True, help="comma-sep step list, e.g. 1000,2000,3000")
@click.option("-S", "--sets", default="val_200,train_200", help="comma-sep mat-sets")
@click.option("-l", "--eval-label", default="val-full-v3", help="TOMAT_LABEL for eval jobs (must match ckpt's tokenization). Default `val-full-v3` matches the P19 production project; pass `val-full-lmq-v2` for archived P14/v2 runs.")
@click.option("-m", "--model", default="200M", help="TOMAT_MODEL preset")
@click.option("-n", "--n-mats", default=200, type=int)
@click.option("-T", "--num-tasks", default=1, type=int, help="Fan out the mat set across N iris jobs. Each job gets a contiguous slice of size ~n_mats/N via the eval script's existing TOMAT_EVAL_SKIP+TOMAT_EVAL_N_MATS env vars. Per-task results land at `<set>-<mode>/step-<N>-task-<i>.json`; `tomat evals sync` aggregates them. Use when free-running eval at n_mats=200 is too slow on a single task (see specs/38).")
@click.option("-b", "--eval-batch", default=32, type=int)
@click.option("-t", "--tpu", default="v6e-8")
@click.option("--memory", "iris_memory", default="64GB", show_default=True, help="iris container --memory. Bump for maskgit + dump-predictions evals where K iterations × full-vocab logits + npz buffer writes can spill past 64GB (kl-bin5 maskgit OOM'd at 64GB on v6e-8; 128GB fits).")
@click.option("--zone", default=None, help="iris --zone (e.g. europe-west4-a); pin eval slice to the ckpt-bucket region to avoid x-reg ckpt-read egress. Repeatable via comma-sep list.")
@click.option("--region", default=None, help="iris --region (e.g. europe-west4); broader pin than --zone.")
@click.option("--decoder", default="median")
@click.option("--output-suffix", default="", help="String appended to the result JSON's `step-N` basename (TOMAT_EVAL_OUTPUT_SUFFIX). Use to keep multiple ablation runs from clobbering each other within the same `<set>{-mode}/` dir — e.g. `--output-suffix -K1-mean` writes `step-N-K1-mean.json` instead of overwriting `step-N.json`. Composes with `--num-tasks > 1` (which appends its own `-task<i>`); when both are set the per-task suffix wins.")
@click.option("-d", "--dry-run", is_flag=True, help="print iris commands without executing")
@click.option("-D", "--debug-dump-mat", default="", help="dump per-voxel rho_pred/rho_true (and per-patch flat arrays in free mode) to GCS for this mp_id; overrides n_mats")
@click.option("-f", "--free-batch", default=32, type=int, help="(--mode free) patches per forward — HBM knob, not a coverage cap")
@click.option("--mode", default="oneshot", type=click.Choice(["oneshot", "teacher", "free", "maskgit"]), help="One forward pass over the full grid (default; AR: teacher-forced, GT at each position predict-next. MG: all density positions masked, single bidir forward). `teacher` is a back-compat alias for `oneshot`. `free` = autoregressive (AR only). `maskgit` = K-step iterative MG refinement.")
@click.option("--mg-k-steps", default=12, type=int, help="(--mode maskgit) number of iterative-refinement steps (TOMAT_EVAL_MG_K_STEPS)")
@click.option("--mg-partial-ratios", default="", help="(--mode maskgit) diagnostic: comma-sep mask ratios (e.g. 0.1,0.5,0.9,1.0). When set, skip K-iter loop; mask R fraction at random, ONE forward, report NMAE on masked positions only. Tests whether model has learned at any mask ratio.")
@click.option("--bucket", "bucket_override", default=None, help=f"GCS bucket where the run's ckpts live (default: {GCS_BUCKET}). Use when the run was trained with --bucket override (e.g. v5p in us-east5 → gs://marin-us-east5/tomat).")
@click.option("--mirror-to", "mirror_to", default=None, help="Before firing, mirror the resolved ckpt(s) to this bucket via `tomat ckpt mirror` and run eval against the mirror. Prevents cross-region egress when eval TPU region differs from ckpt bucket. See [[cross-region-eval-egress]].")
@click.option("--ckpt-leaf", "ckpt_leaf", default=None, help="Override the leaf dir under `<bucket>/results/<run_label>/checkpoints/` (default: run_label). Use for Modal training runs whose ckpt path is `results/<results_label>/checkpoints/<results_label>-bs<bs>-seed<seed>/step-*` — pass `--ckpt-leaf <results_label>-bs<bs>-seed<seed>`.")
@click.option("--backend", default="iris", type=click.Choice(["iris", "modal"]), help="Submission backend. `iris` (default): submit one iris/TPU job per (step, set, task). `modal`: spawn each combo as an 8×H200 Modal `eval_checkpoint_h200x8` call. The modal path sidesteps marin-iris's 14-day client-freshness gate + marin-*-latest wheel rotation (see memories `iris-build-date-empty-bug`, `marin-dev-wheel-rotation`). Result JSONs land at the same GCS path either way (eval/results/<ckpt_leaf or run_label>/<set>/step-N.json); modal forces `<ckpt_leaf>` via TOMAT_EVAL_RUN_LABEL so RL ≠ leaf runs (Modal-trained) get the leaf-based output dir.")
@click.option("-P", "--dump-predictions", "dump_predictions", is_flag=True, help="Sets TOMAT_EVAL_DUMP_PREDICTIONS=1. Each completed mat dumps a (n_patches, P^3) pred/true .npz sibling to the result JSON, for the voxel-position corr-matrix diagnostic (spec 41).")
@click.option("-V", "--voxel-zarrs", "voxel_zarrs", is_flag=True, help="Sets TOMAT_EVAL_DUMP_VOXEL_ZARRS=1. Each completed mat writes a per-mat voxel-space fp16 zarr at `<bucket>/eval/predictions/<run>/<set>{-mode}/step-N/<mp_id>.zarr/` (schema mirrors `rho_gga_raw`). Enables elvis diff-mode viz of GT vs prediction (spec 51 Layer 1). R2 mirror happens in `tomat evals sync`.")
@click.option("-r", "--resume", "resume_eval", is_flag=True, help="Sets TOMAT_EVAL_RESUME=1. Load existing per-mat results from `<bucket>/eval/results/<run>/<set>{-mode}/step-N.json` and skip those mp_ids. Lets a killed/timed-out fire pick up where it left off. Per_pos_* in the resumed summary reflects only newly-computed mats. task #228.")
@click.argument("run_label")
def evals_fire(
    run_label: str,
    steps: str,
    sets: str,
    eval_label: str,
    model: str,
    n_mats: int,
    num_tasks: int,
    eval_batch: int,
    tpu: str,
    iris_memory: str,
    decoder: str,
    dry_run: bool,
    debug_dump_mat: str,
    free_batch: int,
    mode: str,
    mg_k_steps: int,
    mg_partial_ratios: str,
    zone: str | None,
    region: str | None,
    bucket_override: str | None,
    mirror_to: str | None,
    ckpt_leaf: str | None,
    backend: str,
    dump_predictions: bool,
    voxel_zarrs: bool,
    resume_eval: bool,
    output_suffix: str,
):
    """Fire mat-NMAE eval jobs against a run's GCS checkpoints.

    One-shot (default; `--mode oneshot`, alias `--mode teacher`) does a
    single forward over the full grid — AR runs are teacher-forced (GT at
    each position, predict next); MG runs mask ALL density positions and do
    one bidir forward. Pre-populates the watchdog FIRED files so a
    subsequent `tomat evals harvest <run>` picks the numbers up; results
    land in GCS `<set>/` (bare). Free-running (`--mode free`) covers the
    whole grid (every patch) but is ~P^3 sequential forwards/patch — cap
    cost with `-n` (mat count, e.g. 1), not coverage; results land in GCS
    `<set>-free/`. MaskGIT iterative-refinement (`--mode maskgit`) runs K
    bidirectional forwards per patch (confidence-sorted cosine schedule);
    results land in GCS `<set>-maskgit/`.

    `--backend modal` routes each (step, set, task) to an 8×H200 Modal call
    via `scripts/eval_modal.py::eval_checkpoint_h200x8` (sidesteps the iris
    14-day client-freshness gate + marin-*-latest wheel rotation). The Modal
    app runs detached, so the local process exits after spawning; Modal call
    IDs are printed for later inspection.

    Use --dry-run to print iris commands without executing (iris backend only).
    """
    # `oneshot` is the canonical name for "one forward pass"; `teacher` is the
    # legacy alias kept for back-compat with prior ad-hoc fires + watchdogs.
    # Normalize to `teacher` internally so all downstream code (FIRED files,
    # output paths, JSON `mode` fields, R2 record keys) keeps its existing
    # on-disk layout. See `_BACKFILL_MODES` + `_backfill_discover_dirs` —
    # path layout MUST stay `<set>/` (bare) for the one-forward mode.
    if mode == "oneshot":
        mode = "teacher"
    # Resolve `-s` against actual GCS ckpts. Two recurring foot-guns this
    # avoids: (1) the Levanter `num_train_steps=N` → final ckpt named
    # `step-(N-1)` OBO that's bitten us in mg-1 / cont33k / cont7k-ext /
    # the 8k-smoke; (2) typo'd step values that silently submit a job
    # which fails ~minutes later when the ckpt load can't find the path.
    # Accept `-s latest` (or `-s final` / `-s last`) to skip the integer
    # arithmetic entirely and just take the highest GCS ckpt.
    eval_bucket = bucket_override or GCS_BUCKET
    leaf = ckpt_leaf or run_label
    step_list = _resolve_eval_step_list(steps, run_label, bucket=eval_bucket, ckpt_leaf=ckpt_leaf)

    # If --mirror-to was passed, copy the resolved ckpts to that bucket once
    # before firing iris jobs, then point eval at the mirrored copy. Avoids
    # cross-region egress when eval TPU region differs from ckpt source.
    if mirror_to is not None:
        mirror_to = mirror_to.rstrip("/")
        if mirror_to != eval_bucket:
            err(f"[evals fire] --mirror-to: copying {len(step_list)} step(s) "
                f"from {eval_bucket} → {mirror_to}")
            src_ckpt_root = f"{eval_bucket}/results/{run_label}/checkpoints/{leaf}"
            dst_ckpt_root = f"{mirror_to}/results/{run_label}/checkpoints/{leaf}"
            for s in step_list:
                # `gcloud storage cp -r src dst` copies `src` (treated as a
                # dir) INTO `dst` — passing `dst=step-N/` produces a
                # doubled `step-N/step-N/` path. Pass the parent instead.
                src = f"{src_ckpt_root}/step-{s}"
                dst_parent = f"{dst_ckpt_root}/"
                dst_dir = f"{dst_ckpt_root}/step-{s}/"
                # Skip if already there (idempotent — supports re-running an
                # eval over a previously-mirrored ckpt without re-copying).
                dst_check = subprocess.run(
                    ["gcloud", "storage", "ls", dst_dir],
                    capture_output=True, text=True, timeout=30,
                )
                if dst_check.returncode == 0 and "manifest.ocdbt" in dst_check.stdout:
                    err(f"  step-{s}: already at dst; skipping copy")
                    continue
                cmd = ["gcloud", "storage", "cp", "-r", src, dst_parent]
                err(f"  step-{s}: copying...")
                if dry_run:
                    err(f"  (dry-run) {' '.join(cmd)}")
                    continue
                r = subprocess.run(cmd)
                if r.returncode != 0:
                    err(f"[FAIL] mirror cp rc={r.returncode}; aborting evals fire")
                    sys.exit(r.returncode)
            # All subsequent eval submits read from the mirrored bucket.
            eval_bucket = mirror_to
        else:
            err(f"[evals fire] --mirror-to == --bucket ({mirror_to}); skipping mirror")
    set_list = sets.split(",")
    for s in set_list:
        if s not in SPLITS:
            err(f"unknown mat-set {s!r}; known: {sorted(SPLITS)}")
            sys.exit(1)

    # One-shot evals seed the harvest watchdog via FIRED files; the
    # free-running and maskgit harvest paths read GCS directly. (`teacher`
    # is the canonical internal name post-normalization — see flag handling.)
    if not dry_run and mode == "teacher":
        TMP_DIR.mkdir(exist_ok=True)
        for s in set_list:
            (TMP_DIR / f"{run_label}-{s}-evals-fired.txt").write_text("")

    # iris backend pushes WANDB to each TPU container via --env-vars; the
    # modal path doesn't (eval_modal.py doesn't wire wandb either — keep this
    # follow-up: bake wandb logging back into the modal entrypoint).
    wandb_key = os.environ.get("WANDB_API_KEY", "<WANDB_API_KEY>")
    if backend == "iris" and not dry_run and wandb_key == "<WANDB_API_KEY>":
        err("WANDB_API_KEY not set in env")
        sys.exit(1)

    if num_tasks < 1:
        err(f"--num-tasks must be >= 1, got {num_tasks}")
        sys.exit(1)
    # Slice the mat set across `num_tasks` jobs. Ceil-divide so that the
    # union covers every mat; the last task may have a slightly smaller
    # slice (truncated by `n_mats` on the eval-script side).
    per_task = (n_mats + num_tasks - 1) // num_tasks

    if backend == "modal":
        if dry_run:
            err("[evals fire] --dry-run not implemented for --backend modal; "
                "printing the planned (step, set, task) combos and exiting")
            for step in step_list:
                for s in set_list:
                    for task_i in range(num_tasks):
                        print(f"  step={step} set={s} task={task_i}")
            print(f"\n[planned {len(step_list)*len(set_list)*num_tasks} modal calls (dry-run)]")
            return
        fired_total = _evals_fire_modal(
            step_list=step_list,
            set_list=set_list,
            num_tasks=num_tasks,
            per_task=per_task,
            run_label=run_label,
            leaf=leaf,
            eval_bucket=eval_bucket,
            eval_label=eval_label,
            model=model,
            decoder=decoder,
            eval_batch=eval_batch,
            mode=mode,
            mg_k_steps=mg_k_steps,
            debug_dump_mat=debug_dump_mat,
            dump_predictions=dump_predictions,
            voxel_zarrs=voxel_zarrs,
            resume_eval=resume_eval,
        )
        print(f"\n[done firing {fired_total}/{len(step_list)*len(set_list)*num_tasks} modal jobs]")
        # FIRED file seeding still useful so a downstream `tomat evals harvest`
        # can find the runs once results land.
        if mode == "teacher":
            for s in set_list:
                with open(TMP_DIR / f"{run_label}-{s}-evals-fired.txt", "a") as f:
                    for step in step_list:
                        f.write(f"{step}\n")
        return

    fired_total = 0
    for step in step_list:
        for s in set_list:
            if mode == "free":
                infix = "eval-free"
            elif mode == "maskgit":
                infix = "eval-maskgit"
            else:
                infix = "eval"
            split = SPLITS[s]
            ckpt = f"{eval_bucket}/results/{run_label}/checkpoints/{leaf}/step-{step}"
            for task_i in range(num_tasks):
                task_skip = task_i * per_task
                # Last task: may run fewer mats if n_mats doesn't divide evenly.
                # eval_mat_nmae.py already caps at the global n_mats via SKIP+N_MATS,
                # so emitting per_task for every job is correct.
                task_n_mats = per_task
                # Single-task fires keep the existing job-name shape so they
                # remain compatible with the dashboard's run-name parser.
                # User --output-suffix gets folded into the name when set,
                # so an ablation sweep over a single (ckpt, set) doesn't
                # collide on iris job-names.
                if num_tasks == 1:
                    jn = f"tomat-{infix}-{run_label}-{s}-step-{step}{output_suffix}"
                else:
                    jn = f"tomat-{infix}-{run_label}-{s}-step-{step}-task{task_i}"
                cmd = [
                    IRIS_BIN, "--cluster=marin", "job", "run",
                    "--tpu", tpu, "--enable-extra-resources", "--priority", "interactive",
                    "--cpu", "32", "--memory", iris_memory,
                ]
                if zone:
                    for z in zone.split(","):
                        cmd += ["--zone", z]
                if region:
                    for r in region.split(","):
                        cmd += ["--region", r]
                cmd += [
                    "--env-vars", "WANDB_API_KEY", wandb_key,
                    "--env-vars", "TOMAT_LABEL", eval_label,
                    "--env-vars", "TOMAT_MODEL", model,
                    "--env-vars", "TOMAT_CHECKPOINT", ckpt,
                    "--env-vars", "TOMAT_LMQ_PATH", LMQ_PATH,
                    "--env-vars", "TOMAT_EVAL_N_MATS", str(task_n_mats),
                    "--env-vars", "TOMAT_EVAL_SKIP", str(task_skip),
                    "--env-vars", "TOMAT_EVAL_BATCH", str(eval_batch),
                    "--env-vars", "TOMAT_EVAL_DECODER", decoder,
                    "--env-vars", "TOMAT_EVAL_MAT_SET", s,
                    "--env-vars", "TOMAT_EVAL_SPLIT", split,
                ]
                # Tag the per-task result file so the N jobs' outputs don't
                # collide in GCS. The eval script (see eval_mat_nmae.py) reads
                # TOMAT_EVAL_OUTPUT_SUFFIX and appends it to the JSON path.
                # User --output-suffix is for ablations that want multiple
                # JSONs in the same dir without clobbering (e.g. K=1 decoder
                # sweep). Per-task fanout takes precedence when both apply.
                if num_tasks > 1:
                    cmd += [
                        "--env-vars", "TOMAT_EVAL_OUTPUT_SUFFIX",
                        f"-task{task_i}",
                    ]
                elif output_suffix:
                    cmd += [
                        "--env-vars", "TOMAT_EVAL_OUTPUT_SUFFIX", output_suffix,
                    ]
                if mode == "free":
                    cmd += [
                        "--env-vars", "TOMAT_EVAL_MODE", "free",
                        "--env-vars", "TOMAT_EVAL_FREE_BATCH", str(free_batch),
                    ]
                elif mode == "maskgit":
                    cmd += [
                        "--env-vars", "TOMAT_EVAL_MODE", "maskgit",
                        "--env-vars", "TOMAT_EVAL_MG_K_STEPS", str(mg_k_steps),
                    ]
                    if mg_partial_ratios:
                        cmd += [
                            "--env-vars", "TOMAT_EVAL_MG_PARTIAL_RATIOS",
                            mg_partial_ratios,
                        ]
                if debug_dump_mat:
                    cmd += [
                        "--env-vars", "TOMAT_DEBUG_DUMP_MAT", debug_dump_mat,
                    ]
                if dump_predictions:
                    cmd += [
                        "--env-vars", "TOMAT_EVAL_DUMP_PREDICTIONS", "1",
                    ]
                if voxel_zarrs:
                    cmd += [
                        "--env-vars", "TOMAT_EVAL_DUMP_VOXEL_ZARRS", "1",
                    ]
                if resume_eval:
                    cmd += [
                        "--env-vars", "TOMAT_EVAL_RESUME", "1",
                    ]
                cmd += [
                    "--no-wait", "--no-terminate-on-exit",
                    "--job-name", jn,
                    "--", "python", "eval_mat_nmae.py",
                ]
                if dry_run:
                    # Print the cmd as a runnable shell line. Mask the actual
                    # WANDB_API_KEY value with a literal placeholder.
                    pretty = " ".join(
                        "'<WANDB_API_KEY>'" if a == wandb_key else a
                        for a in cmd
                    )
                    print(f"# {jn}")
                    print(f"  cd {MARIN_DIR}")
                    print(f"  {pretty}")
                    print()
                    fired_total += 1
                    continue
                r = subprocess.run(cmd, cwd=str(MARIN_DIR), capture_output=True, text=True)
                if r.returncode != 0:
                    err(f"[FAIL fire {jn}] rc={r.returncode}\n{r.stderr[-500:]}")
                    continue
                print(f"[fired {jn}]")
                fired_total += 1
            # The FIRED file gates the harvest watchdog; tracked per (set, step),
            # NOT per task — multiple tasks for the same (set, step) share one
            # entry. (Append after the per-task loop so we record once even when
            # num_tasks > 1.)
            if mode == "teacher":
                with open(TMP_DIR / f"{run_label}-{s}-evals-fired.txt", "a") as f:
                    f.write(f"{step}\n")

    suffix = " (dry-run)" if dry_run else ""
    print(f"\n[done firing {fired_total}/{len(step_list)*len(set_list)*num_tasks} jobs{suffix}]")


# ──────────────────────────────────────────────────────────────────────
# tomat evals vl-backfill — Modal-based eval/loss backfill for runs
# whose training never logged it (no val carve-out). See
# `src/tomat/vl_backfill.py` for the Modal app + function body.
# ──────────────────────────────────────────────────────────────────────


def _vl_backfill_autodetect_loss(run_label: str) -> tuple[str, float | None, str]:
    """Heuristic mapping from run-label substrings to (loss_type, kl_sigma, kl_sigma_unit).

    Conservative: defaults to ce/None. Recognised tags:
      `kl-bin<N>` / `bin<N>` → kl_gauss, sigma=N, unit=bin
    """
    m = re.search(r"(?:^|-)(?:kl-)?bin(\d+)(?:-|$)", run_label)
    if m:
        sigma = float(m.group(1))
        return ("kl_gauss", sigma, "bin")
    return ("ce", None, "bin")


def _vl_backfill_autodetect_parquet(run_label: str) -> str:
    """Heuristic mapping from run-label to parquet label on the Modal volume.

    `bin5` was the only shard1-only run; everything else defaults to v3
    (the 4-shard union). Pass `--parquet-label` to override.
    """
    if "bin5" in run_label or "shard1" in run_label:
        return "train-full-v3-shard1"
    return "train-full-v3"


@evals.command("vl-backfill")
@click.option("--mode", default="iris", show_default=True, type=click.Choice(["iris", "modal"]), help="iris+TPU eval-only (default; uses TOMAT_EVAL_ONLY=1 short-circuit in train_tomat_tpu.py) vs modal H100/H200×8 (legacy; reconstructs val carve-out config manually — risk of drift on multi-shard runs).")
@click.option("-s", "--steps", default=None, help="comma-sep step list (e.g. `10000,20000`). Mutually exclusive with --every. Default: --every 1000.")
@click.option("--every", default=None, type=int, help="filter discovered ckpts to multiples of N. Default 1000 if neither -s nor --every passed.")
@click.option("--smoke", is_flag=True, help="alias for `--every 10000` — every 10k step for smoke-testing the pipeline before firing every-1k.")
@click.option("-G", "--gpu", default="H100:8", show_default=True, type=click.Choice(["H100:8", "H200:8"]), help="(modal-only) GPU kind. H100×8 ≈ half the price of H200×8; both fit 256-seq bidir forward.")
@click.option("-T", "--tpu", default="v6e-8", show_default=True, help="(iris-only) TPU variant. v6e-8 boots in ~30s + ~10s eval per ckpt.")
@click.option("--zone", default="us-east5-b", show_default=True, help="(iris-only) iris zone pin. Should match the bin5 region in --bucket.")
@click.option("--data-label", "data_label_override", default=None, help="(iris-only) TOMAT_LABEL comma-separated multi-shard data label. Autodetected from run name if omitted (bin5 → 4-shard v3 union).")
@click.option("-b", "--batch-size", default=64, type=int, help="eval batch size (passed to TrainerConfig).")
@click.option("-S", "--val-seqs", default=256, type=int, help="size of val carve-out (last N seqs after PRNGKey(0) feistel shuffle).")
@click.option("-M", "--model-preset", default="200M", help="model preset (must match trained ckpt).")
@click.option("--bucket", "bucket_override", default=None, help="GCS bucket where the run lives (autodetected from canonical buckets if omitted).")
@click.option("--ckpt-leaf", default=None, help="Override ckpt subdir under `results/<run>/checkpoints/` (default: <run>).")
@click.option("--parquet-label", default=None, help="(modal-only) parquet dir under /vol/tokenized/. Autodetect: bin5/shard1 → train-full-v3-shard1, else train-full-v3.")
@click.option("--loss-type", default=None, type=click.Choice(["ce", "kl_gauss", "emd"]), help="MaskGIT loss type (autodetected from run-label `bin<N>` token if omitted).")
@click.option("-k", "--kl-sigma", default=None, type=float, help="MaskGIT kl_gauss sigma (autodetected from `bin<N>`).")
@click.option("--kl-sigma-unit", default="bin", show_default=True, help="MaskGIT kl_gauss sigma unit (`bin` or `density`).")
@click.option("--mask-prior", default="absorbing", show_default=True, help="MaskGIT mask prior.")
@click.option("--cache-dir", "cache_dir_override", default=None, help="(modal-only) Override levanter cache dir (default: `/vol/vl-backfill-cache/<parquet_label>`).")
@click.option("--long-timeout", "long_timeout", is_flag=True, help="(modal-only) use 3600s Modal timeout. Default 600s caps cost/fire at ~$5 (H100×8).")
@click.option("-n", "--dry-run", is_flag=True, help="list steps + planned fires, don't spawn.")
@click.option("-F", "--force", is_flag=True, help="re-fire even if `step-N.json` already exists for the run.")
@click.argument("run_label")
def evals_vl_backfill(
    run_label: str,
    mode: str,
    steps: str | None,
    every: int | None,
    smoke: bool,
    gpu: str,
    tpu: str,
    zone: str,
    data_label_override: str | None,
    batch_size: int,
    val_seqs: int,
    model_preset: str,
    bucket_override: str | None,
    ckpt_leaf: str | None,
    parquet_label: str | None,
    loss_type: str | None,
    kl_sigma: float | None,
    kl_sigma_unit: str,
    mask_prior: str,
    cache_dir_override: str | None,
    long_timeout: bool,
    dry_run: bool,
    force: bool,
):
    """Backfill `eval/loss` for a run's GCS checkpoints via H100/H200×8 Modal.

    Runs the same MaskGIT loss computation the trainer would have logged, but
    after the fact — one Modal call per ckpt against a `val_seqs`-sized
    held-out carve-out of the training parquet (PRNGKey(0) feistel shuffle,
    last N seqs). Per-step JSONs land at
    `gs://<bucket>/tomat/eval/vl-backfill/<ckpt_leaf>/step-N.json` and are
    auto-picked-up by `tomat runs sync` (see `_vl_backfill_rows`).

    `--steps` is mutually exclusive with `--every` / `--smoke`. With no
    selector flag, defaults to `--every 1000`.

    `--smoke` is shorthand for `--every 10000` — sparse cadence for
    smoke-testing the pipeline before firing every-1k.

    Loss config (loss_type / kl_sigma) is autodetected from the run label
    when omitted (`bin<N>` → kl_gauss + sigma=N).

    Skip-if-exists is on by default; pass `-F` to re-fire steps that already
    have a step-N.json.
    """
    # Reconcile selectors.
    if steps and (every is not None or smoke):
        raise click.UsageError("--steps is mutually exclusive with --every / --smoke")
    if smoke:
        every = 10000
    if not steps and every is None:
        every = 1000

    # Resolve bucket.
    sys.path.insert(0, str(PROJECT_ROOT / "src"))
    from tomat.vl_backfill import (
        resolve_run_bucket,
        select_steps,
        existing_results,
        get_fn,
        app as vl_app,
    )

    bucket = bucket_override or resolve_run_bucket(run_label, ckpt_leaf=ckpt_leaf)
    if bucket is None:
        err(f"[vl-backfill] could not find {run_label!r} in any canonical bucket; pass --bucket")
        sys.exit(1)
    leaf = ckpt_leaf or run_label
    err(f"[vl-backfill] bucket={bucket} run={run_label} leaf={leaf}")

    # Autodetect loss + parquet from run label.
    if loss_type is None:
        loss_type, sigma_auto, unit_auto = _vl_backfill_autodetect_loss(run_label)
        if kl_sigma is None:
            kl_sigma = sigma_auto
        kl_sigma_unit = unit_auto if loss_type == "kl_gauss" else kl_sigma_unit
        err(f"[vl-backfill] loss autodetect: type={loss_type} "
            f"sigma={kl_sigma} unit={kl_sigma_unit}")
    if loss_type == "kl_gauss" and kl_sigma is None:
        raise click.UsageError("--kl-sigma required when --loss-type=kl_gauss (autodetect failed)")

    if parquet_label is None:
        parquet_label = _vl_backfill_autodetect_parquet(run_label)
        err(f"[vl-backfill] parquet autodetect: {parquet_label}")

    # Resolve steps against on-GCS ckpts.
    step_list = select_steps(
        run_label, bucket, explicit=steps, every=every, ckpt_leaf=ckpt_leaf,
    )
    if not step_list:
        err(f"[vl-backfill] no matching ckpts on GCS; aborting")
        sys.exit(1)

    # Skip already-done unless --force.
    done = existing_results(leaf, bucket)
    if done:
        err(f"[vl-backfill] {len(done)} step(s) already have results: "
            f"{sorted(done)[:5]}{'…' if len(done) > 5 else ''}")
    if not force:
        before = len(step_list)
        step_list = [s for s in step_list if s not in done]
        skipped = before - len(step_list)
        if skipped:
            err(f"[vl-backfill] skipping {skipped} already-completed step(s); pass -F to re-fire")
    if not step_list:
        err(f"[vl-backfill] nothing to fire (all selected steps already have results)")
        return

    err(f"[vl-backfill] mode={mode} {len(step_list)} fires planned: steps={step_list}")

    # Iris fork: per-ckpt iris job using TOMAT_EVAL_ONLY=1 short-circuit in
    # marin/train_tomat_tpu.py. Reuses 100% of in-train semantics → VL
    # bit-identical (modulo TPU non-determinism) to what an in-train eval
    # would have logged. ~$1.50/fire on v6e-8 priority interactive.
    if mode == "iris":
        # Autodetect data label. bin5 trains on 4-shard v3 union per
        # ConcatDatasetComponent switch at step 67000 (commit a11dcf9).
        # `--data-label` overrides this; otherwise we apply heuristics.
        if data_label_override:
            data_label = data_label_override
        elif "bin5" in run_label:
            data_label = "train-full-v3,train-full-v3-shard1,train-full-v3-shard2,train-full-v3-shard3"
        else:
            # Fallback to whatever parquet autodetect picked (or v3 union)
            data_label = parquet_label or "train-full-v3"
        err(f"[vl-backfill] iris data_label: {data_label}")

        # Cost estimate: ~$1.50/fire on v6e-8 priority interactive.
        per_fire_cost = 1.50
        err(f"[vl-backfill] tpu={tpu} zone={zone} "
            f"est-per-fire=${per_fire_cost:.2f} → est-total=${per_fire_cost * len(step_list):.2f}")
        if dry_run:
            err(f"[vl-backfill] dry-run; not spawning")
            print()
            for st in step_list:
                print(f"  step={st}  out={bucket}/eval/vl-backfill/{leaf}/step-{st}.json")
            return

        lmq_path = f"{bucket}/codecs/lmq-v2-16k.npz"
        env_pairs_base = [
            ("TOMAT_LABEL", data_label),
            ("TOMAT_RESULTS_LABEL", run_label),
            ("TOMAT_BUCKET", bucket),
            ("TOMAT_PIN_BUCKET", "1"),
            ("TOMAT_BATCH_SIZE", "256"),
            ("TOMAT_MODEL", model_preset),
            ("TOMAT_SEED", "42"),
            ("TOMAT_VAL_SEQS", str(val_seqs)),
            ("TOMAT_STEPS", "1"),
            ("TOMAT_STEPS_PER_EVAL", "1"),
            ("TOMAT_LMQ_PATH", lmq_path),
            ("TOMAT_MG_MODE", "1"),
            ("TOMAT_MG_LOSS_TYPE", loss_type),
            ("TOMAT_MG_KL_SIGMA", str(kl_sigma) if kl_sigma is not None else ""),
            ("TOMAT_MG_KL_SIGMA_UNIT", kl_sigma_unit),
            ("TOMAT_MG_MASK_PRIOR", mask_prior),
            ("TOMAT_EVAL_ONLY", "1"),
        ]

        fires: list[tuple[int, str]] = []
        for st in step_list:
            out_uri = f"{bucket}/eval/vl-backfill/{leaf}/step-{st}.json"
            job_name = f"vl-bf-{leaf[:20]}-step{st}"
            env_pairs = env_pairs_base + [
                ("TOMAT_EVAL_CKPT_STEP", str(st)),
                ("TOMAT_EVAL_OUT_URI", out_uri),
            ]
            # IRIS_BIN constant points to a non-existent path on this machine
            # (symlink chain tomat/marin/.venv → tomat/.venv → no iris bin);
            # the OA marin fork lives at $c/oa/marin and has the real iris
            # binary in its venv. Use that directly. (TODO: fix IRIS_BIN
            # constant if existing call sites are all broken too.)
            _iris_bin = "/Users/ryan/c/oa/marin/.venv/bin/iris"
            cmd = [
                _iris_bin, "--cluster=marin", "job", "run",
                "--tpu", tpu, "--enable-extra-resources", "--priority", "interactive",
                "--cpu", "96", "--memory", "128G",
                "--max-retries", "0",
                "--zone", zone,
            ]
            for k, v in env_pairs:
                cmd += ["--env-vars", k, v]
            cmd += ["--no-wait", "--no-terminate-on-exit",
                    "--job-name", job_name, "--", "python", "train_tomat_tpu.py"]
            try:
                r = subprocess.run(cmd, cwd=str(MARIN_DIR), capture_output=True, text=True)
            except Exception as e:
                err(f"[FAIL fire step={st}] {type(e).__name__}: {e}")
                continue
            if r.returncode != 0:
                err(f"[FAIL fire step={st}] rc={r.returncode}\n{r.stderr[-300:]}")
                continue
            # iris submit prints `/ryan/<job_name>` as the last stdout line.
            job_path = (r.stdout or "").strip().splitlines()[-1].strip() or f"/ryan/{job_name}"
            fires.append((st, job_path))
            err(f"[vl-backfill fired] step={st} {job_path}")

        err(f"[vl-backfill] {len(fires)}/{len(step_list)} iris job(s) fired.")
        print("\n[iris job IDs]")
        for st, jp in sorted(fires):
            print(f"  step={st:<6}  {jp}  out=https://iris.oa.dev/#/job/{jp.replace('/','%2F')}")
        if not fires:
            sys.exit(1)
        return

    # Modal fork: existing path (kept for v4/single-shard runs).
    per_hr = 30.0 if gpu == "H100:8" else 40.0
    timeout = 3600 if long_timeout else 600
    max_cost_per_call = per_hr * (timeout / 3600.0)
    err(f"[vl-backfill] gpu={gpu} timeout={timeout}s "
        f"max-per-call=${max_cost_per_call:.2f} → max-total=${max_cost_per_call * len(step_list):.2f}")
    if dry_run:
        err(f"[vl-backfill] dry-run; not spawning")
        return

    fn = get_fn(gpu, long=long_timeout)

    import modal as _modal
    err(f"[vl-backfill] deploying app {vl_app.name!r}…")
    vl_app.deploy()
    err(f"[vl-backfill] deployed; spawning {len(step_list)} call(s)…")

    lmq_path = f"{bucket}/codecs/lmq-v2-16k.npz"
    calls: list[tuple[int, str]] = []
    for st in step_list:
        try:
            call = fn.spawn(
                run_label=run_label,
                ckpt_leaf=leaf,
                step=st,
                bucket=bucket,
                parquet_label=parquet_label,
                lmq_path=lmq_path,
                model_preset=model_preset,
                val_seqs=val_seqs,
                eval_batch=batch_size,
                seq_len=8192,
                loss_type=loss_type,
                kl_sigma=kl_sigma,
                kl_sigma_unit=kl_sigma_unit,
                mask_prior=mask_prior,
                cache_dir_override=cache_dir_override,
            )
        except Exception as e:
            err(f"[FAIL spawn step={st}] {type(e).__name__}: {e}")
            continue
        calls.append((st, call.object_id))
        err(f"[vl-backfill spawned] step={st} call_id={call.object_id}")
    err(f"[vl-backfill] all {len(calls)}/{len(step_list)} call(s) spawned. "
        f"`modal app logs {vl_app.name}` to watch.")
    print("\n[modal call IDs]")
    for st, cid in sorted(calls):
        print(f"  step={st:<6} timeout={timeout}s  {cid}")


@evals.command("harvest")
@click.option("-S", "--sets", default="val_200,train_200")
@click.option("-i", "--interval", default=60, type=int, help="poll interval (sec)")
@click.option("-l", "--eval-label", default=None, help="TOMAT_LABEL for eval jobs (default: watchdog's own default = val-full-v3 for P19 runs)")
@click.option("-m", "--model", default="200M", help="TOMAT_MODEL preset for the eval jobs the watchdog will fire")
@click.argument("run_label")
def evals_harvest(run_label: str, sets: str, interval: int, eval_label: str | None, model: str):
    """Start watchdog harvesters in the background. They post NMAE numbers
    to wandb under eval/mat_nmae/<set>/<stat> as evals complete."""
    cwd = str(PROJECT_ROOT)
    started = []
    for s in sets.split(","):
        if s not in SPLITS:
            err(f"unknown mat-set {s!r}; known: {sorted(SPLITS)}")
            sys.exit(1)
        log = f"tmp/watchdog-{run_label}-{s}.log"
        env = {**os.environ, "EVAL_MAT_SET": s, "EVAL_SPLIT": SPLITS[s], "EVAL_MODEL": model}
        if eval_label:
            env["EVAL_LABEL"] = eval_label
        with open(log, "w") as logf:
            p = subprocess.Popen(
                ["bash", "tmp/watchdog-eval-checkpoints.sh", run_label, str(interval)],
                cwd=cwd,
                env=env,
                stdout=logf,
                stderr=subprocess.STDOUT,
                start_new_session=True,
            )
            started.append((s, p.pid, log))
    for s, pid, log in started:
        print(f"[{s} watchdog pid={pid} log={log}]")


@evals.command("sync")
@click.option("-b", "--bucket", default=R2_BUCKET, help="R2 bucket")
@click.option("-n", "--dry-run", is_flag=True, help="assemble + report, but skip the R2 upload")
@click.option("-p", "--prefix", default=R2_RUNS_PREFIX, help="R2 key prefix (run id appended)")
@click.argument("substr", required=False)
def evals_sync(substr: str | None, bucket: str, dry_run: bool, prefix: str):
    """Aggregate per-step GCS eval-result JSONs → `eval.json` → OA's R2.

    `eval_mat_nmae.py` writes one JSON per (checkpoint, mat-set) under
    `gs://marin-eu-west4/tomat/eval/results/<run>/<set>/step-<N>.json`. This
    collapses each run's JSONs into a compact
    `s3://<bucket>/<prefix>/<run>/eval.json` (per-step mat-NMAE/NEMD, both
    sets) — the canonical series the /runs dashboard reads. The harvested
    wandb points can't substitute: runs-sync's history-parquet merge
    collapses them to a single value.

    SUBSTR (optional) restricts to runs whose label contains it; omitted =
    every run with eval results.
    """
    import fsspec
    import numpy as np
    from datetime import datetime, timezone

    fs = fsspec.filesystem("gcs")
    results_base = "marin-eu-west4/tomat/eval/results"
    run_dirs = sorted(
        p.rsplit("/", 1)[-1] for p in fs.ls(results_base)
        if fs.isdir(p) and p.rsplit("/", 1)[-1] != "checkpoints"
    )
    if substr:
        run_dirs = [r for r in run_dirs if substr in r]
    if not run_dirs:
        err(f"[evals sync] no eval-result run dirs match {substr!r}")
        sys.exit(1)

    stat_keys = ("nmae_mean", "nmae_median", "nmae_p99",
                 "nemd_mean", "nemd_median", "nemd_p99")
    for run in run_dirs:
        sets: dict[str, list[dict]] = {}
        # Discover every `<set>(-<mode>)/` subdir (teacher/oneshot, free,
        # maskgit, ...) — shares `_backfill_discover_dirs` so sync + backfill
        # stay in lockstep on the on-GCS layout. One-shot (`mode=="teacher"`
        # internally; `--mode oneshot` from the CLI normalizes to it) subdirs
        # map back to the bare `<set>` key (back-compat with cont33k-era
        # eval.json's); other modes land under `<set>-<mode>` (the
        # dashboard's WallclockPlot iterates both flavors).
        for subdir, mat_set, mode in _backfill_discover_dirs(fs, results_base, run):
            sets_key = mat_set if mode == "teacher" else f"{mat_set}-{mode}"
            paths = [
                p for p in fs.ls(subdir)
                if (n := p.rsplit("/", 1)[-1]).startswith("step-")
                and n.endswith(".json")
            ]
            # File-stem grammar:
            #   `step-<N>`                — vanilla, single task, no variant
            #   `step-<N>-task<i>`        — `--num-tasks > 1` fan-out
            #   `step-<N>-<variant>`      — ablation variant (e.g. `K1` for the
            #                               post-reforward-removal K=1 sweep —
            #                               separate series from the original
            #                               K=12 maskgit results that share
            #                               the `<set>-maskgit/` directory).
            #   `step-<N>-<variant>-task<i>` — variant + fanout
            # Variants get their own sets_key (`<sets_key>-<variant>`) so a
            # single set-mode dir can carry multiple series. Task-fan-out
            # pools per (step, variant) so the row reflects the full mat set.
            variant_step_mats: dict[str, dict[int, list[dict]]] = {}
            for path, raw in fs.cat(paths).items():  # parallel fetch
                d = json.loads(raw)
                name = path.rsplit("/", 1)[-1]
                stem = name[len("step-"):-len(".json")]
                # Strip the trailing `-task<i>` first.
                core, _, _task = stem.rpartition("-task")
                if not core:  # rpartition returned ("", "", stem) — no -task
                    core = stem
                # core is now "<N>" or "<N>-<variant>".
                if "-" in core:
                    step_str, variant = core.split("-", 1)
                else:
                    step_str, variant = core, ""
                try:
                    step = int(step_str)
                except ValueError:
                    continue
                variant_step_mats.setdefault(variant, {}) \
                    .setdefault(step, []).extend(d.get("per_mat") or [])
            for variant, per_step_mats in variant_step_mats.items():
                variant_sets_key = sets_key if not variant else f"{sets_key}-{variant}"
                rows = []
                for step, per_mat in per_step_mats.items():
                    row = {"step": step, "n_mats": len(per_mat)}
                    # Recompute mean/median/p99 + spread percentiles from the
                    # pooled per_mat arrays — the per-task JSONs' own
                    # `nmae_mean` etc. fields are partial-set means and don't
                    # combine arithmetically.
                    # `nmae_filled` is maskgit-only — the diagnostic-path NMAE
                    # from argmax-per-iter filled_bins, bypassing the OOD final
                    # all-filled re-forward (memory: [[k1-oneshot-on-mg-is-gigo]]
                    # — for absorbing-trained MG models the re-forward is
                    # double-OOD, so `nmae` is GIGO; `nmae_filled` is the honest
                    # in-distribution number). Compute alongside the standard
                    # metrics whenever per_mat carries it.
                    metric_keys = ["nmae", "nemd"]
                    if any(m.get("nmae_filled") is not None for m in per_mat):
                        metric_keys.append("nmae_filled")
                    for metric in metric_keys:
                        vals = np.asarray(
                            [m[metric] for m in per_mat if m.get(metric) is not None],
                            dtype=float,
                        )
                        if not vals.size:
                            continue
                        row[f"{metric}_mean"] = float(vals.mean())
                        for pct, key in ((1, "p1"), (25, "p25"), (50, "median"),
                                         (75, "p75"), (99, "p99")):
                            row[f"{metric}_{key}"] = float(np.percentile(vals, pct))
                    rows.append(row)
                if rows:
                    sets[variant_sets_key] = sorted(rows, key=lambda r: r["step"])
        if not sets:
            err(f"[evals sync] {run}: no eval JSONs, skipping")
            continue
        doc = {
            "schema_version": 1,
            "synced_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
            "run": run,
            "sets": sets,
        }
        data = json.dumps(doc, separators=(",", ":")).encode()
        n_pts = sum(len(v) for v in sets.values())
        key = f"{prefix}/{run}/eval.json"
        if dry_run:
            err(f"[evals sync] {run}: {n_pts} pts, {len(data)} B → "
                f"s3://{bucket}/{key} (dry-run)")
        else:
            _r2_put_bytes(bucket, key, data, "application/json")
            err(f"[evals sync] {run}: {n_pts} pts → {R2_ENDPOINT}/{bucket}/{key}")


# ──────────────────────────────────────────────────────────────────────
# Spec 51 — eval prediction zarrs: GCS → R2 mirror helpers.
# ──────────────────────────────────────────────────────────────────────


def _mirror_gcs_dir_to_r2(
    gcs_prefix: str,
    bucket: str,
    r2_prefix: str,
    *,
    content_type: str = "application/octet-stream",
    skip_existing: bool = True,
) -> tuple[int, int]:
    """Mirror every file under `gcs_prefix` (no leading `gs://`, no trailing `/`)
    to `s3://<bucket>/<r2_prefix>/` via `aws s3 cp` (cfo profile).

    Returns (n_uploaded, n_skipped). Uses `aws s3 sync` for batched parallel
    upload — preserves the relative directory structure (zarr groups need
    `<key>/zarr.json`, `<key>/c/0/0/0`, etc. all at parallel paths).
    """
    import fsspec
    import subprocess
    import tempfile
    import shutil
    fs = fsspec.filesystem("gcs")
    if not fs.exists(gcs_prefix):
        return (0, 0)
    files = [p for p in fs.find(gcs_prefix) if not p.endswith("/")]
    if not files:
        return (0, 0)
    if skip_existing:
        # Cheap dedup: skip if the marker file (zarr.json or .zarray) already
        # exists on R2. Not perfect — partial uploads still slip through — but
        # avoids re-uploading complete zarrs on every sync pass.
        marker_candidates = (f"{gcs_prefix}/zarr.json", f"{gcs_prefix}/.zarray")
        if any(m in files for m in marker_candidates):
            check_key = f"{r2_prefix}/zarr.json"
            r = subprocess.run(
                ["aws", "--profile", "cfo", "--endpoint-url", R2_ENDPOINT,
                 "s3api", "head-object", "--bucket", bucket, "--key", check_key],
                capture_output=True, text=True,
            )
            if r.returncode == 0:
                return (0, len(files))
    # Stage to local tmp + aws sync (parallel uploads, retries, content-type).
    tmpdir = tempfile.mkdtemp(prefix="tomat-r2-mirror-")
    try:
        for f in files:
            rel = f[len(gcs_prefix):].lstrip("/")
            local_path = f"{tmpdir}/{rel}"
            os.makedirs(os.path.dirname(local_path) or tmpdir, exist_ok=True)
            with open(local_path, "wb") as out:
                out.write(fs.cat_file(f))
        r = subprocess.run(
            ["aws", "--profile", "cfo", "--endpoint-url", R2_ENDPOINT,
             "s3", "sync", tmpdir, f"s3://{bucket}/{r2_prefix}",
             "--content-type", content_type, "--no-progress"],
            capture_output=True, text=True,
        )
        if r.returncode != 0:
            err(f"[mirror] aws s3 sync failed: {r.stderr[:400]}")
            return (0, len(files))
        return (len(files), 0)
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)


@evals.command("mirror-mat")
@click.option("-r", "--run", "run_label", required=True, help="run label (e.g. train-mg-kl-bin5-fs-tpu)")
@click.option("-m", "--mp-id", "mp_id", required=True, help="material id (e.g. mp-1921473)")
@click.option("-s", "--set", "set_name", default="val_200", show_default=True, help="mat set (val_200 / train_200)")
@click.option("--mode", default="maskgit", show_default=True, help="eval mode (oneshot|maskgit|free); 'oneshot' / 'teacher' use bare set name")
@click.option("--step", default=None, type=int, help="ckpt step (required if --pred is set)")
@click.option("--gt/--no-gt", default=True, show_default=True, help="mirror the GT charge density zarr")
@click.option("--pred/--no-pred", default=True, show_default=True, help="mirror the prediction zarr (requires --step)")
@click.option("--gcs-bucket", default="marin-eu-west4", show_default=True, help="source GCS bucket (no gs:// prefix)")
@click.option("-b", "--bucket", default=R2_BUCKET, show_default=True, help="dest R2 bucket")
@click.option("--split", default=None, help="zarr split (validation|train); auto-detects from set name if unset")
@click.option("-n", "--dry-run", is_flag=True)
def evals_mirror_mat(
    run_label: str, mp_id: str, set_name: str, mode: str,
    step: int | None, gt: bool, pred: bool,
    gcs_bucket: str, bucket: str, split: str | None, dry_run: bool,
):
    """Mirror one mat's GT and/or prediction zarr from GCS → R2 for elvis viz.

    GT path  : gs://<gcs_bucket>/tomat/rho_gga_raw/<split>/<mp_id>.zarr
              → s3://<bucket>/tomat/rho_gga_raw/<split>/<mp_id>.zarr
    Pred path: gs://<gcs_bucket>/tomat/eval/predictions/<run>/<set>{-mode}/<step>/<mp_id>.zarr
              → s3://<bucket>/tomat/eval/<run>/predictions/<set>{-mode}/<step>/<mp_id>.zarr

    `tomat evals fire -V` writes pred zarrs; this then makes them viewable in
    elvis. ELVis URL:
      https://elvis.oa.dev/?v0=https://<r2.../tomat/rho_gga_raw/<split>/<mp_id>.zarr>&v1=https://<r2.../tomat/eval/<run>/predictions/<setmode>/<step>/<mp_id>.zarr>&src=diff
    """
    if pred and step is None:
        err("--pred requires --step")
        sys.exit(2)
    if not gt and not pred:
        err("nothing to mirror (pass --gt or --pred)")
        sys.exit(2)
    if split is None:
        split = "validation" if set_name.startswith("val") else "train"
    setmode = set_name if mode in ("oneshot", "teacher") else f"{set_name}-{mode}"

    out: list[str] = []
    if gt:
        gcs = f"{gcs_bucket}/tomat/rho_gga_raw/{split}/{mp_id}.zarr"
        r2_key = f"tomat/rho_gga_raw/{split}/{mp_id}.zarr"
        if dry_run:
            err(f"[mirror-mat] GT: gs://{gcs} → s3://{bucket}/{r2_key} (dry-run)")
        else:
            up, sk = _mirror_gcs_dir_to_r2(gcs, bucket, r2_key)
            err(f"[mirror-mat] GT mp={mp_id}: uploaded={up} skipped={sk}")
        out.append(f"https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com/{bucket}/{r2_key}")
    if pred:
        gcs = (f"{gcs_bucket}/tomat/eval/predictions/{run_label}/"
               f"{setmode}/step-{step}/{mp_id}.zarr")
        r2_key = (f"tomat/eval/{run_label}/predictions/"
                  f"{setmode}/step-{step}/{mp_id}.zarr")
        if dry_run:
            err(f"[mirror-mat] PRED: gs://{gcs} → s3://{bucket}/{r2_key} (dry-run)")
        else:
            up, sk = _mirror_gcs_dir_to_r2(gcs, bucket, r2_key)
            err(f"[mirror-mat] PRED mp={mp_id} step={step}: uploaded={up} skipped={sk}")
        out.append(f"https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com/{bucket}/{r2_key}")
    # Helper: print ELVis URL when both were mirrored.
    if gt and pred and not dry_run:
        v0, v1 = out[0], out[1]
        print(f"\nelvis url:\n  https://elvis.oa.dev/?v0={v0}&v1={v1}&src=diff")


@cli.group()
def zarr():
    """Voxel-zarr utilities — bulk GT mirror to R2, future converters."""


@zarr.command("mirror-r2")
@click.option("-s", "--src", default="gs://marin-eu-west4/tomat/rho_gga_v3mr",
              show_default=True,
              help="GCS source prefix containing `<split>/<mp>.zarr/` subdirs")
@click.option("-d", "--dst-prefix", default="tomat/rho_gga_v3mr",
              show_default=True,
              help="R2 key prefix (under --bucket)")
@click.option("-b", "--bucket", default=R2_BUCKET, show_default=True)
@click.option("--split", default=None,
              help="restrict to one split (validation|train|test); default = all subdirs")
@click.option("--limit", default=0, type=int,
              help="stop after N zarrs (smoke; 0 = unlimited)")
@click.option("-j", "--workers", default=20, type=int, show_default=True,
              help="ThreadPoolExecutor size for per-zarr mirror parallelism. "
                   "Each worker holds one tmpdir + a `aws s3 sync` subprocess.")
@click.option("-n", "--dry-run", is_flag=True)
def zarr_mirror_r2(
    src: str, dst_prefix: str, bucket: str,
    split: str | None, limit: int, workers: int, dry_run: bool,
):
    """Bulk-mirror every <split>/<mp>.zarr/ under SRC from GCS to R2.

    SRC defaults to the GT pyramid prefix written by `convert_zarrs_modal.py`.
    R2 layout mirrors the GCS layout 1:1 at <bucket>/<dst-prefix>/<split>/<mp>.zarr/.
    Uses `aws s3 sync` per-zarr (the same path the eval-pred mirror uses) so
    elvis sees the right Content-Type + CORS headers.
    """
    import fsspec
    import time
    from concurrent.futures import ThreadPoolExecutor, as_completed
    import threading
    fs = fsspec.filesystem("gs")
    src_clean = src.rstrip("/")
    src_gcs = src_clean.removeprefix("gs://")
    # Enumerate `<split>/` subdirs unless one was pinned.
    if split:
        splits = [split]
    else:
        try:
            children = [p.rsplit("/", 1)[-1] for p in fs.ls(src_gcs)]
            splits = sorted(c for c in children if c)
        except Exception as e:
            err(f"[zarr mirror-r2] failed to list {src}: {e}")
            sys.exit(1)
    err(f"[zarr mirror-r2] splits: {splits}  workers={workers}")

    # Flatten across splits so the threadpool has a uniform work list.
    tasks: list[tuple[str, str, str, str]] = []  # (sp, leaf, gcs, r2_key)
    for sp in splits:
        try:
            zarrs = [
                p.rsplit("/", 1)[-1]
                for p in fs.ls(f"{src_gcs}/{sp}")
                if p.endswith(".zarr") or p.endswith(".zarr/")
            ]
        except Exception as e:
            err(f"[zarr mirror-r2] split {sp}: skip ({e})")
            continue
        zarrs.sort()
        err(f"[zarr mirror-r2] {sp}: {len(zarrs)} zarrs queued")
        for leaf in zarrs:
            gcs = f"{src_gcs}/{sp}/{leaf}"
            r2_key = f"{dst_prefix}/{sp}/{leaf}"
            tasks.append((sp, leaf, gcs, r2_key))
    if limit > 0:
        tasks = tasks[:limit]
    if dry_run:
        for sp, leaf, gcs, r2_key in tasks:
            err(f"  {leaf.removesuffix('.zarr')}: gs://{gcs} → s3://{bucket}/{r2_key} (dry-run)")
        return

    n_ok = n_skipped = n_err = 0
    counter_lock = threading.Lock()
    t0 = time.time()

    def _one(sp_leaf_gcs_r2):
        sp, leaf, gcs, r2_key = sp_leaf_gcs_r2
        try:
            up, sk = _mirror_gcs_dir_to_r2(gcs, bucket, r2_key)
            return ("skip" if (up == 0 and sk > 0) else ("ok" if up > 0 else "err"))
        except Exception as e:
            return f"err:{type(e).__name__}"

    with ThreadPoolExecutor(max_workers=workers) as pool:
        futures = [pool.submit(_one, t) for t in tasks]
        for i, fut in enumerate(as_completed(futures)):
            r = fut.result()
            with counter_lock:
                if r == "ok":
                    n_ok += 1
                elif r == "skip":
                    n_skipped += 1
                else:
                    n_err += 1
                done = n_ok + n_skipped + n_err
            if done % 50 == 0 or done == len(tasks):
                rate = done / max(time.time() - t0, 1e-3)
                err(f"  {done}/{len(tasks)} ok={n_ok} skip={n_skipped} err={n_err} "
                    f"({rate:.1f}/s)")
    err(f"[zarr mirror-r2] done in {time.time() - t0:.0f}s: "
        f"ok={n_ok} skipped={n_skipped} err={n_err}")


# ──────────────────────────────────────────────────────────────────────
# tomat evals process-fire-requests — drain dashboard eval-fire requests.
# ──────────────────────────────────────────────────────────────────────


EVAL_FIRE_REQUESTS_PREFIX = "tomat/eval-fire-requests"


def _eval_label_for_run(run_label: str) -> str:
    """Pick a sensible TOMAT_LABEL for an eval fire against a given run.
    P14/v2 runs use `val-full-lmq-v2`; P19/v3 runs use `val-full-v3`.
    Heuristic: name match on the run label. Returns `val-full-v3` by default.
    """
    # P14/v2 era runs had `-v2` somewhere in the name (e.g. `cont7k-ext`, …).
    # Default to v3 for everything else — matches the `tomat evals fire`
    # default + memory `v2-t10n-contamination`.
    if "-v2" in run_label and "-v3" not in run_label:
        return "val-full-lmq-v2"
    return "val-full-v3"


@evals.command("process-fire-requests")
@click.option("-b", "--bucket", default=R2_BUCKET, help="R2 bucket")
@click.option("-p", "--prefix", default=EVAL_FIRE_REQUESTS_PREFIX,
              help="R2 key prefix where the CFW writes pending fire-requests")
@click.option("-n", "--dry-run", is_flag=True,
              help="show what would be fired (and what would be deleted) without invoking iris or deleting requests")
@click.option("-T", "--tpu", default="v6e-8", show_default=True, help="--tpu for iris evals (default v6e-8)")
@click.option("-l", "--limit", default=20, type=int, show_default=True,
              help="max number of requests to process this pass (defensive — bursty FE can spam)")
def evals_process_fire_requests(
    bucket: str, prefix: str, dry_run: bool, tpu: str, limit: int,
):
    """Drain pending eval-fire-requests from R2 (one `tomat evals fire` per
    request, then delete the consumed request).

    Each request looks like:
        {"run_id": "train-mg-…", "step": 40000, "mat_set": "val_200",
         "mode": "maskgit", "eval_label": "val-full-v3", "fired_at": "...",
         "reason": "single-from-dashboard"}

    Behaviour:
      - lists every object under `<prefix>/`
      - for each, parses + fires via `tomat evals fire ... <run_id>`
      - on success, deletes the R2 object so the dashboard's "queued" cell
        flips back to "in-flight" (or "succeeded") on the next snapshot
      - on failure, leaves the request in place — autosync.sh's next pass
        retries (idempotent; iris's de-dup is the backstop).

    See `scripts/autosync.sh` Phase D and `worker/src/index.ts handleEvalFire`.
    """
    keys = _r2_list_keys(bucket, f"{prefix}/")
    keys = [k for k in keys if k.endswith(".json")]
    if not keys:
        err(f"[evals process-fire-requests] no pending requests under s3://{bucket}/{prefix}/")
        return
    if len(keys) > limit:
        err(f"[evals process-fire-requests] {len(keys)} pending; capping at --limit={limit}")
        keys = keys[:limit]

    n_ok = n_fail = n_dropped = 0
    for key in keys:
        # `_r2_get_json` returns dict|list|None — we always wrote a dict.
        body = _r2_get_json(bucket, key)
        if not isinstance(body, dict):
            err(f"[fire-req] {key}: not a JSON object; skipping")
            n_dropped += 1
            continue
        run_id = body.get("run_id")
        step = body.get("step")
        mat_set = body.get("mat_set")
        mode = body.get("mode")
        eval_label = body.get("eval_label") or _eval_label_for_run(str(run_id))
        if (
            not isinstance(run_id, str)
            or not isinstance(step, int)
            or mat_set not in ("val_200", "train_200")
            or mode not in ("oneshot", "maskgit", "free")
        ):
            err(f"[fire-req] {key}: malformed body, deleting: {body}")
            if not dry_run:
                _r2_delete_key(bucket, key)
            n_dropped += 1
            continue
        # Best-effort: skip if the eval result JSON already exists on GCS
        # (e.g. autosync.sh saw the request after the user already manually
        # fired it). Cheap GCS stat keeps us from re-queuing a finished cell.
        try:
            import fsspec
            fs = fsspec.filesystem("gcs")
            sub = mat_set if mode in ("oneshot", "teacher") else f"{mat_set}-{mode}"
            result_path = (
                f"marin-eu-west4/tomat/eval/results/{run_id}/{sub}/step-{step}.json"
            )
            if fs.exists(result_path):
                err(f"[fire-req] {key}: result JSON already on GCS at "
                    f"gs://{result_path}; deleting request")
                if not dry_run:
                    _r2_delete_key(bucket, key)
                n_dropped += 1
                continue
        except Exception as e:
            # Don't let a transient GCS issue block firing — just log + proceed.
            err(f"[fire-req] {key}: GCS pre-check failed ({e}); proceeding with fire")

        # Dispatch `tomat evals fire`. We invoke the running CLI as a
        # subprocess so we don't have to refactor `evals_fire` to be
        # importable; that also gives us a clean stdout/stderr separation.
        cmd = [
            sys.argv[0], "evals", "fire",
            "-s", str(step),
            "-S", mat_set,
            "-l", eval_label,
            "-T", tpu,
            "--mode", mode,
            run_id,
        ]
        if dry_run:
            err(f"[fire-req] (dry-run) would fire: {' '.join(cmd)}")
            err(f"[fire-req] (dry-run) would delete: s3://{bucket}/{key}")
            n_ok += 1
            continue
        err(f"[fire-req] dispatching: {' '.join(cmd)}")
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=300)
        if r.returncode != 0:
            err(f"[fire-req] {key}: `tomat evals fire` rc={r.returncode}")
            err(r.stdout[-1500:])
            err(r.stderr[-1500:])
            n_fail += 1
            continue
        # Fire succeeded → drop the request from R2 so the next snapshot
        # pass sees the iris job (RUNNING) instead of the "queued" cell.
        if _r2_delete_key(bucket, key):
            err(f"[fire-req] {key}: fired + deleted request")
            n_ok += 1
        else:
            err(f"[fire-req] {key}: fired but failed to delete (will retry next pass)")
            n_ok += 1
    err(f"[evals process-fire-requests] done: {n_ok} fired, {n_fail} failed, "
        f"{n_dropped} dropped (out of {len(keys)})")


# ──────────────────────────────────────────────────────────────────────
# tomat evals backfill — reconstruct eval records from historical GCS results.
# See specs/43-run-eval-relation.md §"Backfill" + §"Data model".
# ──────────────────────────────────────────────────────────────────────

# Set names whose results land directly under `eval/results/<dir>/<set>/`
# (one-shot / teacher mode — bare set name, no `-<mode>` suffix) or under
# `eval/results/<dir>/<set>-<mode>/` (free, maskgit, ...). We scan for both
# flavors per known set. The internal `mode="teacher"` label is preserved
# (vs renaming to `"oneshot"`) so existing R2 record keys / `mode` JSON
# fields stay back-compatible.
_BACKFILL_SETS = ("val_200", "train_200")
_BACKFILL_MODES = ("teacher", "free", "maskgit")


def _backfill_record_key(step: int, set_: str, mode: str, task_idx: int | None) -> str:
    """Build the record's key — used both for the R2 filename and the
    index.json entry. Spec 43 §"Where the record lives":
    `<step>-<set>-<mode>(-task<i>)`."""
    suffix = f"-task{task_idx}" if task_idx is not None else ""
    return f"{step}-{set_}-{mode}{suffix}"


def _backfill_result_summary(d: dict) -> dict:
    """Copy out the scalar(s) the dashboard renders. The full per-step JSON
    stays on GCS at `gcs_result_path`.

    `nmae_filled_*` is maskgit-only — the diagnostic-path NMAE from the
    argmax-per-iter filled_bins, bypassing the OOD final all-filled
    re-forward (memory: [[k1-oneshot-on-mg-is-gigo]]). Always copied
    when present so dashboards can prefer it over the GIGO `nmae_*`
    on MG runs without a schema migration."""
    return {
        "n_mats":      d.get("n_mats"),
        "nmae_mean":   d.get("nmae_mean"),
        "nmae_median": d.get("nmae_median"),
        "nmae_p99":    d.get("nmae_p99"),
        "nmae_filled_mean":   d.get("nmae_filled_mean"),
        "nmae_filled_median": d.get("nmae_filled_median"),
        "nmae_filled_p99":    d.get("nmae_filled_p99"),
        "nemd_mean":   d.get("nemd_mean"),
        "nemd_median": d.get("nemd_median"),
        "nemd_p99":    d.get("nemd_p99"),
    }


def _backfill_parse_step_filename(fname: str) -> tuple[int, int | None] | None:
    """`step-<N>.json` → (N, None); `step-<N>-task<I>.json` → (N, I).
    Returns None on a non-matching name."""
    if not (fname.startswith("step-") and fname.endswith(".json")):
        return None
    stem = fname[len("step-"):-len(".json")]
    task: int | None = None
    if "-task" in stem:
        stem, task_s = stem.split("-task", 1)
        try:
            task = int(task_s)
        except ValueError:
            return None
    try:
        return int(stem), task
    except ValueError:
        return None


def _backfill_discover_dirs(fs, results_base: str, dashboard_run_id: str) -> list[tuple[str, str, str]]:
    """Find every `<set>(-<mode>)` subdir for a given dashboard run id.
    Returns [(gcs_subdir, set, mode), ...]. The dashboard run id IS the
    `eval/results/` leaf dir name for both Modal-trained (`...-bs128-seed42`)
    and iris-trained (`<run_label>`) runs — see spec 43 §"Backfill" + the
    `--ckpt-leaf` flag in `tomat evals fire`.

    Reads the directory listing once; iterates all (set, mode) flavors
    against it. Missing subdirs are silently skipped — runs vary in which
    mat-sets / modes they've been evaluated against.
    """
    run_base = f"{results_base}/{dashboard_run_id}"
    if not fs.exists(run_base):
        return []
    try:
        children = {p.rsplit("/", 1)[-1] for p in fs.ls(run_base) if fs.isdir(p)}
    except Exception as e:
        err(f"[evals backfill] WARN: ls {run_base} failed: {e}")
        return []
    out: list[tuple[str, str, str]] = []
    for s in _BACKFILL_SETS:
        # Teacher mode → bare `<set>/` subdir.
        if s in children:
            out.append((f"{run_base}/{s}", s, "teacher"))
        # Other modes → `<set>-<mode>/` subdirs.
        for m in _BACKFILL_MODES:
            if m == "teacher":
                continue
            sub = f"{s}-{m}"
            if sub in children:
                out.append((f"{run_base}/{sub}", s, m))
    return out


@evals.command("backfill")
@click.option("-b", "--bucket", default=R2_BUCKET, help="R2 bucket")
@click.option("-p", "--prefix", default=R2_RUNS_PREFIX, help="R2 key prefix (run id appended)")
@click.option("-g", "--gcs-bucket", default=GCS_BUCKET, help="GCS bucket holding eval results")
@click.option("-f", "--force", is_flag=True, help="rewrite records even if newer-or-equal mtime exists on R2 (default: skip)")
@click.option("-n", "--dry-run", is_flag=True, help="report what would be written; skip R2 uploads")
@click.argument("run_label")
def evals_backfill(
    run_label: str,
    bucket: str,
    prefix: str,
    gcs_bucket: str,
    force: bool,
    dry_run: bool,
):
    """Reconstruct eval records for historical eval results (spec 43, Phase A).

    For RUN_LABEL (= the dashboard run id, which equals the wandb run name
    AND the leaf dir under `gs://<bucket>/eval/results/`), discover every
    `<set>(-<mode>)/step-*.json` result file, fabricate one record per
    `(step, set, mode, task)` combination with `state="succeeded"` and
    `result` populated from the JSON's scalars, and upload:

      - `s3://<bucket>/<prefix>/<run>/evals/<key>.json` (one per record)
      - `s3://<bucket>/<prefix>/<run>/evals/index.json` (pointer list)

    Idempotent: by default, skip records whose R2 mtime is ≥ the GCS object
    mtime (which is set when the result JSON last landed). Pass --force to
    rewrite all records unconditionally — useful when the record schema
    changes.

    `job_ref` is null on backfill records (the backend handle is lost —
    we can't reconstruct iris job names or Modal call-ids from result JSONs).
    """
    import fsspec
    from datetime import datetime, timezone

    fs = fsspec.filesystem("gcs")
    # Strip the `gs://` scheme + tomat sub-prefix to match the existing
    # `evals sync` style (`fsspec` accepts both, but consistency helps).
    gcs_bucket_path = gcs_bucket.replace("gs://", "")
    results_base = f"{gcs_bucket_path}/eval/results"

    subdirs = _backfill_discover_dirs(fs, results_base, run_label)
    if not subdirs:
        err(f"[evals backfill] no eval-result subdirs found for {run_label!r} "
            f"under gs://{results_base}/{run_label}/")
        err("                  (this is fine for runs with no evals fired yet)")
        # Still write an empty index so the CFW returns [] vs 404.
        index: list[dict] = []
        _backfill_upload_index(bucket, prefix, run_label, index, dry_run=dry_run)
        return

    # Pre-list existing R2 records so we can apply the idempotency check
    # without an aws-head-object per record. Records that don't yet exist
    # on R2 get written unconditionally.
    existing = _backfill_list_r2_records(bucket, prefix, run_label)

    records_by_key: dict[str, dict] = {}
    n_written = n_skipped = n_failed = 0

    for subdir, set_, mode in subdirs:
        try:
            entries = fs.ls(subdir, detail=True)
        except Exception as e:
            err(f"[evals backfill] WARN: ls {subdir} failed: {e}")
            continue
        # Collect (path, mtime, step, task) tuples.
        for entry in entries:
            path = entry["name"] if isinstance(entry, dict) else entry
            if not path.endswith(".json"):
                continue
            fname = path.rsplit("/", 1)[-1]
            parsed = _backfill_parse_step_filename(fname)
            if parsed is None:
                continue
            step, task_idx = parsed
            key = _backfill_record_key(step, set_, mode, task_idx)
            gcs_path = f"gs://{path}" if not path.startswith("gs://") else path
            # Pull GCS mtime for the staleness check + the record's
            # fired_at/result_seen_at synth. fsspec's `ls(detail=True)`
            # returns dicts with an `updated` key on GCS; fall back to a
            # `stat` call if missing.
            mtime_iso: str | None = None
            mtime_epoch: float | None = None
            if isinstance(entry, dict):
                upd = entry.get("updated") or entry.get("mtime")
                if isinstance(upd, str):
                    mtime_iso = upd
                    try:
                        mtime_epoch = datetime.fromisoformat(
                            upd.replace("Z", "+00:00")
                        ).timestamp()
                    except Exception:
                        pass
                elif isinstance(upd, (int, float)):
                    mtime_epoch = float(upd)
                    mtime_iso = datetime.fromtimestamp(
                        mtime_epoch, tz=timezone.utc,
                    ).isoformat(timespec="seconds")
            if mtime_iso is None:
                try:
                    st = fs.stat(path)
                    upd = st.get("updated") or st.get("mtime")
                    if isinstance(upd, str):
                        mtime_iso = upd
                        try:
                            mtime_epoch = datetime.fromisoformat(
                                upd.replace("Z", "+00:00")
                            ).timestamp()
                        except Exception:
                            pass
                    elif isinstance(upd, (int, float)):
                        mtime_epoch = float(upd)
                        mtime_iso = datetime.fromtimestamp(
                            mtime_epoch, tz=timezone.utc,
                        ).isoformat(timespec="seconds")
                except Exception:
                    pass

            # Idempotency: skip if R2 record exists AND its mtime ≥ GCS mtime.
            ex_mtime = existing.get(f"{key}.json")
            if not force and ex_mtime is not None and mtime_epoch is not None and ex_mtime >= mtime_epoch:
                n_skipped += 1
                # Still surface the record in the index — we just won't
                # re-upload its body. Pull the existing one to grab the
                # state for the index entry.
                idx_entry = {
                    "key": key,
                    "fired_at": mtime_iso or "1970-01-01T00:00:00Z",
                    "state": "succeeded",
                }
                records_by_key[key] = idx_entry
                continue

            # Read + parse the result JSON to extract the result scalars.
            try:
                with fs.open(path, "r") as f:
                    raw = json.load(f)
            except Exception as e:
                err(f"[evals backfill] WARN: read {path} failed: {e}")
                n_failed += 1
                continue

            # Sanity-check the mode/set match — guards against renamed
            # eval scripts dumping into the wrong subdir.
            if raw.get("mode") and raw["mode"] != mode:
                err(f"[evals backfill] WARN: {path} reports mode={raw['mode']!r}, "
                    f"expected {mode!r} (path-derived); using path-derived value")
            if raw.get("mat_set") and raw["mat_set"] != set_:
                err(f"[evals backfill] WARN: {path} reports mat_set={raw['mat_set']!r}, "
                    f"expected {set_!r} (path-derived)")

            ckpt = raw.get("checkpoint") or ""
            # `gs://<bucket>/<tomat_prefix>/results/<run_label>/checkpoints/<leaf>/step-N`
            ckpt_leaf: str | None = None
            m = re.search(r"/results/([^/]+)/checkpoints/([^/]+)/step-\d+/?$", ckpt)
            if m:
                rl = m.group(1)
                leaf = m.group(2)
                if leaf != rl:
                    ckpt_leaf = leaf

            fired_at = mtime_iso or datetime.now(timezone.utc).isoformat(timespec="seconds")
            record = {
                "schema_version": 1,
                "run_label":  run_label,
                "ckpt_leaf":  ckpt_leaf,
                "step":       step,
                "set":        set_,
                "mode":       mode,
                "task_idx":   task_idx,
                "n_tasks":    1,                       # backfill doesn't know fanout cardinality
                "n_mats":     raw.get("n_mats"),
                "eval_label": raw.get("label"),
                "model_preset": raw.get("model"),
                "mg_k_steps": None,
                "free_batch": None,
                "eval_batch": None,
                "decoder":    None,

                "backend":  None,   # backend handle is lost
                "job_ref":  None,

                "fired_at":         fired_at,
                "state":            "succeeded",
                "state_synced_at":  fired_at,
                "started_at":       None,
                "finished_at":      fired_at,
                "exit_code":        0,
                "error_msg":        None,

                "gcs_result_path":  gcs_path,
                "result":           _backfill_result_summary(raw),
                "result_seen_at":   fired_at,
            }
            data = json.dumps(record, separators=(",", ":")).encode()
            r2_key = f"{prefix}/{run_label}/evals/{key}.json"
            if dry_run:
                err(f"[evals backfill] {run_label}: would upload {r2_key} "
                    f"({len(data)} B)")
            else:
                _r2_put_bytes(bucket, r2_key, data, "application/json")
            n_written += 1
            records_by_key[key] = {
                "key":      key,
                "fired_at": fired_at,
                "state":    "succeeded",
            }

    # Sort the index by (step, set, mode, task) per spec — cheap-stable.
    def _index_sort_key(e: dict) -> tuple:
        parts = e["key"].split("-")
        # Defensive: keys we wrote are always `step-set-mode[-taskI]`.
        try:
            step = int(parts[0])
        except ValueError:
            step = 0
        return (step, e["key"])

    index = sorted(records_by_key.values(), key=_index_sort_key)
    _backfill_upload_index(bucket, prefix, run_label, index, dry_run=dry_run)

    err(f"[evals backfill] {run_label}: wrote {n_written} record(s), "
        f"skipped {n_skipped}, failed {n_failed}; index has {len(index)} entries")


def _backfill_list_r2_records(bucket: str, prefix: str, run_label: str) -> dict[str, float]:
    """List `evals/*.json` under one run on R2, return `{filename: mtime_epoch}`.
    Used for idempotency in `evals backfill`."""
    r = subprocess.run(
        ["aws", "--profile", "cfo", "--endpoint-url", R2_ENDPOINT,
         "s3api", "list-objects-v2",
         "--bucket", bucket,
         "--prefix", f"{prefix}/{run_label}/evals/",
         "--query", "Contents[].[Key,LastModified]",
         "--output", "text"],
        capture_output=True, text=True, timeout=60,
    )
    if r.returncode != 0:
        err(f"[evals backfill] WARN: list existing R2 records failed: "
            f"rc={r.returncode} stderr={r.stderr[-200:]}")
        return {}
    out: dict[str, float] = {}
    from datetime import datetime
    for line in (r.stdout or "").splitlines():
        line = line.strip()
        if not line or line == "None":
            continue
        # `Contents[].[Key,LastModified]` `--output text` emits TAB-separated.
        parts = line.split("\t")
        if len(parts) < 2:
            continue
        key, lastmod = parts[0], parts[1]
        fname = key.rsplit("/", 1)[-1]
        if fname == "index.json":
            continue
        try:
            mtime = datetime.fromisoformat(lastmod.replace("Z", "+00:00")).timestamp()
        except Exception:
            continue
        out[fname] = mtime
    return out


def _backfill_upload_index(
    bucket: str,
    prefix: str,
    run_label: str,
    index: list[dict],
    dry_run: bool,
):
    """Write `evals/index.json` for one run."""
    key = f"{prefix}/{run_label}/evals/index.json"
    data = json.dumps(index, separators=(",", ":")).encode()
    if dry_run:
        err(f"[evals backfill] {run_label}: would upload index "
            f"({len(index)} entries, {len(data)} B) → s3://{bucket}/{key}")
        return
    _r2_put_bytes(bucket, key, data, "application/json")
    err(f"[evals backfill] {run_label}: index ({len(index)} entries) "
        f"→ {R2_ENDPOINT}/{bucket}/{key}")


