def _gcs_ls(path: str) -> list[str]:
    """Return `gsutil ls <path>` lines, or empty list if path doesn't exist."""
    r = subprocess.run(
        ["gsutil", "ls", path], capture_output=True, text=True, timeout=60,
    )
    if r.returncode != 0:
        return []
    return [l.strip() for l in r.stdout.split("\n") if l.strip()]


def _latest_ckpt_step(run_label: str, bucket: str = GCS_BUCKET) -> int | None:
    """Return the latest `step_idx` under the run's checkpoint dir, or None.

    `step_idx` is 0-based (Levanter `info.step`); see `docs/step-conventions.md`.
    """
    base = f"{bucket}/results/{run_label}/checkpoints/{run_label}"
    step_indices = []
    for line in _gcs_ls(f"{base}/"):
        m = re.search(r"/step-(\d+)/?$", line)
        if m:
            step_indices.append(int(m.group(1)))
    return max(step_indices) if step_indices else None


SUBMISSIONS_PATH = Path.home() / ".tomat" / "submissions.jsonl"


def _write_submission_record(
    label: str,
    tpu: str,
    cmd: list[str],
    invoked_at: float,
    accepted_at: float,
    mode: str,
) -> None:
    """Append a SubmissionRecord to ~/.tomat/submissions.jsonl (spec 42 Phase A).

    Captures the wall-clock submission boundary that wandb's `_runtime`
    misses (queue wait + provisioning + deps + JAX init + JIT). Best-effort:
    failures log a warning, never block the fire.

    Phase A persists locally; Phase B will POST to the dashboard D1.
    """
    try:
        marin_pin: str | None = None
        try:
            txt = (MARIN_DIR / "pyproject.toml").read_text()
            shas = set(re.findall(r'rev = "([0-9a-f]{40})"', txt))
            if len(shas) == 1:
                marin_pin = next(iter(shas))
        except Exception:
            pass

        git_sha: str | None = None
        try:
            r = subprocess.run(
                ["git", "rev-parse", "HEAD"],
                cwd=str(PROJECT_ROOT), capture_output=True, text=True, timeout=5,
            )
            if r.returncode == 0:
                git_sha = r.stdout.strip()
        except Exception:
            pass

        try:
            fire_host = socket.gethostname()
        except Exception:
            fire_host = None

        # Redact WANDB_API_KEY from the stored argv.
        api_key = os.environ.get("WANDB_API_KEY") or ""
        argv = [
            "<WANDB_API_KEY>" if (api_key and a == api_key) else a
            for a in cmd
        ]

        record = {
            "label": label,
            "cluster": "marin",
            "tpu": tpu,
            "mode": mode,
            "invoked_at": round(invoked_at, 3),
            "iris_accepted_at": round(accepted_at, 3),
            "queue_wait_s": round(accepted_at - invoked_at, 3),
            "fire_host": fire_host,
            "git_sha": git_sha,
            "marin_pin": marin_pin,
            "fire_argv": argv,
        }
        SUBMISSIONS_PATH.parent.mkdir(parents=True, exist_ok=True)
        with open(SUBMISSIONS_PATH, "a") as f:
            f.write(json.dumps(record) + "\n")
    except Exception as e:
        err(f"[tomat train] failed to write submission record: {e!r} (continuing)")


# ── Resume-config drift guard (spec 61, Phase 1) ───────────────────────────
#
# When a fire declares `--parent <P>` (the run it's resuming from / forking
# off), this helper diffs the proposed child config against `P`'s wandb
# config across a FROZEN_ON_RESUME set of keys. Any diff not whitelisted in
# `--allow-config-change` aborts the fire.
#
# Motivates: every fire I wrote 2026-06-19..-22 (bin5-extend-10k,
# bin5-sigma-cont x3) silently swapped TS0123 → TS0 vs. bin5's actual
# prevailing state, producing TL spikes that consumed days of TPU. The
# existing same-label resume guard didn't catch them because (a) those
# fires bypassed `tomat train` and went direct to `iris job run`, and (b)
# the sigma-cont fires used a NEW label (cont-s10), so the wandb lookup
# by-label-only returned nothing.
#
# This helper covers BOTH cases:
#   - same-label resume:   --parent P, label == P     (extends existing logic)
#   - new-label resume:    --parent P, label != P     (cont-s10-from-bin5 shape)
#
# See specs/61-resume-invariants-and-run-records.md for the full design.

# Wandb-config keys that must match parent's last segment on resume.
# Path format: dotted into the wandb config dict.
FROZEN_ON_RESUME: dict[str, str] = {
    "data.cache_dir":             "data label / shard layout",
    "optimizer.learning_rate":    "LR peak value",
    "optimizer.lr_schedule":      "LR schedule shape (constant/cosine/…)",
    "optimizer.warmup":           "warmup fraction",
    "trainer.train_batch_size":   "batch size",
    "model.hidden_size":          "model width",
    "model.num_layers":           "model depth",
    "model.num_heads":            "attention heads",
}


def _dot_get(d: dict, path: str):
    """Pull `path` (dotted) out of nested dict `d`; None if missing."""
    cur = d
    for p in path.split("."):
        if not isinstance(cur, dict) or p not in cur:
            return None
        cur = cur[p]
    return cur


def _diff_frozen_resume_config(
    parent_config: dict, child_config: dict, allow_keys: set[str],
) -> list[tuple[str, object, object]]:
    """Return list of (key, parent_value, child_value) diffs across
    FROZEN_ON_RESUME that are NOT whitelisted in allow_keys."""
    out: list[tuple[str, object, object]] = []
    for key in FROZEN_ON_RESUME:
        if key in allow_keys:
            continue
        pv, cv = _dot_get(parent_config, key), _dot_get(child_config, key)
        if pv != cv:
            out.append((key, pv, cv))
    return out


def _fetch_parent_wandb_run(parent_label: str):
    """Look up parent run by exact label match across known projects.
    Returns (run_object, config_dict) or (None, None). Errors raise."""
    import wandb as _wandb
    _api = _wandb.Api()
    exact = [r for r in match_runs(_api, parent_label) if r.name == parent_label]
    if not exact:
        return None, None
    if len(exact) > 1:
        # Ambiguous — multiple project copies. Caller may need to disambiguate
        # by data-label; for now, return the first and let the diff catch.
        # TODO: --parent-project disambiguation if this comes up in practice.
        err(f"[tomat train] --parent {parent_label!r}: {len(exact)} project copies; "
            f"using first ({exact[0].entity}/{exact[0].project}). "
            f"Pass --parent-project to disambiguate if this is wrong.")
    p = exact[0]
    return p, dict(p.config)


@cli.command("train")
@click.option("-r", "--resume", "resume_mode", is_flag=True,
              help="resume existing run (same LABEL → Levanter auto-discovers latest ckpt + continues with intact optimizer state)")
@click.option("--from-ckpt", "from_ckpt", default=None,
              help="gs:// path to a step-N ckpt dir to true-resume from under a NEW LABEL. Pre-copies the ckpt into the new run's output dir so Levanter auto-discovers it with optimizer state + step counter intact. Requires --resume.")
@click.option("--parent", "parent_label", default=None,
              help="declare the parent run this fire resumes from / forks off (spec 61). When set, the FROZEN_ON_RESUME guard fetches the parent's wandb config and refuses the fire if any of {data.cache_dir, optimizer.learning_rate/lr_schedule/warmup, trainer.train_batch_size, model.{hidden_size,num_layers,num_heads}} differs from the parent's last segment — unless the key is whitelisted in --allow-config-change. Covers the new-label resume case (cont-s10 from bin5) that the existing same-label cache_dir guard doesn't see. Caller is responsible for `--from-ckpt` if label != parent.")
@click.option("--allow-config-change", "allow_config_change", default="",
              help="comma-separated dotted keys (e.g. data.cache_dir,optimizer.learning_rate) that --parent's drift guard is allowed to skip. Use ONLY when the delta is intentional (e.g. σ ablation, schedule change). Each key in this list will be recorded in the fire's tomat.intended_resume_deltas wandb config field so the dashboard can annotate it.")
@click.option("-D", "--data-label", default="train-full-v3",
              help="TOMAT_LABEL (data subdir under tokenized/). Comma-separated values train on the UNION of components — one Levanter cache spans all shards' epoch via multi-URL `train_urls`; auto epoch-window sums component row counts; cache lands at `<bucket>/cache/<+-joined>/`.")
@click.option("-m", "--model", default="200M", help="TOMAT_MODEL preset")
@click.option("-T", "--tpu", default="v6e-16", help="iris --tpu")
@click.option("--zone", default=None, help="iris --zone (e.g. europe-west4-a); pins the slice to one zone so it doesn't end up in a starved region. Repeatable via comma-separated list.")
@click.option("--region", default=None, help="iris --region (e.g. europe-west4); broader pin than --zone.")
@click.option("-s", "--steps", required=True, type=int, help="TOMAT_STEPS")
@click.option("-b", "--batch-size", default=128, type=int, help="TOMAT_BATCH_SIZE")
@click.option("--seed", default=42, type=int, help="TOMAT_SEED")
@click.option("--lmq-path", default=None, help="TOMAT_LMQ_PATH (default = repo LMQ_PATH constant)")
@click.option("--lr", default=3e-4, type=float, help="TOMAT_LR")
@click.option("--lr-schedule", "lr_schedule", default="constant",
              help="TOMAT_LR_SCHEDULE (constant|cosine|linear|inv_sqrt)")
@click.option("--warmup", default=0.05, type=float, help="TOMAT_WARMUP fraction")
@click.option("--cooldown", default=None, type=float, help="TOMAT_COOLDOWN fraction (WSD)")
@click.option("--val-seqs", default=256, type=int, help="TOMAT_VAL_SEQS")
@click.option("--steps-per-eval", default=None, type=int, help="TOMAT_STEPS_PER_EVAL")
@click.option("--grad-ckpt/--no-grad-ckpt", default=True, help="TOMAT_GRADIENT_CHECKPOINTING (default True; pass --no-grad-ckpt to disable for MFU experiments)")
@click.option("--profile/--no-profile", default=False, help="TOMAT_PROFILE; OFF by default — each run's jax profile is ~250MB and fills the org wandb storage. Pass --profile when actually MFU-debugging.")
@click.option("--density-loss", default="emd", help="TOMAT_DENSITY_LOSS_TYPE (emd|l1)")
@click.option("--density-only/--density-add", default=True, help="TOMAT_DENSITY_ONLY_LOSS")
@click.option("--cpu", default=32, type=int, help="iris --cpu")
@click.option("--memory", default="64GB", help="iris --memory")
@click.option("--max-retries", default=20, show_default=True, type=int, help="iris --max-retries (failure budget; iris default is 0, which classifies JAX-distributed leader-preempt cascades as fatal failures. 20 buys us ~20 sibling-cascade survivals before terminal.)")
@click.option("-e", "--env", "extra_env", multiple=True, help="extra env var KEY=VAL (repeatable)")
@click.option("--shuffle-window-blocks", default="auto", show_default=True, help="TOMAT_SHUFFLE_WINDOW_BLOCKS; BlockShuffle within-window mixing radius (int or `auto`). `auto` resolves on the trainer to the full epoch width for the active data label (ceildiv(epoch_seqs, io_block_size)) — the only honest default; anything smaller leaves intra-epoch ordering memorization on the table (the kl-bin5-fs sawtooth pre-step-34k). Pass 0 to disable shuffle.")
@click.option("--shuffle-io-block-size", type=int, default=0, help="TOMAT_SHUFFLE_IO_BLOCK_SIZE; 0 = auto from meta (M)")
@click.option("--share-cache/--no-share-cache", default=True, help="Trainer reads the mirrored cache at `<bucket>/cache/<data_label>/` (default on). With TOMAT_SHARE_CACHE=1, the trainer detects its actual GCE zone at startup and picks the local-region mirror — drop `--zone` to let iris park the slice wherever has capacity. `--no-share-cache` falls back to per-run rebuild under the canonical bucket.")
@click.option("--watch-preempts/--no-watch-preempts", default=True, help="auto-fire `tomat preempts watch <LABEL>` in the background after launch (default on)")
@click.option("--pyspy/--no-pyspy", default=False, help="TOMAT_PYSPY=1 → trainer daemon-dumps py-spy stacks to GCS every TOMAT_PYSPY_INTERVAL s (default 60). Use for diagnosing host-side stalls (the 65s/step v5p issue).")
@click.option("--pyspy-interval", default=60, type=int, help="TOMAT_PYSPY_INTERVAL seconds between py-spy dumps (default 60).")
@click.option("--pyspy-record-seconds", default=0, type=int, help="TOMAT_PYSPY_RECORD_SECONDS > 0 switches from `py-spy dump` (text) to `py-spy record` (flame-graph SVG) of that length per cycle.")
@click.option("-f", "--force", is_flag=True, help="allow from-scratch overwrite of existing results dir. By itself, refuses when the run is COMPLETED (latest ckpt step ≥ --steps target) — common footgun: iris kept retrying a finished run because each clean exit counted as a failure; --force would silently wipe a 10k-step ckpt. Pass `--force-completed` to override.")
@click.option("--force-completed", "force_completed", is_flag=True, help="explicitly allow `--force` to wipe a results dir whose latest ckpt step ≥ --steps (i.e. the run is already complete). Required guard added 2026-05-30 after losing 10h v6e-16 of abs-ce-1 training to a blanket --force re-fire.")
@click.option("-d", "--dry-run", is_flag=True, help="print iris cmd without firing")
@click.option("--bucket", "bucket_override", default=None,
              help="override TOMAT_BUCKET (default = per-tpu-family region). Use when running a v5p/v6e job from a non-default region (e.g. firing v5p in us-east5 instead of us-central1). Ckpts go to <bucket>/results/.")
@click.option("--queue/--no-queue", default=False,
              help="poll iris-avail every --queue-poll seconds and submit when the target pool has READY≥1. Catches capacity churn between hourly polls. Blocks until iris accepts the job.")
@click.option("--queue-poll", default=60, type=int,
              help="seconds between iris-avail polls when --queue is set (default 60)")
@click.option("--region-strategy", "region_strategy", type=click.Choice(["any", "auto", "explicit"]), default=None,
              help="how to pick region(s) for this fire (spec 62). `any` = fire to all regions where cache is fully present, let iris pick (default for from-scratch). `auto` = probe iris-avail, pick highest-READY eligible region, pre-mirror parent ckpt there (default for --resume). `explicit` = use --zone/--region as given, no pre-flight (current behavior; required if you pass --zone). Default per mode: any (from-scratch) / auto (resume).")
@click.argument("label")
def train(
    label: str,
    resume_mode: bool,
    from_ckpt: str | None,
    parent_label: str | None,
    allow_config_change: str,
    data_label: str,
    model: str,
    tpu: str,
    zone: str | None,
    region: str | None,
    steps: int,
    batch_size: int,
    seed: int,
    lmq_path: str | None,
    lr: float,
    lr_schedule: str,
    warmup: float,
    cooldown: float | None,
    val_seqs: int,
    steps_per_eval: int | None,
    grad_ckpt: bool,
    profile: bool,
    density_loss: str,
    density_only: bool,
    cpu: int,
    memory: str,
    max_retries: int,
    extra_env: tuple[str, ...],
    shuffle_window_blocks: str,
    shuffle_io_block_size: int,
    share_cache: bool,
    watch_preempts: bool,
    pyspy: bool,
    pyspy_interval: int,
    pyspy_record_seconds: int,
    force: bool,
    force_completed: bool,
    dry_run: bool,
    bucket_override: str | None,
    queue: bool,
    queue_poll: int,
    region_strategy: str | None,
):
    """Launch (or resume) a tomat training run.

    Modes:
      from-scratch (default)   new run with LABEL; errors if results dir exists
      --resume / -r            continue existing run (same LABEL); errors if
                               no checkpoints found. Native Levanter auto-
                               discovery loads the latest ckpt + optimizer
                               state intact.

    Warm-start (model-only load, fresh optimizer) is NOT a supported mode —
    it caused the 1B cont-from-4711 spike. If you want it back, add it as
    an explicit flag with safer LR defaults.
    """
    # Local wall-clock at invocation. Captures the moment the user said "fire"
    # — used by the SubmissionRecord (spec 42 Phase A) to surface queue-wait
    # time (--queue polling, iris RPC) as a distinct segment from `_runtime`.
    invoked_at = time.time()

    # Pick a region-local bucket to avoid cross-region transfer budget
    # blowups (rigging's MARIN_MIRROR_BUDGET_GB=10 default trips at the
    # first ckpt save for a v5p job writing back to marin-eu-west4).
    # v5p lives in us-central1/us-east5; v6e-preemptible-16 currently in
    # us-east1; everything else stays on eu-west4.
    if bucket_override:
        bucket = bucket_override.rstrip("/")
        print(f"[tomat train] bucket: {bucket} (--bucket override)")
    elif tpu.startswith("v5p"):
        bucket = "gs://marin-us-central1/tomat"
    elif tpu.startswith("v5e") or tpu.startswith("v6e"):
        bucket = "gs://marin-eu-west4/tomat"
    else:
        bucket = "gs://marin-eu-west4/tomat"  # default
    if not bucket_override and bucket != GCS_BUCKET:
        print(f"[tomat train] bucket: {bucket} (tpu={tpu}; default would have been {GCS_BUCKET})")

    # --from-ckpt: pre-copy an explicit step-N ckpt into the new run's
    # output dir, so Levanter's auto-discovery picks it up as a true
    # resume (full optimizer state + step counter, NOT a warm-start).
    # The new LABEL must be fresh — we only copy if the target step-N/
    # dir doesn't already exist.
    if from_ckpt is not None:
        if not resume_mode:
            err(f"--from-ckpt requires --resume / -r")
            sys.exit(1)
        if not from_ckpt.startswith("gs://"):
            err(f"--from-ckpt must be a gs:// path, got: {from_ckpt!r}")
            sys.exit(1)
        # Parse step-N segment from the source path.
        import re as _re
        m = _re.search(r"/step-(\d+)/?$", from_ckpt.rstrip("/"))
        if not m:
            err(f"--from-ckpt path must end in /step-N/ (no trailing slash needed); got: {from_ckpt!r}")
            sys.exit(1)
        src_step = int(m.group(1))
        src = from_ckpt.rstrip("/")
        target = f"{bucket}/results/{label}/checkpoints/{label}/step-{src_step}"
        # Idempotent: skip copy if target already exists.
        check = subprocess.run(["gsutil", "ls", target + "/"], capture_output=True, text=True)
        if check.returncode == 0:
            print(f"[tomat train] --from-ckpt: target {target}/ already exists, skipping copy")
        elif dry_run:
            print(f"[tomat train] --from-ckpt: [dry-run] would copy {src}/ → {target}/")
        else:
            print(f"[tomat train] --from-ckpt: copying {src}/ → {target}/ …")
            cp = subprocess.run(["gsutil", "-m", "cp", "-r", src, target.rsplit("/", 1)[0] + "/"],
                                capture_output=False, text=True)
            if cp.returncode != 0:
                err(f"--from-ckpt: gsutil cp failed (rc={cp.returncode})")
                sys.exit(cp.returncode)
            print(f"[tomat train] --from-ckpt: copy complete")

    latest = _latest_ckpt_step(label, bucket=bucket)
    if resume_mode:
        if latest is None:
            err(f"--resume {label}: no step-* ckpts under "
                f"{bucket}/results/{label}/checkpoints/{label}/")
            sys.exit(1)
        # Levanter convention: a `step-N` ckpt represents step index N *just
        # completed* (0-indexed), so N+1 update steps have actually run. A run
        # invoked with `num_train_steps=S` produces a final `step-(S-1)` ckpt,
        # not `step-S`. Surface that explicitly + short-circuit no-op resumes.
        completed = latest + 1
        if completed >= steps:
            print(f"[tomat train] resume {label!r}: already complete "
                  f"(step-{latest} = {completed}/{steps} steps; "
                  f"`step-N` = N+1 completed). Pass --steps > {completed} to extend.")
            sys.exit(0)
        print(f"[tomat train] resume mode: latest ckpt step-{latest} "
              f"(= {completed}/{steps} steps completed) → continuing")
    else:
        if latest is not None and not force:
            err(f"results dir for {label!r} already has step-{latest} ckpt at {bucket}; "
                f"use --resume to continue, or --force to overwrite")
            sys.exit(1)
        if latest is not None and force and (latest + 1) >= steps and not force_completed:
            err(f"refusing --force on {label!r}: run is already COMPLETED "
                f"(step-{latest} → {latest + 1} steps done, target {steps}). "
                f"Wiping a finished run loses ckpt + retraining cost. "
                f"If you really want to redo it from scratch, pass "
                f"--force-completed. If iris was retrying after completion "
                f"(clean-exit cycles inflating the failure count), cancel "
                f"the job instead: `tomat iris cancel {label}`.")
            sys.exit(1)

    wandb_key = os.environ.get("WANDB_API_KEY", "<WANDB_API_KEY>")
    if not dry_run and wandb_key == "<WANDB_API_KEY>":
        err("WANDB_API_KEY not set in env")
        sys.exit(1)

    # ── --parent: FROZEN_ON_RESUME drift guard (spec 61) ──────────────────
    # Covers the new-label-resume case (cont-s10 from bin5) that the existing
    # same-label cache_dir guard further down doesn't see. When the user
    # declares `--parent P`, we pull P's wandb config and refuse the fire if
    # any FROZEN_ON_RESUME key differs unless explicitly allowed.
    parent_run_obj = None
    intended_deltas: list[str] = []
    if parent_label:
        allow_keys = {k.strip() for k in (allow_config_change or "").split(",") if k.strip()}
        unknown = allow_keys - set(FROZEN_ON_RESUME.keys())
        if unknown:
            err(f"[tomat train] --allow-config-change includes unknown keys: "
                f"{sorted(unknown)}. valid keys: {sorted(FROZEN_ON_RESUME)}")
            sys.exit(2)
        parent_run_obj, parent_cfg = _fetch_parent_wandb_run(parent_label)
        if parent_run_obj is None:
            err(f"[tomat train] --parent {parent_label!r}: no wandb run found "
                f"(searched: {', '.join(WANDB_PROJECTS)}). check spelling, "
                f"or pass `--parent <other-label>`.")
            sys.exit(1)
        # Build the child config in wandb-shape. Only fill keys the child
        # CLI actually pins; absent keys (e.g. model size — model preset
        # → dims map not wired here yet) skip the diff with a TODO.
        # cache_dir uses the +-joined subdir convention (see existing guard).
        child_subdir = (data_label or "").replace(",", "+")
        # Match the existing guard's "subdir name, not full path" comparison
        # — strip the bucket+`/cache/` prefix from parent's cache_dir.
        parent_cache_dir = _dot_get(parent_cfg, "data.cache_dir") or ""
        import re as _re
        _pm = _re.search(r"/cache/([^/]+)/?$", parent_cache_dir.rstrip("/"))
        parent_subdir = _pm.group(1) if _pm else ""
        # Build wandb-shape child config for the diff. (Only includes
        # FROZEN_ON_RESUME keys we can resolve from CLI args; model.* is
        # skipped until the preset-to-dims map lands.)
        child_cfg = {
            "data": {"cache_dir": child_subdir},
            "optimizer": {
                "learning_rate": lr,
                "lr_schedule": lr_schedule,
                "warmup": warmup,
            },
            "trainer": {"train_batch_size": batch_size},
        }
        # Same-shape view of parent for clean diff.
        parent_view = {
            "data": {"cache_dir": parent_subdir},
            "optimizer": {
                "learning_rate": _dot_get(parent_cfg, "optimizer.learning_rate"),
                "lr_schedule":   _dot_get(parent_cfg, "optimizer.lr_schedule"),
                "warmup":        _dot_get(parent_cfg, "optimizer.warmup"),
            },
            "trainer": {"train_batch_size": _dot_get(parent_cfg, "trainer.train_batch_size")},
        }
        # Union-widening exception for cache_dir (mirrors the existing
        # same-label guard's logic): child label may be a comma-joined
        # multi-label that *includes* parent's subdir as one component.
        if "data.cache_dir" not in allow_keys:
            new_parts = [p.strip() for p in (data_label or "").split(",") if p.strip()]
            if len(new_parts) > 1 and parent_subdir in new_parts:
                # Effectively a no-op delta for the diff machinery.
                child_cfg["data"]["cache_dir"] = parent_subdir
                print(f"[tomat train] --parent {parent_label!r}: union widening — "
                      f"parent subdir {parent_subdir!r} is part of {data_label!r}")
        diffs = _diff_frozen_resume_config(parent_view, child_cfg, allow_keys)
        if diffs:
            err(f"[tomat train] --parent {parent_label!r}: refusing fire — "
                f"FROZEN_ON_RESUME drift detected ({len(diffs)} key(s)):")
            for key, pv, cv in diffs:
                err(f"  {key}  ({FROZEN_ON_RESUME[key]})")
                err(f"    parent: {pv!r}")
                err(f"    child:  {cv!r}")
            err("")
            err("to override (each delta will be recorded in tomat.intended_resume_deltas):")
            err(f"  --allow-config-change={','.join(k for k, _, _ in diffs)}")
            sys.exit(2)
        # Track which keys the user opted into drifting — for trainer to log.
        intended_deltas = sorted(allow_keys)
        print(f"[tomat train] --parent {parent_label!r}: FROZEN_ON_RESUME guard passed "
              f"(intended deltas: {intended_deltas or 'none'})")

    # ── P1.warmup default: TOMAT_WARMUP=0 on --resume (spec 61) ───────────
    # bin5 resume question: warmup is global-step-indexed (verified in
    # Levanter optim/config.py), so at step-100k the 5%-of-105k warmup is
    # long past — `warmup=0.05` and `warmup=0` are equivalent at the resume
    # boundary. But making the intent explicit at CLI time prevents future
    # confusion (and protects fresh-on-resume cases where step-0 of THIS
    # fire happens to land inside the absolute warmup window).
    if resume_mode and warmup != 0.0:
        # If user explicitly passed --warmup, respect them. We detect this
        # by checking if the click context shows the value came from default.
        ctx = click.get_current_context()
        warmup_was_explicit = ctx.get_parameter_source("warmup") != click.core.ParameterSource.DEFAULT
        if not warmup_was_explicit:
            print(f"[tomat train] --resume: defaulting --warmup to 0 (was {warmup}; "
                  f"pass --warmup explicitly to override)")
            warmup = 0.0

    # For --resume, auto-detect the existing run's wandb entity AND verify
    # the user-passed `--data-label` matches the existing run's cache_dir.
    # The trainer (marin/train_tomat_tpu.py) derives wandb project from
    # `meta.density_codec_name + meta.patch_size` of whatever cache it
    # opens — so a mismatched data_label silently routes the resume to
    # the wrong wandb project AND trains on incompatible t10n (effectively
    # random init). See cont7k-ext postmortem (P19 trainer mis-resumed as
    # P14 on 2026-05-15, producing tainted ckpts step-34000..79999).
    wandb_entity = "open-athena"
    if resume_mode:
        try:
            import wandb as _wandb
            _api = _wandb.Api()
            exact = [r for r in match_runs(_api, label) if r.name == label]
            if not exact and from_ckpt is not None:
                # --from-ckpt creates a new wandb run with this label;
                # the trainer will pick project from cache meta. Skip
                # cache_dir verification since there's nothing to compare.
                print(f"[tomat train] resume {label!r}: no existing wandb run "
                      f"(expected — --from-ckpt mode); trainer will create new run")
                exact = []  # signal: skip the rest of the validation block
            if not exact and from_ckpt is None:
                err(f"[tomat train] resume {label!r}: no matching wandb run found "
                    f"(searched: {', '.join(WANDB_PROJECTS)})")
                sys.exit(1)
            if len(exact) > 1:
                # Multiple project copies — pick the one whose cache_dir matches
                # the user's --data-label, else error and require disambiguation.
                expected_cache = f"gs://marin-eu-west4/tomat/cache/{data_label}/"
                matching = [r for r in exact if (r.config.get("data") or {}).get("cache_dir") == expected_cache]
                if len(matching) != 1:
                    err(f"[tomat train] resume {label!r}: {len(exact)} project copies; "
                        f"{len(matching)} match --data-label={data_label!r} (cache {expected_cache!r}):")
                    for r in exact:
                        err(f"  {r.entity}/{r.project}: cache_dir={(r.config.get('data') or {}).get('cache_dir')!r}")
                    sys.exit(1)
                exact = matching
            if exact:
                existing = exact[0]
                wandb_entity = existing.entity
                existing_cache = (existing.config.get("data") or {}).get("cache_dir") or ""
                # Compare the cache *subdir name* (after /cache/), not the full
                # gs:// path — same cache is mirrored across region buckets
                # (eu-west4, us-east5, us-central1) and `--share-cache` picks
                # the local mirror at runtime. What matters for t10n
                # compatibility is the subdir name.
                import re as _re
                m = _re.search(r"/cache/([^/]+)/?$", existing_cache.rstrip("/"))
                existing_subdir = m.group(1) if m else ""
                # Union-widening exception: if `data_label` is a comma-joined
                # multi-label (TS0-3 union etc.) AND the existing single-label
                # subdir is one of the new union's components, this is a
                # deliberate curriculum change — let it through with a warning.
                # (The trainer's per-component meta consistency check will
                # still catch any actual t10n incompatibility.)
                new_parts = [p.strip() for p in data_label.split(",") if p.strip()]
                _union_widening = (len(new_parts) > 1 and existing_subdir in new_parts)
                # Cache subdir uses `+`-join (per `train_tomat_tpu.py:label_for_path
                # = label.replace(",", "+")`), but `--data-label` is the comma-joined
                # form the trainer's `_label_parts(...)` expects. Normalize both to
                # `+`-form before comparing so the validator doesn't false-positive
                # on cosmetic separator-mismatch (and so passing `+`-form here
                # doesn't accidentally pass through to TOMAT_LABEL — which would
                # break `_label_parts` and FileNotFound on a single combined dir).
                expected_subdir = data_label.replace(",", "+")
                if existing_subdir and existing_subdir != expected_subdir and not _union_widening:
                    err(f"[tomat train] resume {label!r}: --data-label mismatch.")
                    err(f"  existing wandb run ({existing.entity}/{existing.project}) "
                        f"cache_dir = {existing_cache!r}")
                    err(f"  --data-label={data_label!r} (subdir {expected_subdir!r}) "
                        f"!= existing subdir {existing_subdir!r}")
                    err(f"  resuming with a mismatched cache would silently re-route to "
                        f"a different wandb project and train on incompatible t10n.")
                    err(f"  pass --data-label={existing_subdir.replace('+', ',')}")
                    sys.exit(2)
                if _union_widening:
                    print(f"[tomat train] resume {label!r}: union widening — "
                          f"existing subdir {existing_subdir!r} is part of "
                          f"--data-label={data_label!r} ({len(new_parts)} components). "
                          f"Cache will be rebuilt at /cache/{data_label.replace(',', '+')}/.")
                print(f"[tomat train] resume target: {existing.entity}/{existing.project}/{label}")
                print(f"[tomat train]   cache subdir verified: {existing_subdir} (existing: {existing_cache})")
                if wandb_entity != "open-athena":
                    print(f"[tomat train]   passing TOMAT_WANDB_ENTITY={wandb_entity}")
        except SystemExit:
            raise
        except Exception as e:
            err(f"[tomat train] warning: couldn't resolve resume target for {label!r}: {e}")

    # Bucket-relative LMQ codec path: assume the codec was mirrored into
    # the same prefix under the target bucket (e.g. via
    # `gsutil cp gs://marin-eu-west4/tomat/codecs/* gs://marin-us-central1/tomat/codecs/`).
    default_lmq_path = f"{bucket}/codecs/lmq-v2-16k.npz"
    env_vars: list[tuple[str, str]] = [
        ("WANDB_API_KEY", wandb_key),
        ("TOMAT_WANDB_ENTITY", wandb_entity),
        ("TOMAT_BUCKET", bucket),
        ("TOMAT_LABEL", data_label),
        ("TOMAT_RESULTS_LABEL", label),
        ("TOMAT_MODEL", model),
        ("TOMAT_STEPS", str(steps)),
        ("TOMAT_BATCH_SIZE", str(batch_size)),
        ("TOMAT_SEED", str(seed)),
        ("TOMAT_LMQ_PATH", lmq_path or default_lmq_path),
        ("TOMAT_DENSITY_LOSS_TYPE", density_loss),
        ("TOMAT_DENSITY_ONLY_LOSS", "1" if density_only else "0"),
        ("TOMAT_LR", str(lr)),
        ("TOMAT_LR_SCHEDULE", lr_schedule),
        ("TOMAT_WARMUP", str(warmup)),
        ("TOMAT_VAL_SEQS", str(val_seqs)),
        ("TOMAT_PROFILE", "1" if profile else "0"),
    ]
    if cooldown is not None:
        env_vars.append(("TOMAT_COOLDOWN", str(cooldown)))
    if steps_per_eval is not None:
        env_vars.append(("TOMAT_STEPS_PER_EVAL", str(steps_per_eval)))
    env_vars.append(("TOMAT_GRADIENT_CHECKPOINTING", "1" if grad_ckpt else "0"))
    # Hard-fail on missing-ckpt when a resume is intended. Without this, Levanter
    # silently falls back to fresh-init if the ckpt path is wrong or unreadable,
    # so the run quietly starts at step 0. Trainer-side: `train_tomat_tpu.py`
    # gates `discover_latest_checkpoint(...) is None` on this env var.
    if resume_mode or from_ckpt is not None:
        env_vars.append(("TOMAT_REQUIRE_RESUME", "1"))
    # spec 61: thread parent lineage + intended deltas into the fire's env
    # so the trainer can log them to wandb config (when task #269 lands;
    # for now, they at least appear in `iris job describe` env-vars and
    # in the submission record `fire_argv`).
    if parent_label:
        env_vars.append(("TOMAT_PARENT_RUN_ID", parent_label))
    if intended_deltas:
        env_vars.append(("TOMAT_INTENDED_RESUME_DELTAS", ",".join(intended_deltas)))
    # Always emit — shuffle is on by default; `--shuffle-window-blocks 0` is
    # the explicit opt-out and `auto` (default) defers epoch-window resolution
    # to the trainer (`marin/train_tomat_tpu.py:_epoch_window_blocks`).
    env_vars.append(("TOMAT_SHUFFLE_WINDOW_BLOCKS", str(shuffle_window_blocks)))
    if shuffle_io_block_size > 0:
        env_vars.append(("TOMAT_SHUFFLE_IO_BLOCK_SIZE", str(shuffle_io_block_size)))
    if share_cache:
        # Trainer detects its actual GCE region at startup and picks the
        # matching mirror — no submit-time bucket pinning needed.
        env_vars.append(("TOMAT_SHARE_CACHE", "1"))
    if pyspy:
        env_vars.append(("TOMAT_PYSPY", "1"))
        env_vars.append(("TOMAT_PYSPY_INTERVAL", str(pyspy_interval)))
        if pyspy_record_seconds > 0:
            env_vars.append(("TOMAT_PYSPY_RECORD_SECONDS", str(pyspy_record_seconds)))
    for kv in extra_env:
        if "=" not in kv:
            err(f"--env {kv!r}: expected KEY=VAL")
            sys.exit(1)
        k, v = kv.split("=", 1)
        env_vars.append((k, v))

    # Resolve region-strategy (spec 62) and pre-flight. May mutate `region`
    # / `zone` to reflect the picked / eligible regions; populates
    # `region_info` for the fire manifest. Idempotent w.r.t. existing data
    # mirrors (pre-flight skips if cache/ckpt already present in the target).
    region_info = _resolve_region_strategy(
        region_strategy=region_strategy,
        resume_mode=resume_mode,
        data_labels=[s.strip() for s in data_label.split(",") if s.strip()],
        tpu=tpu,
        zone=zone, region=region,
        parent_label=parent_label, label=label,
    )
    if region_info["region_picked"] is not None:
        # `auto` mode: single picked region overrides anything the user passed.
        region = region_info["region_picked"]
        zone = None
    elif region_info["region_eligible"]:
        # `any` mode: pass all eligible regions.
        region = ",".join(region_info["region_eligible"])
        zone = None
    # `explicit` mode: leave `region` / `zone` as passed in by the caller.

    cmd = [
        IRIS_BIN, "--cluster=marin", "job", "run",
        "--tpu", tpu, "--enable-extra-resources", "--priority", "interactive",
        "--cpu", str(cpu), "--memory", memory,
        "--max-retries", str(max_retries),
    ]
    for z in (zone or "").split(","):
        if z := z.strip():
            cmd += ["--zone", z]
    for r in (region or "").split(","):
        if r := r.strip():
            cmd += ["--region", r]
    for k, v in env_vars:
        cmd += ["--env-vars", k, v]
    cmd += [
        "--no-wait", "--no-terminate-on-exit",
        "--job-name", label,
        "--", "python", "train_tomat_tpu.py",
    ]

    if dry_run:
        pretty = " ".join(
            "'<WANDB_API_KEY>'" if a == wandb_key else a for a in cmd
        )
        print(f"# {label} ({'resume' if resume_mode else 'from-scratch'})")
        print(f"  cd {MARIN_DIR}")
        print(f"  {pretty}")
        return

    def _try_iris_launch():
        return subprocess.run(cmd, cwd=str(MARIN_DIR), capture_output=True, text=True)

    if queue:
        # Build the expected pool name for capacity probing. Pools are named
        # `tpu_<variant>-<zone>` (e.g. `tpu_v5p-preemptible_16-us-central1-a`).
        # If --zone is unset we accept any zone for this variant.
        target_zones = [z.strip() for z in (zone or "").split(",") if z.strip()]
        if not target_zones:
            print(f"[tomat train --queue] no --zone pin; will accept any zone for {tpu}")
        else:
            print(f"[tomat train --queue] target pool(s): "
                  + ", ".join(f"tpu_{tpu}-{z}" for z in target_zones))
        print(f"[tomat train --queue] poll interval: {queue_poll}s")
        attempt = 0
        t_start = time.time()
        while True:
            attempt += 1
            # Probe iris-avail-as-json to check whether the target pool has
            # READY≥1 before bothering iris's scheduler.
            probe = subprocess.run(
                [IRIS_BIN, "--cluster=marin", "rpc", "controller", "get-autoscaler-status"],
                cwd=str(MARIN_DIR), capture_output=True, text=True, timeout=90,
            )
            ready_pools: list[tuple[str, int]] = []
            # Pool names have allocation-class infix: `tpu_<chip>-<class>_<size>-<zone>`
            # (e.g. `tpu_v6e-preemptible_16-europe-west4-a`,
            # `tpu_v5e-serving_4-europe-west4-b`). Our `--tpu` arg is the
            # short form `<chip>-<size>` (e.g. `v6e-16`); iris matches it
            # against whatever allocation class is provisioned. Build a
            # regex anchored on `<chip>-\w+_<size>-` to capture all classes
            # without enumerating them. Past mistake: substring-matching
            # `f"tpu_{tpu}-"` never hits because of the infix — wasted ~45min
            # of queue polling on tz-11 before catching it.
            try:
                chip, size = tpu.rsplit("-", 1)
            except ValueError:
                chip, size = tpu, ""
            pool_re = re.compile(
                rf"^tpu_{re.escape(chip)}-\w+_{re.escape(size)}-(.+)$"
            )
            if probe.returncode == 0:
                try:
                    data = json.loads(strip_iris_log(probe.stdout).strip())
                    for p in _walk_pools(data):
                        if p["status"] != "available" or p["ready"] <= 0:
                            continue
                        name = p["name"]
                        m = pool_re.match(name)
                        if not m:
                            continue
                        pool_zone = m.group(1)
                        if target_zones and pool_zone not in target_zones:
                            continue
                        ready_pools.append((name, p["ready"]))
                except Exception as e:
                    err(f"[tomat train --queue] avail parse failed: {e}")
            elif probe.returncode == 124 or (probe.stderr and "timed out" in probe.stderr.lower()):
                err(f"[tomat train --queue] attempt {attempt}: iris-avail timed out, retrying")
                time.sleep(queue_poll)
                continue
            elapsed = int(time.time() - t_start)
            if not ready_pools:
                if attempt == 1 or attempt % 10 == 0:
                    err(f"[tomat train --queue] attempt {attempt} ({elapsed//60}m{elapsed%60}s): "
                        f"no matching pool with READY≥1; sleeping {queue_poll}s")
                time.sleep(queue_poll)
                continue
            # Found a pool. Try iris launch immediately.
            best = max(ready_pools, key=lambda x: x[1])
            err(f"[tomat train --queue] attempt {attempt} ({elapsed//60}m{elapsed%60}s): "
                f"pool {best[0]} has READY={best[1]} — firing iris job")
            r = _try_iris_launch()
            if r.returncode == 0:
                break
            tail = (r.stderr or "")[-300:]
            err(f"[tomat train --queue] iris rejected (rc={r.returncode}): {tail[-120:]}")
            err(f"[tomat train --queue] capacity probably claimed in the gap; retrying in {queue_poll}s")
            time.sleep(queue_poll)
    else:
        r = _try_iris_launch()
        if r.returncode != 0:
            err(f"[FAIL launch {label}] rc={r.returncode}\n{r.stderr[-1000:]}")
            sys.exit(r.returncode)
    iris_accepted_at = time.time()
    _write_submission_record(
        label=label,
        tpu=tpu,
        cmd=cmd,
        invoked_at=invoked_at,
        accepted_at=iris_accepted_at,
        mode="resume" if resume_mode else "from-scratch",
    )
    # Record this fire to R2 (spec 61 §2.1). Failure is non-fatal — the fire
    # is already submitted; we don't want a flaky R2 PUT to break the
    # post-submit pipeline. Resume from-step: prefer the parent's `latest`
    # ckpt step the trainer auto-discovered (we only have it for same-label
    # resumes; cross-label `--parent` discovery needs a manifest read which
    # we punt on here).
    try:
        _record_train_fire_to_r2(
            label=label, parent_label=parent_label,
            tpu=tpu, zone=zone, steps=steps,
            from_step=latest if resume_mode else None,
            region_info=region_info,
        )
    except Exception as e:
        err(f"[tomat train] failed to record fire to R2: {e!r} (continuing)")
    print(f"[launched {label} on {tpu}, {steps} steps"
          f"{f' (resume from step-{latest})' if resume_mode else ''}]")
    print(f"  wandb: https://wandb.ai/{WANDB_PROJECT}/runs/{label}")

    if watch_preempts:
        # Background-fire `tomat preempts watch <label>` so the wandb run
        # carries cluster/preemptions + cluster/preempts_delta from the
        # start. Per-run log file lives at tmp/preempts-<label>.log.
        Path("tmp").mkdir(exist_ok=True)
        watch_log = Path("tmp") / f"preempts-{label}.log"
        watch_proc = subprocess.Popen(
            [str(Path(__file__).resolve()), "preempts", "watch", label],
            stdout=open(watch_log, "ab"),
            stderr=subprocess.STDOUT,
            start_new_session=True,
        )
        print(f"[preempts watch pid={watch_proc.pid} log={watch_log}]")


