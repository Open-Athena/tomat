@cli.group("viz")
def viz_grp():
    """Voxel-level visualization primitives (joint hists, per-mat plots)."""


_GCS_BUCKET_DEFAULT = "gs://marin-eu-west4/tomat"


def _viz_parse_source(spec: str, bucket: str) -> tuple[str, str, str]:
    """Parse a `--x` / `--y` source spec into (label, gcs_prefix, kind).

    `gcs_prefix` is everything up to (but not including) the `<mp>.zarr/`
    suffix; per-mat URLs are built as `f"{gcs_prefix}/{mp}.zarr"`.

    Grammar:
      gt:<split>                            → rho_gga_v3mr/<split>/
      pred:<run>:<setmode>:<step>           → eval/predictions/<run>/<setmode>/step-<step>/
    """
    parts = spec.split(":")
    if not parts:
        raise click.BadParameter(f"empty source spec: {spec!r}")
    kind = parts[0]
    if kind == "gt":
        if len(parts) != 2:
            raise click.BadParameter(
                f"gt source must be `gt:<split>` (e.g. `gt:val`, `gt:train`); got {spec!r}")
        split = parts[1]
        # accept short aliases
        split_map = {"val": "validation", "validation": "validation",
                     "train": "train", "training": "train"}
        if split not in split_map:
            raise click.BadParameter(
                f"unknown gt split {split!r}; expected one of {sorted(split_map)}")
        full = split_map[split]
        return (f"gt:{split}", f"{bucket}/rho_gga_v3mr/{full}", "gt")
    if kind == "pred":
        if len(parts) != 4:
            raise click.BadParameter(
                f"pred source must be `pred:<run>:<setmode>:<step>`; got {spec!r}")
        _, run, setmode, step = parts
        try:
            step_i = int(step)
        except ValueError:
            raise click.BadParameter(f"pred step must be an int; got {step!r}")
        label = f"pred:{run}:{setmode}:{step_i}"
        prefix = f"{bucket}/eval/predictions/{run}/{setmode}/step-{step_i}"
        return (label, prefix, "pred")
    raise click.BadParameter(
        f"unknown source kind {kind!r} in {spec!r}; expected `gt` or `pred`")


# Short-name extraction now delegates to `marin.run_names`, which loads the
# vetted registry at `runs/registry.json` and falls back to a regex (mirrors
# the prior inline regex here) for uncurated runs. Local regex helpers stay
# below as a last-resort fallback if the marin module fails to import.
_VIZ_RUN_SHORTNAME_RE = re.compile(r"train-mg-(?:kl-)?([a-z0-9]+(?:-[a-z0-9]+)?)-")


def _viz_short_step(step_idx: int) -> str:
    """Format a 0-based `step_idx` compactly: 30000→`30k`, 89999→`90k`, 1500000→`1.5M`.

    `step_idx` is a Levanter `info.step` value (lifted from a GCS
    `step-{step_idx}` checkpoint name). See `docs/step-conventions.md`.
    """
    try:
        from marin.run_names import shorten_step
        return shorten_step(step_idx)
    except Exception:
        pass
    if step_idx >= 10**6:
        v = step_idx / 1e6
        return f"{v:.1f}M" if v < 10 else f"{round(v)}M"
    if step_idx >= 1000:
        return f"{round(step_idx / 1000)}k"
    return str(step_idx)


def _viz_short_run(run: str) -> str:
    """Extract a short label for a run name (e.g. `train-mg-kl-bin5-fs-tpu` → `bin5`).

    Consults `marin.run_names.shorten_run`, which checks the curated registry
    first and falls back to the same regex used here as a final layer of
    safety for uncurated runs.
    """
    try:
        from marin.run_names import shorten_run
        return shorten_run(run)
    except Exception:
        pass
    m = _VIZ_RUN_SHORTNAME_RE.match(run)
    if m:
        return m.group(1)
    # generic mg-* style fallback: `train-mg-<tag>-…` or `train-<tag>-…`
    m = re.match(r"train-(?:mg-)?([a-z0-9]+(?:-[a-z0-9]+)?)-", run)
    if m:
        return m.group(1)
    return run


def _viz_setmode_split(setmode: str) -> str | None:
    """Return `val` or `train` (or None if unknown) given a setmode like `val_200-maskgit`."""
    s = setmode.lower()
    if s.startswith("val"):
        return "val"
    if s.startswith("train"):
        return "train"
    return None


def _viz_short_name(spec: str) -> tuple[str, str | None]:
    """Map a source spec to (short_label, split) where split ∈ {`val`,`train`,None}."""
    parts = spec.split(":")
    if not parts:
        return spec, None
    if parts[0] == "gt" and len(parts) == 2:
        split = parts[1]
        s = "val" if split.startswith("val") else ("train" if split.startswith("train") else split)
        return f"GT ({s})", s
    if parts[0] == "pred" and len(parts) == 4:
        _, run, setmode, step = parts
        # `step` is a stringified 0-based `step_idx` (Levanter `info.step`);
        # see `docs/step-conventions.md`.
        try:
            step_idx = int(step)
        except ValueError:
            step_idx = 0
        return f"{_viz_short_run(run)} @ {_viz_short_step(step_idx)}", _viz_setmode_split(setmode)
    return spec, None


def _viz_load_l0(gs_url: str) -> "np.ndarray":
    """Load the level-0 (full-res) array from a v3 multires zarr at `gs_url`.

    `gs_url` is the zarr root (`.../<mp>.zarr`). Returns a 3D float32 array.
    """
    import numpy as np
    import zarr
    store = zarr.storage.FsspecStore.from_url(gs_url, read_only=True)
    g = zarr.open_group(store=store, mode="r", use_consolidated=False)
    return np.asarray(g["0"][:]).astype(np.float32, copy=False)


def _viz_fetch_mat_pair(
    mp: str,
    x_prefix: str,
    y_prefix: str,
) -> tuple[str, "np.ndarray | None", "np.ndarray | None", str | None]:
    """Fetch (x, y) voxel arrays for `mp`. Returns (mp, x, y, err)."""
    try:
        x = _viz_load_l0(f"{x_prefix}/{mp}.zarr")
    except Exception as e:
        return mp, None, None, f"x: {type(e).__name__}: {e}"
    try:
        y = _viz_load_l0(f"{y_prefix}/{mp}.zarr")
    except Exception as e:
        return mp, x, None, f"y: {type(e).__name__}: {e}"
    if x.shape != y.shape:
        return mp, x, y, f"shape mismatch: x={x.shape} y={y.shape}"
    return mp, x, y, None


@viz_grp.command("joint-hist")
@click.option("--mat", "mat_one", default=None,
              help="single MP id (e.g. `mp-1797712`). Mutually exclusive with --mats.")
@click.option("--mats", "mats_csv", default=None,
              help="comma-sep list of MP ids. Mutually exclusive with --mat.")
@click.option("-x", "--x", "x_spec", required=True,
              help="x-axis source: `gt:val`, `gt:train`, or `pred:<run>:<setmode>:<step>`")
@click.option("-y", "--y", "y_spec", required=True,
              help="y-axis source: same grammar as --x")
@click.option("-n", "--bins", type=int, default=1024, show_default=True,
              help="number of bins per axis (square histogram)")
@click.option("--bin-scale", type=click.Choice(["log", "linear"]), default="log",
              show_default=True,
              help="bin edge spacing in density-space")
@click.option("--vmin", type=float, default=None,
              help="density-range lower clip (default: auto from data; log-scale clips at max(p0.1, 1e-3))")
@click.option("--vmax", type=float, default=None,
              help="density-range upper clip (default: auto from data — p99.99)")
@click.option("-D", "--no-diagonal", "no_diagonal", is_flag=True,
              help="skip drawing the y=x line")
@click.option("-t", "--title", default=None, help="override auto-generated plot title")
@click.option("--tol", type=float, default=0.10, show_default=True,
              help="on-diagonal tolerance for the title summary stat (|y/x - 1| <= tol)")
@click.option("-w", "--workers", type=int, default=8, show_default=True,
              help="ThreadPoolExecutor worker count for parallel mat fetches")
@click.option("--bucket", default=_GCS_BUCKET_DEFAULT, show_default=True,
              help="GCS bucket prefix (use `gs://marin-us-east5/tomat` for runs in that region)")
@click.option("-o", "--out", default=None,
              help="output PNG path (default: `tmp/joint-hist-<sha8>.png`, deterministic in args)")
def viz_joint_hist(
    mat_one: str | None,
    mats_csv: str | None,
    x_spec: str,
    y_spec: str,
    bins: int,
    bin_scale: str,
    vmin: float | None,
    vmax: float | None,
    no_diagonal: bool,
    title: str | None,
    tol: float,
    workers: int,
    bucket: str,
    out: str | None,
):
    """2D joint-histogram heatmap of (x-source, y-source) voxel densities.

    \b
    Examples:
      tomat viz joint-hist --mat mp-1797712 \\
          -x gt:val \\
          -y pred:train-mg-kl-bin5-fs-tpu:val_200-maskgit:30000

      tomat viz joint-hist --mats mp-1,mp-2,mp-3 \\
          -x pred:RUN:val_200-maskgit:30000 \\
          -y pred:RUN:val_200-maskgit:89999

    Both axes can be `pred` sources for pred-vs-pred analysis; the
    diagonal (y=x) is drawn by default so perfect agreement is on it.
    """
    import hashlib
    import numpy as np
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    from matplotlib.colors import LogNorm

    if (mat_one is None) == (mats_csv is None):
        raise click.UsageError("exactly one of --mat or --mats must be set")
    if mat_one is not None:
        mats = [mat_one]
    else:
        mats = [m.strip() for m in mats_csv.split(",") if m.strip()]
    if not mats:
        raise click.UsageError("no MP ids parsed from --mats")

    x_label, x_prefix, x_kind = _viz_parse_source(x_spec, bucket)
    y_label, y_prefix, y_kind = _viz_parse_source(y_spec, bucket)
    x_short, x_split = _viz_short_name(x_spec)
    y_short, y_split = _viz_short_name(y_spec)

    if out is None:
        sig = "|".join([
            ",".join(sorted(mats)), x_spec, y_spec, str(bins), bin_scale,
            f"{vmin}", f"{vmax}", str(no_diagonal), f"{tol}", bucket,
        ])
        sha8 = hashlib.sha256(sig.encode()).hexdigest()[:8]
        out = f"tmp/joint-hist-{sha8}.png"
    out_path = Path(out)
    out_path.parent.mkdir(parents=True, exist_ok=True)

    err(f"[joint-hist] mats={len(mats)}, x={x_label}, y={y_label}, bins={bins}, "
        f"bin-scale={bin_scale}, out={out_path}")

    xs: list[np.ndarray] = []
    ys: list[np.ndarray] = []
    fetched: list[str] = []
    failed: list[tuple[str, str]] = []
    shapes: list[tuple[int, ...]] = []
    with ThreadPoolExecutor(max_workers=max(1, workers)) as ex:
        futs = [ex.submit(_viz_fetch_mat_pair, mp, x_prefix, y_prefix) for mp in mats]
        for f in as_completed(futs):
            mp, x, y, e = f.result()
            if e is not None:
                err(f"[joint-hist] {mp}: FAIL ({e})")
                failed.append((mp, e))
                continue
            xs.append(x.ravel())
            ys.append(y.ravel())
            fetched.append(mp)
            shapes.append(tuple(x.shape))
            err(f"[joint-hist] {mp}: shape={x.shape} "
                f"x:[{x.min():.3g},{x.max():.3g}] y:[{y.min():.3g},{y.max():.3g}]")
    if not xs:
        raise click.ClickException(f"no mats loaded successfully; failures: {failed}")

    x_all = np.concatenate(xs)
    y_all = np.concatenate(ys)
    del xs, ys
    err(f"[joint-hist] stacked: {x_all.size:,} voxels across {len(fetched)} mats")

    # Auto bin range from the union of x and y, with sensible log-scale floor.
    combined = np.concatenate([x_all, y_all])
    if vmin is None:
        if bin_scale == "log":
            p_lo = float(np.percentile(combined, 0.1))
            vmin = max(p_lo, 1e-3)
        else:
            vmin = float(combined.min())
    if vmax is None:
        vmax = float(np.percentile(combined, 99.99))
    if not (vmax > vmin):
        raise click.ClickException(f"degenerate range: vmin={vmin}, vmax={vmax}")
    del combined

    if bin_scale == "log":
        edges = np.logspace(np.log10(vmin), np.log10(vmax), bins + 1)
        x_clip = np.clip(x_all, vmin, vmax)
        y_clip = np.clip(y_all, vmin, vmax)
    else:
        edges = np.linspace(vmin, vmax, bins + 1)
        x_clip = np.clip(x_all, vmin, vmax)
        y_clip = np.clip(y_all, vmin, vmax)

    H, xe, ye = np.histogram2d(x_clip, y_clip, bins=[edges, edges])
    # Mass-on-diagonal stat: |y/x - 1| <= tol, on the unclipped data
    # (avoid divide-by-zero by masking tiny x).
    eps = max(vmin, 1e-9)
    safe = x_all > eps
    ratio = np.full(x_all.shape, np.nan, dtype=np.float32)
    ratio[safe] = y_all[safe] / np.maximum(x_all[safe], eps)
    on_diag_frac = float(np.mean(np.abs(ratio[safe] - 1.0) <= tol)) if safe.any() else float("nan")

    # Marginal PDFs (density-normalized so x/y are comparable irrespective of voxel
    # count). Same bin edges as the main hist → axes line up exactly.
    H_x, _ = np.histogram(x_clip, bins=edges, density=True)
    H_y, _ = np.histogram(y_clip, bins=edges, density=True)

    # gridspec: main heatmap (bottom-left), top x-marginal, right y-marginal,
    # plus a colorbar slot in the top-right corner.
    fig = plt.figure(figsize=(9, 8))
    gs = fig.add_gridspec(
        2, 3,
        width_ratios=[5, 1, 0.18],
        height_ratios=[1, 5],
        wspace=0.05, hspace=0.05,
    )
    ax = fig.add_subplot(gs[1, 0])
    ax_top = fig.add_subplot(gs[0, 0], sharex=ax)
    ax_right = fig.add_subplot(gs[1, 1], sharey=ax)
    cax = fig.add_subplot(gs[1, 2])

    H_plot = H.T  # rows=y, cols=x for pcolormesh
    # LogNorm needs vmin >= 1; clip empty cells.
    pos_min = H_plot[H_plot > 0].min() if (H_plot > 0).any() else 1.0
    norm = LogNorm(vmin=max(1.0, float(pos_min)), vmax=max(float(H_plot.max()), 1.0))
    # pcolormesh respects irregular (log-spaced) bin edges natively — this is the
    # fix for the imshow-extent-vs-logscale-mismatch bug that previously placed
    # bin N at linear position N before log-stretching the axis.
    pm = ax.pcolormesh(xe, ye, H_plot, norm=norm, cmap="viridis", shading="flat")
    if bin_scale == "log":
        ax.set_xscale("log")
        ax.set_yscale("log")
        ax_top.set_xscale("log")
        ax_right.set_yscale("log")
    ax.set_xlabel(f"x: {x_short}")
    ax.set_ylabel(f"y: {y_short}")
    if not no_diagonal:
        diag = np.array([vmin, vmax])
        ax.plot(diag, diag, color="white", linewidth=0.8, alpha=0.6, linestyle="--")
        ax.plot(diag, diag, color="black", linewidth=0.4, alpha=0.7, linestyle="--")

    # Marginal PDFs via stairs (one step per bin edge) — matches the histogram cells.
    ax_top.stairs(H_x, edges, fill=True, color="steelblue", alpha=0.6, linewidth=0.5)
    ax_right.stairs(H_y, edges, fill=True, color="steelblue", alpha=0.6, linewidth=0.5,
                    orientation="horizontal")
    ax_top.tick_params(axis="x", labelbottom=False)
    ax_right.tick_params(axis="y", labelleft=False)
    ax_top.set_ylabel("PDF", fontsize=8)
    ax_right.set_xlabel("PDF", fontsize=8)
    for a in (ax_top, ax_right):
        a.tick_params(labelsize=8)
        a.grid(True, alpha=0.3, linewidth=0.4)

    fig.colorbar(pm, cax=cax, label="voxel count")
    if title is None:
        if len(mats) == 1 and shapes:
            sh = shapes[0]
            shape_part = "×".join(str(d) for d in sh) + " voxels"
        else:
            shape_part = f"{x_all.size:,} voxels"
        splits = {s for s in (x_split, y_split) if s}
        if len(splits) == 1:
            set_tag = next(iter(splits))
            mats_part = (
                f"{mats[0]} ({set_tag})" if len(mats) == 1
                else f"{len(mats)} mats ({set_tag})"
            )
        else:
            mats_part = mats[0] if len(mats) == 1 else f"{len(mats)} mats"
        title = (
            f"{mats_part} — {shape_part}, {x_short} vs {y_short}\n"
            f"on-diag (|y/x-1|≤{tol:.0%}): {100*on_diag_frac:.1f}%"
        )
    # Anchor title across the whole figure so the top-marginal doesn't shove it.
    fig.suptitle(title, fontsize=10)
    ax.set_xlim(edges[0], edges[-1])
    ax.set_ylim(edges[0], edges[-1])
    fig.savefig(out_path, dpi=130, bbox_inches="tight")
    plt.close(fig)
    size = out_path.stat().st_size
    err(f"[joint-hist] on-diag(|y/x-1|≤{tol:.0%}) = {100*on_diag_frac:.2f}%  "
        f"(n_loaded={len(fetched)}, n_failed={len(failed)})")
    err(f"[joint-hist] wrote {out_path} ({size:,} bytes)")
    print(out_path)


@cli.group("analyze")
def analyze_grp():
    """Offline analysis subcommands (corr matrices, post-hoc diagnostics)."""


@analyze_grp.command("voxel-corr-blob")
@click.option("-P", "--patch-size", "patch_size", type=int, default=19,
              help="patch side P; P³ must match the .npz pred-axis dim")
@click.option("-k", "--kind", type=click.Choice(["pred", "true", "residual"]), default="pred",
              help="which series to correlate")
@click.option("-o", "--out-dir", default="site/public/voxel-corr",
              help="output dir; writes <run-label>.bin (int8 corr matrix), .json (1D curve + metadata)")
@click.option("-l", "--run-label", default="cont33k",
              help="frontend label / output basename (matches frontend route)")
@click.option("-r", "--r2", "r2_upload", is_flag=True,
              help="also upload the blob + sidecar to OA R2 under tomat/voxel-corr/")
@click.option("-b", "--bucket", default=R2_BUCKET, help="R2 bucket (with --r2)")
@click.option("-p", "--r2-prefix", default="tomat/voxel-corr",
              help="R2 key prefix (with --r2)")
@click.argument("preds_dir")
def analyze_voxel_corr_blob(
    preds_dir: str,
    patch_size: int,
    kind: str,
    out_dir: str,
    run_label: str,
    r2_upload: bool,
    bucket: str,
    r2_prefix: str,
) -> None:
    """Compute P³×P³ voxel-position corr matrix → int8 blob + JSON sidecar.

    Stacks all `<preds_dir>/*.npz` predictions, computes the full corr matrix,
    quantizes to int8 (corr ∈ [-1, 1] → [-127, 127]), and writes to
    `<out-dir>/<run-label>.bin` (P³ × P³ bytes, row-major). Sidecar
    `<run-label>.json` carries P, n_patches, the 1D offset curve, and the
    int8↔float linear-scale factors so the frontend can decode.

    Frontend (`site/src/voxel-corr/VoxelCorrPage.tsx`) loads the blob into a
    Uint8Array, renders it into an offscreen ImageData (color-mapped), then
    paints it to a visible canvas with CSS transform for zoom + pan.
    """
    import numpy as np

    src = Path(preds_dir)
    P = patch_size
    P3 = P ** 3
    files = sorted(src.glob("*.npz"))
    if not files:
        raise click.ClickException(f"no .npz files under {src}")

    err = lambda *a, **kw: print(*a, file=sys.stderr, **kw)
    err(f"[voxel-corr-blob] loading {len(files)} .npz files…")

    if kind == "residual":
        chunks_p, chunks_t = [], []
        for f in files:
            with np.load(f) as z:
                chunks_p.append(z["pred"].astype(np.float32))
                chunks_t.append(z["true"].astype(np.float32))
        X = np.concatenate(chunks_p, axis=0) - np.concatenate(chunks_t, axis=0)
    else:
        chunks = []
        for f in files:
            with np.load(f) as z:
                chunks.append(z[kind].astype(np.float32))
        X = np.concatenate(chunks, axis=0)

    n_patches = X.shape[0]
    if X.shape[1] != P3:
        raise click.ClickException(f"P³={P3} but data has {X.shape[1]} voxel positions")

    err(f"[voxel-corr-blob] {n_patches} patches × {P3} positions ({kind}, P={P})")
    err(f"[voxel-corr-blob] standardizing + computing corr matrix…")

    mu = X.mean(axis=0, keepdims=True)
    sd = X.std(axis=0, keepdims=True)
    sd = np.where(sd < 1e-8, 1.0, sd)
    Z = (X - mu) / sd
    # Z.T @ Z / N — (P³, P³), ≈190 MB float32 at P=19.
    C = (Z.T @ Z) / n_patches

    err(f"[voxel-corr-blob] computing 1D offset curve…")
    curve = np.zeros(P3, dtype=np.float32)
    for k in range(P3):
        curve[k] = float(np.mean(np.diagonal(C, offset=k)))

    # Quantize to int8: clip to [-1, 1], then scale by 127.
    err(f"[voxel-corr-blob] quantizing to int8…")
    C_clip = np.clip(C, -1.0, 1.0)
    C_int8 = np.round(C_clip * 127.0).astype(np.int8)

    # The matrix is symmetric (C[i,j] == C[j,i] by construction), so store
    # only the upper triangle INCLUDING the diagonal as a flat row-major
    # array of length P³(P³+1)/2. For P=19 that's 23.5M entries (vs 47M for
    # the full matrix) — halves both the raw size and the gzipped blob the
    # browser fetches. Frontend reflects on load.
    iu, ju = np.triu_indices(P3)
    C_int8_upper = C_int8[iu, ju]

    out = Path(out_dir)
    out.mkdir(parents=True, exist_ok=True)
    json_path = out / f"{run_label}.json"

    # Gzip the raw int8 bytes — corr matrices are very compressible (smooth
    # values + tail entropy). Even after upper-triangle halving we typically
    # see another ~50% off from gzip -9. Frontend fetches `.bin.gzip` and
    # decompresses via DecompressionStream.
    #
    # The `.gzip` extension (NOT `.gz`) is deliberate: Vite's static handler
    # auto-sets `Content-Encoding: gzip` for `.gz` URLs, which causes the
    # browser to auto-decompress on receipt — then our JS-side
    # DecompressionStream tries to re-decompress already-decompressed bytes
    # and crashes. Using `.gzip` keeps the server out of the loop and makes
    # the load path portable across dev (Vite) and prod (CFP, GH Pages, etc.).
    import gzip
    raw = C_int8_upper.tobytes(order="C")
    bin_gz_path = out / f"{run_label}.bin.gzip"
    with gzip.open(bin_gz_path, "wb", compresslevel=9) as gz:
        gz.write(raw)
    # Drop any stale uncompressed sibling so the frontend doesn't get confused.
    for stale_name in (f"{run_label}.bin", f"{run_label}.bin.gz"):
        stale = out / stale_name
        if stale.exists():
            stale.unlink()
    err(f"[voxel-corr-blob] wrote {bin_gz_path} "
        f"({bin_gz_path.stat().st_size / 1e6:.1f} MB, raw {len(raw) / 1e6:.1f} MB)")

    metadata = {
        "run_label": run_label,
        "kind": kind,
        "patch_size": P,
        "n_voxels": P3,
        "n_patches": int(n_patches),
        "n_mats": len(files),
        "int8_scale": 1.0 / 127.0,  # decoded = int8 * scale → float in [-1, 1]
        # `blob_format` tells the frontend how to interpret the int8 buffer.
        # `upper_triangle`: P³(P³+1)/2 entries, row-major over the upper
        # triangle (i <= j); the FE mirrors into the full matrix on load.
        # `full` (legacy, no field): P³ × P³ entries, row-major.
        "blob_format": "upper_triangle",
        "blob_compression": "gzip",
        "blob_size": int(bin_gz_path.stat().st_size),
        "curve": curve.tolist(),
        "canonical_offsets": {
            "1": "primary axis (k=1)",
            str(P): f"secondary axis (k=P={P})",
            str(P * P): f"tertiary axis (k=P²={P * P})",
        },
    }
    json_path.write_text(json.dumps(metadata))
    err(f"[voxel-corr-blob] wrote {json_path} "
        f"({json_path.stat().st_size / 1e3:.1f} kB)")

    if r2_upload:
        # 1h cache: blobs are deploy-time-immutable per run-label, but a 1h TTL
        # gives us a reasonable upper bound if we ever re-emit a label in place
        # (and the worker still serves its own short-TTL by default).
        cache_control = "public, max-age=3600"
        bin_key = f"{r2_prefix}/{run_label}.bin.gzip"
        json_key = f"{r2_prefix}/{run_label}.json"
        err(f"[voxel-corr-blob] uploading to r2://{bucket}/{bin_key}")
        _r2_put_bytes(
            bucket, bin_key, bin_gz_path.read_bytes(),
            "application/octet-stream", cache_control=cache_control,
        )
        err(f"[voxel-corr-blob] uploading to r2://{bucket}/{json_key}")
        _r2_put_bytes(
            bucket, json_key, json_path.read_bytes(),
            "application/json", cache_control=cache_control,
        )
        err(f"[voxel-corr-blob] r2 upload complete")

    print()
    print("offset k  |  avg corr  |  note")
    print("-" * 40)
    for k in [1, P, P * P]:
        if k < P3:
            note = ("primary axis" if k == 1
                    else f"secondary axis (+P)" if k == P
                    else "tertiary axis (+P²)")
            print(f"{k:>8d}  |  {curve[k]:>8.4f}  |  {note}")


@cli.group("cost")
def cost_grp():
    """MSRP-equivalent compute estimates ("retail value", NOT actual billing).

    Subcommands:
      tomat cost compute <run_label>   write `runs/<label>/cost.json` to R2
      tomat cost compute --all         backfill every synced run
      tomat cost summary               legacy: print preempt/on-demand rates
                                       for matching iris parent jobs
    """


@cost_grp.command("summary")
@click.option("-p", "--prefix", default="/ryan", help="iris job prefix to inspect")
@click.option("-f", "--filter", "filter_re", default="tomat|train-full|train-cont", help="regex on job name")
def cost_summary(prefix: str, filter_re: str):
    """Estimate MSRP-equivalent compute spend across matching iris jobs.

    Sums chip-hours (TPU × duration) across visible parent jobs and prints
    preempt-rate and on-demand-rate equivalents. Public-rate, not actual.
    """
    # Parent jobs only — children inherit their parent's slice, would double-count.
    res = iris_run("list", "--prefix", prefix)
    out = strip_iris_log(res.stdout)
    pat = re.compile(filter_re)
    rows = []
    for line in out.split("\n"):
        if not line.strip() or "JOB ID" in line:
            continue
        jid = line.split()[0]
        if not jid.startswith("/") or jid.count("/") > 2:
            continue
        if not pat.search(jid):
            continue
        # Pull TPU + duration from the line — parsing is fragile, so summary
        # call would be more robust; defer until we build a json list option.
        m = re.search(r"v6e-(\d+)", line)
        chips = int(m.group(1)) if m else 0
        rows.append((jid, chips, line))
    if not rows:
        err(f"no matching jobs under {prefix!r}")
        sys.exit(0)

    print(f"# Jobs (prefix={prefix}, filter={filter_re}):")
    print(f"  found {len(rows)} parent jobs (chip-hour estimates require `iris job summary` per-job)")
    for jid, chips, _ in rows:
        print(f"  v6e-{chips:<3d}  {jid}")
    print()
    print(f"# Public TPU rates (v6e):")
    print(f"  preempt   ${PRICE_PREEMPT:.2f}/chip-hr")
    print(f"  on-demand ${PRICE_ONDEMAND:.2f}/chip-hr")
    print()
    print("(For per-job chip-hour totals, run `tomat iris summary <jid>` and")
    print(" multiply chips × wall-clock manually. Auto-summing TBD.)")


