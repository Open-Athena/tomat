    job_id = label if label.startswith("/") else f"/{IRIS_USER}/{label}"
    payload = _iris_attempts_dump(job_id, tail=tail)
    if payload is None:
        sys.exit(1)
    data = json.dumps(payload, indent=1)
    if out:
        Path(out).write_text(data + "\n")
        err(f"[iris attempts] {job_id} → {out}")
    else:
        print(data)


@iris_grp.command("sync")
@click.option("-b", "--bucket", default=R2_BUCKET, help="R2 bucket")
@click.option("-k", "--key", default="tomat/iris-state.json", help="R2 key")
@click.option("-d", "--dry-run", is_flag=True, help="print the JSON without uploading")
@click.option("--no-attempts", is_flag=True,
              help="skip the per-training-job attempts sidecar fetch+upload")
@click.option("--attempts-prefix", default="tomat/iris-attempts",
              help="R2 prefix for per-label attempts sidecars")
@click.option("--attempts-workers", default=6, type=int,
              help="parallel `iris attempts-dump` invocations (each opens its "
              "own controller tunnel; keep modest to spare the controller)")
def iris_sync(bucket: str, key: str, dry_run: bool,
              no_attempts: bool, attempts_prefix: str, attempts_workers: int):
    """Snapshot iris job state for /ryan/{tomat,train,eval}/* parent jobs → R2.

    Powers the iris-state column on tomat.oa.dev/runs. Uses `iris job list
    --json` over RPC per prefix — SAFE to run on a cadence (e.g. cron every
    minute). The prior SQL-based version was banned for controller load.

    Also writes one `tomat/iris-attempts/<label>.json` sidecar per training
    job (`/ryan/train-*`), with per-attempt death timestamps + causes from
    iris's bug-report machinery. Skipped by `--no-attempts` (useful when
    iterating only the state index).
    """
    jobs: dict[str, dict] = {}
    for prefix in DEFAULT_IRIS_PREFIXES:
        for row in _iris_job_list_json(prefix):
            if row.get("has_children"):
                # Skip parent of a parent — we want parent jobs only.
                pass
            jid = row["job_id"]
            if jid.count("/") > 2:
                # Skip task rows (`/ryan/<job>/<task>`); we want parents.
                continue
            state_full = row.get("state", "")  # e.g. "JOB_STATE_RUNNING"
            state = state_full.removeprefix("JOB_STATE_") if state_full else "UNKNOWN"
            # `task_state_counts` is iris's per-state task histogram (keys are
            # `task_state_friendly` strings: 'running', 'pending', 'building',
            # 'completed', 'failed', 'killed', ...). Surface it raw — the dashboard
            # uses it to disambiguate `RUNNING (1r/3p)` cascade-restart loops from
            # genuine all-healthy RUNNING. Drop zero entries to keep the payload
            # tight; the frontend treats missing keys as zero.
            tsc_raw = row.get("task_state_counts") or {}
            tsc = {k: int(v) for k, v in tsc_raw.items() if int(v) > 0}
            jobs[jid] = {
                "state": state,
                "state_code": 0,  # legacy; sql path filled this in
                "preempts": int(row.get("preemption_count") or 0),
                "failures": int(row.get("failure_count") or 0),
                "error": row.get("error") or None,
                "exit_code": row.get("exit_code"),
                "submitted_at_ms": int((row.get("submitted_at") or {}).get("epoch_ms") or 0) or None,
                "started_at_ms": int((row.get("started_at") or {}).get("epoch_ms") or 0) or None,
                "finished_at_ms": int((row.get("finished_at") or {}).get("epoch_ms") or 0) or None,
                "num_tasks": int(row.get("task_count") or 0),
                "task_state_counts": tsc,
            }
    payload = {
        "schema_version": 1,
        "synced_at": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds"),
        "count": len(jobs),
        "jobs": jobs,
    }
    data = json.dumps(payload, indent=1).encode("utf-8")
    print(f"[iris sync] {len(jobs)} jobs → s3://{bucket}/{key} ({len(data)} bytes)")
    if dry_run:
        print(data.decode())
    else:
        _r2_put_bytes(bucket, key, data, "application/json")
        print(f"[iris sync] {R2_ENDPOINT}/{bucket}/{key}")

    if no_attempts:
        return

    # Per-label attempts sidecars. Only training runs (`/ryan/train-*`); the
    # `tomat-eval-*` and other sidecar jobs aren't shown on the runs dashboard
    # so per-attempt detail for them would just waste R2 + controller cycles.
    training_jids = sorted(j for j in jobs if TRAINING_JOB_RE.match(j))
    print(f"[iris sync] {len(training_jids)} training jobs → "
          f"per-label attempts sidecars under s3://{bucket}/{attempts_prefix}/")
    if not training_jids:
        return

    n_ok = n_fail = 0
    with ThreadPoolExecutor(max_workers=max(1, attempts_workers)) as ex:
        futures = {ex.submit(_iris_attempts_dump, jid, 0): jid for jid in training_jids}
        for fut in as_completed(futures):
            jid = futures[fut]
            payload = fut.result()
            if payload is None:
                n_fail += 1
                continue
            label = payload.get("label") or jid.removeprefix(f"/{IRIS_USER}/")
            key_i = f"{attempts_prefix}/{label}.json"
            data_i = json.dumps(payload, indent=1).encode("utf-8")
            if dry_run:
                err(f"[iris sync] dry-run: would upload {len(data_i)}B to {key_i}")
            else:
                _r2_put_bytes(bucket, key_i, data_i, "application/json")
            n_ok += 1
    print(f"[iris sync] attempts sidecars: {n_ok} uploaded, {n_fail} failed")


@iris_grp.command("ls")
@click.option("-f", "--filter", "filter_re", default=None, help="extra regex filter on job line")
@click.option("-s", "--state", default=None, help="filter by state (running, failed, ...)")
@click.option("--all", "show_all", is_flag=True, help="include child task lines (default: parents only)")
def iris_ls(filter_re: str | None, state: str | None, show_all: bool):
    """List tomat-relevant /ryan/* iris jobs (parents only by default).

    Fans across `/ryan/{tomat,train,eval}` prefixes — iris requires --prefix
    to be a `/<user>/<jobname>` form, not a bare `/<user>`.
    """
    pat = re.compile(filter_re) if filter_re else None
    lines = iris_list_lines(state=state)
    print("JOB ID                                                                                              STATE      RESOURCES                          SUBMITTED                         REASON")
    for line in lines:
        jid = line.split()[0]
        if not show_all and jid.count("/") > 2:
            continue
        if pat and not pat.search(line):
            continue
        print(line)


@iris_grp.command("kill")
@click.argument("substr")
@click.option("-p", "--pending", is_flag=True, help="kill pending jobs (default: running only)")
@click.option("-y", "--yes", is_flag=True, help="skip confirmation prompt")
def iris_kill(substr: str, pending: bool, yes: bool):
    """Kill iris jobs whose name matches SUBSTR (running by default; -p adds pending)."""
    states = ["running"] + (["pending"] if pending else [])
    matches: list[str] = []
    seen: set[str] = set()
    for s in states:
        for line in iris_list_lines(state=s):
            jid = line.split()[0]
            if jid.count("/") > 2:
                continue
            if substr in jid and jid not in seen:
                matches.append(jid)
                seen.add(jid)
    if not matches:
        err(f"no {'/'.join(states)} parent jobs match {substr!r}")
        sys.exit(1)
    err(f"will kill {len(matches)} jobs:")
    for j in matches:
        err(f"  {j}")
    if not yes:
        if not click.confirm("proceed?", default=False):
            err("aborted")
            sys.exit(1)
    for j in matches:
        r = iris_run("kill", j)
        err(f"  killed {j}: rc={r.returncode}")


@iris_grp.command("logs")
@click.argument("substr")
@click.option("-n", "--max-lines", default=200, type=int)
@click.option("-l", "--level", default=None, help="warning|error|info|debug")
@click.option("--task", default=None, help="task index (e.g. 1); default = parent job")
def iris_logs(substr: str, max_lines: int, level: str | None, task: str | None):
    """Tail logs for a job (most recent N lines)."""
    matches = _parent_jids_matching(substr)
    if len(matches) != 1:
        err(f"expected 1 match for {substr!r}, got {len(matches)}: {matches}")
        sys.exit(1)
    jid = matches[0]
    if task is not None:
        jid = f"{jid}/{task}"
    args = ["logs", jid, "--tail", "--max-lines", str(max_lines)]
    if level:
        args += ["--level", level]
    r = iris_run(*args, capture=False, timeout=300)
    sys.exit(r.returncode)


@iris_grp.command("summary")
@click.argument("substr")
def iris_summary(substr: str):
    """Show per-task summary (state, exit, peak mem, error)."""
    matches = _parent_jids_matching(substr)
    if len(matches) != 1:
        err(f"expected 1 match for {substr!r}, got {len(matches)}: {matches}")
        sys.exit(1)
    r = iris_run("summary", matches[0], capture=False, timeout=120)
    sys.exit(r.returncode)


