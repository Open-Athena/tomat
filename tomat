def _trim_to_latest_trajectory(rows: list[dict]) -> list[dict]:
    """Drop rows from abandoned trajectories before a `global_step` reset.

    `rows` must already be sorted by `_step` ascending (the call site does
    this; commit `33c688d` after the bin5 incident — wandb's `_timestamp`
    is server-receive time on iris-TPU runs that async-upload metric
    batches, so a ts-sorted walk would see `global_step` regress and
    mis-trim. `_step` is the dependable monotonic key).

    Walk in `_step` order, find the LAST index where `global_step`
    decreased vs the previous non-null `global_step` row — that's the
    start of a fresh training trajectory (caused by `--force`, a
    wandb-resume that reset, etc.). Keep only rows from that index onward.

    Mirror of `scripts/runs-sync.py:_trim_to_latest_trajectory`. Spec 56
    (C1) plans to factor them into one shared helper.

    No reset detected → no change. Single trajectory → no change.
    """
    if not rows:
        return rows
    last_restart = 0
    prev_gs: int | float | None = None
    for i, row in enumerate(rows):
        gs = row.get("global_step")
        if gs is None:
            continue
        if prev_gs is not None and gs < prev_gs:
            last_restart = i
        prev_gs = gs
    if last_restart == 0:
        return rows
    err(f"[sync] trajectory reset detected at row {last_restart}/{len(rows)}: "
        f"dropping {last_restart} rows from abandoned trajectories "
        f"(common after --force re-fire)")
    return rows[last_restart:]


def _vl_backfill_rows(
    ckpt_leaf: str,
    bucket: str | None = None,
) -> list[dict]:
    """List per-step VL JSONs and emit history-style rows that `runs_sync`
    can splice into the wandb history before parquet build.

    Two source dirs, queried in this order (later wins on per-step overlap):
      1. `gs://<bucket>/eval/vl-backfill/<ckpt_leaf>/step-*.json` — older
         backfill from `scripts/backfill_vl_modal.py` and the first
         `preamble_vl_modal.py` baseline pass, both of which sampled
         patches from the TAIL of `train-full-v3`. Not real VL (training
         materials), but kept as a fallback for runs without a held-out
         pass.
      2. `gs://<bucket>/eval/vl/<ckpt_leaf>/step-*.json` — newer
         held-out VL from `preamble_vl_modal.py --label val-full-v3`
         (the default since 2026-06-05). This is the real generalization
         signal. Overrides (1) on overlapping steps.

    Each emitted row mirrors what `wandb.log({"eval/loss": ...,
    "global_step": ...})` would have logged at training time, with
    `_timestamp` synthesized from the JSON's `mtime` (so the row sorts
    after every wandb history row whose `_timestamp` is older, and before
    any later row — both fine, since `runs_sync` re-sorts by `_step` at
    the end anyway).

    Skips silently (returns `[]`) when no JSONs exist — runs without VL
    artifacts pass through unchanged.
    """
    import json
    import re as _re
    import fsspec

    def _read_dir(base: str, kind: str) -> dict[int, dict]:
        """Return step→row dict for one source dir. Empty on missing dir."""
        try:
            fs, _ = fsspec.core.url_to_fs(base)
            if not fs.exists(base):
                return {}
            paths = [p for p in fs.ls(base) if p.endswith(".json")]
        except (FileNotFoundError, ValueError) as e:
            err(f"[sync] {kind}: ls {base} failed: "
                f"{type(e).__name__}: {e}")
            return {}
        rows: dict[int, dict] = {}
        for p in sorted(paths):
            try:
                with fs.open(p, "r") as f:
                    d = json.load(f)
                # Two known JSON shapes:
                #   (a) `backfill_vl_modal.py`: {"step": N, "eval_loss": x, ...}
                #   (b) `preamble_vl_modal.py` (baseline mode):
                #       {"results": {"baseline": {"mean": x, ...}}, ...}
                #       — step parsed from filename `.../step-<N>.json`.
                if "step" in d and "eval_loss" in d:
                    step, ev = int(d["step"]), float(d["eval_loss"])
                else:
                    m = _re.search(r"step-(\d+)\.json$", p)
                    if not m:
                        raise KeyError(f"can't extract step from {p}")
                    step = int(m.group(1))
                    ev = float(d["results"]["baseline"]["mean"])
            except (KeyError, ValueError, json.JSONDecodeError) as e:
                err(f"[sync] {kind}: skip {p}: {type(e).__name__}: {e}")
                continue
            try:
                info = fs.info(p)
                # gcsfs returns `mtime` as a `datetime` and `updated` as an
                # ISO string — both need parsing. Try datetime → isoformat
                # parse → 0.0 in that order.
                mt = info.get("mtime") or info.get("updated")
                if hasattr(mt, "timestamp"):
                    mtime = float(mt.timestamp())
                elif isinstance(mt, str):
                    from datetime import datetime as _dt
                    # Handle trailing 'Z' (Zulu) — fromisoformat needs +00:00.
                    s = mt[:-1] + "+00:00" if mt.endswith("Z") else mt
                    mtime = float(_dt.fromisoformat(s).timestamp())
                else:
                    mtime = float(mt) if mt else 0.0
            except Exception as e:
                err(f"[sync] {kind}: mtime-parse failed for {p}: "
                    f"{type(e).__name__}: {e}")
                mtime = 0.0
            rows[step] = {
                "_step": step,
                "_timestamp": mtime,
                "global_step": step,
                "eval/loss": ev,
            }
        return rows

    # Buckets to scan. Until `bucket` is passed explicitly per-run, scan ALL
    # canonical region buckets — bin5's VL backfill lands in us-east5 (its
    # training region per zone-local writes), older runs live in eu-west4.
    # Later sources win on per-step overlap (sorted scan + dict merge).
    sys.path.insert(0, str(PROJECT_ROOT / "src"))
    from tomat.buckets import CANONICAL_BUCKETS as _CANON_BUCKETS
    buckets = [bucket] if bucket else list(_CANON_BUCKETS)
    old: dict[int, dict] = {}
    new: dict[int, dict] = {}
    for b in buckets:
        old.update(_read_dir(f"{b}/eval/vl-backfill/{ckpt_leaf}", "vl-backfill"))
        new.update(_read_dir(f"{b}/eval/vl/{ckpt_leaf}", "vl"))
    # `new` wins on overlap — held-out val supersedes train-tail.
    merged = {**old, **new}
    if not merged:
        return []
    err(f"[sync] vl: merged {len(merged)} step(s) "
        f"(vl={len(new)}, vl-backfill={len(old)}, "
        f"overrides={len(set(old) & set(new))})")
    return [merged[s] for s in sorted(merged)]


# Schema definition is in `tomat.run_history.arrow_schema` (imported at
# module top as `_arrow_schema`). Wrapper kept here so existing callers
# don't have to change.
_run_parquet_arrow_schema = _arrow_schema


def _r2_put_bytes(
    bucket: str,
    key: str,
    data: bytes,
    content_type: str,
    cache_control: str = "public, max-age=60",
):
    """Upload `data` to `s3://bucket/key` on OA's R2 via `aws s3 cp` (cfo profile).

    Shell-out matches the existing `scripts/publish_mpdb.py` pattern;
    avoids adding boto3 as a project dep just for this."""
    import tempfile
    with tempfile.NamedTemporaryFile(delete=False) as f:
        f.write(data)
        path = f.name
    try:
        r = subprocess.run(
            ["aws", "--profile", "cfo", "--endpoint-url", R2_ENDPOINT,
             "s3", "cp", path, f"s3://{bucket}/{key}",
             "--content-type", content_type,
             "--cache-control", cache_control],
            capture_output=True, text=True, timeout=120,
        )
        if r.returncode != 0:
            err(f"[sync] aws s3 cp failed: rc={r.returncode}")
            err(r.stderr[-1000:])
            sys.exit(2)
    finally:
        Path(path).unlink(missing_ok=True)


@runs.command("sync")
@click.option("-b", "--bucket", default=R2_BUCKET, help="R2 bucket")
@click.option("-P", "--project", default=None,
              help="restrict to one wandb project (use when a name was reused across t10n)")
@click.option("-p", "--prefix", default=R2_RUNS_PREFIX,
              help="R2 key prefix (run id appended)")
@click.option("-n", "--dry-run", is_flag=True,
              help="fetch + assemble, but skip the upload")
@click.option("-o", "--out-dir", default=None,
              help="if set, also write a local copy of the parquet + manifest")
@click.argument("substr")
def runs_sync(substr: str, bucket: str, prefix: str, project: str | None, dry_run: bool, out_dir: str | None):
    """Pull a wandb run's history → parquet → OA's R2.

    Writes `s3://<bucket>/<prefix>/<run_name>/{raw.parquet,manifest.json}`.
    Phase-A scaffolding for the `tomat.oa.dev/runs` dashboard
    (see `specs/23-runs-dashboard.md`).

    `scan_history(keys=…)` returns rows where ALL keys are set, not
    at-least-one — so we scan unfiltered and project to
    `_RUN_PARQUET_KEYS` in post.
    """
    import io
    import json
    from datetime import datetime, timezone
    import wandb
    import pyarrow as pa
    import pyarrow.parquet as pq

    api = wandb.Api()
    # Find every (entity, project) copy of this run — a single wandb display
    # name can have multiple `(entity, project, id)` keys if the same worker
    # logged across projects (e.g. cluster-monitor vs trainer mismatch). We
    # re-walk projects explicitly to keep all copies, then group by display
    # name and validate they're actually the *same* logical run.
    seen: set[tuple[str, str, str]] = set()
    matches: list = []
    for path in WANDB_PROJECTS:
        try:
            proj_runs = list(api.runs(path))
        except ValueError as e:
            if "Could not find project" in str(e):
                continue
            raise
        for r in proj_runs:
            if substr not in r.name:
                continue
            key = (r.entity, r.project, r.name)
            if key in seen:
                continue
            seen.add(key)
            matches.append(r)

    if not matches:
        err(f"no runs match {substr!r}")
        sys.exit(1)
    if project is not None:
        before = len(matches)
        matches = [r for r in matches if r.project == project]
        err(f"[sync] --project={project} → filtered {before} → {len(matches)} copy/copies")
        if not matches:
            err(f"no copies of {substr!r} in project {project!r}")
            sys.exit(1)
    # Group by (entity, display_name) — copies of the same logical run.
    groups: dict[tuple[str, str], list] = {}
    for r in matches:
        groups.setdefault((r.entity, r.name), []).append(r)
    if len(groups) > 1:
        err(f"multiple distinct runs match {substr!r}:")
        for (ent, name) in groups:
            err(f"  {ent}/{name}  ({len(groups[(ent, name)])} project copies)")
        sys.exit(1)
    (entity, run_name), copies = next(iter(groups.items()))
    # Refuse cross-project merge when copies have different tokenizations
    # (different `data.cache_dir`). Two runs with the same display_name but
    # different t10n are physically distinct experiments that happened to
    # share a name — merging them produces nonsense overlays in the
    # dashboard. Caller must pass --project to pick one.
    def _cache_dir(rn) -> str | None:
        return (rn.config.get("data") or {}).get("cache_dir")
    cache_dirs = {_cache_dir(r) for r in copies}
    if len(cache_dirs) > 1:
        err(f"refusing to merge {len(copies)} copies of {substr!r} — "
            f"different `data.cache_dir`s (incompatible t10n):")
        for r in copies:
            err(f"  {r.entity}/{r.project}: cache_dir={_cache_dir(r)!r}")
        err(f"pass --project=<one-of-the-above> to sync a single copy")
        sys.exit(2)
    # Primary copy = most-recently active (largest _timestamp on last row).
    # Used for manifest metadata (state, url, config). History is merged
    # across ALL copies (now guaranteed t10n-compatible).
    primary = max(copies, key=lambda r: float(r.summary.get("_timestamp") or 0))
    err(f"[sync] run: {run_name} — {len(copies)} project copy/copies: "
        f"{', '.join(f'{r.project}({r.state})' for r in copies)}; "
        f"primary={primary.project}")

    keep = set(_RUN_PARQUET_KEYS)
    rows: list[dict] = []
    for r in copies:
        before = len(rows)
        for row in r.scan_history():
            projected = {k: v for k, v in row.items() if k in keep}
            if any(k for k in projected if not k.startswith("_")):
                rows.append(projected)
        err(f"  [sync] {r.project}: +{len(rows) - before} rows")
    # Sort + trim the wandb rows FIRST, then splice in VL backfill rows.
    # The trim is for `--force` re-fire artifacts (wandb has two interleaved
    # global_step trajectories for the same run id; keep only the latest).
    # VL backfill rows have wallclock timestamps that postdate the entire
    # training run, but their `global_step` field is mid-training — if we
    # mix them in BEFORE trim, the reset detector mistakes the apparent
    # global_step decrease (wandb tail's max global_step → VL row's
    # mid-training global_step) for an abandoned trajectory and drops
    # either the VL rows (when mtime sort puts them first) or all the
    # wandb rows (when mtime sort puts them last). Splice AFTER trim.
    # Sort by `_step` ASCENDING — NOT `_timestamp`. wandb's `_timestamp` is
    # the server-receive time (BackgroundIterator async-uploads metric batches)
    # and late-uploaded early-step rows appear LATER in ts-order, making the
    # `global_step` column read as if it had regressed. Trim then misfires and
    # nukes 49,998 / 50,000 rows of good training (see bin5 incident
    # 2026-06-12). `_step` is the dependable identity — it's wandb's per-row
    # monotonic log counter. Cron (`scripts/runs-sync.py:_trim_to_latest_…`)
    # already does this; this call site was the holdout. The FE WallclockPlot
    # walks rows in `_step` order for the same reason (commit 95ee5de).
    rows.sort(key=lambda d: d.get("_step") if d.get("_step") is not None else -1)
    rows = _trim_to_latest_trajectory(rows)
    # Splice in `eval/loss` from any VL backfill: prefer real held-out
    # `eval/vl/<ckpt_leaf>/step-*.json` (from `preamble_vl_modal.py
    # --label val-full-v3`, default since 2026-06-05), fall back to the
    # older `eval/vl-backfill/` JSONs (which sampled the TAIL of
    # `train-full-v3` — directional but optimistically biased). Pre-spec-47
    # runs (e.g. v4) didn't carve out a val split during training so they
    # never logged `eval/loss` natively.
    vl_rows = _vl_backfill_rows(run_name)
    if vl_rows:
        rows.extend(vl_rows)
        # Re-sort by _timestamp so plot consumers can iterate chronologically.
        rows.sort(key=lambda d: (d.get("_timestamp") or 0, d.get("_step") or 0))
    err(f"[sync] pulled {len(rows)} merged history rows")
    r = primary  # downstream code reads `r.name`, `r.url`, etc.

    schema = _run_parquet_arrow_schema()
    if rows:
        rows = sorted(rows, key=lambda d: d.get("_step") or -1)
        cols = {f.name: [d.get(f.name) for d in rows] for f in schema}
        table = pa.Table.from_arrays(
            [pa.array(cols[f.name], type=f.type) for f in schema], schema=schema,
        )
    else:
        table = pa.Table.from_pylist([], schema=schema)

    buf = io.BytesIO()
    # snappy not zstd: hyparquet's default build doesn't include the ZSTD
    # codec, and these files are < 1 MB so the compression-ratio diff is moot.
    pq.write_table(table, buf, compression="snappy", row_group_size=10**7)
    parquet_bytes = buf.getvalue()
    err(f"[sync] parquet: {len(parquet_bytes)/1e6:.2f} MB"
        f" ({table.num_rows} rows × {len(schema)} cols)")

    step_col = table.column("_step")
    ts_col = table.column("_timestamp")
    summary = dict(r.summary)
    # Latest *training* step. Two reasons we can't just read summary.global_step:
    #   1. `summary.global_step` is logged only at ckpt-save / eval-end boundaries
    #      (every ~500 steps for fresh-from-scratch runs), so for a run actively
    #      training between boundaries it's stale (or missing entirely if the
    #      run hasn't hit the first ckpt yet).
    #   2. `summary._step` IS in summary but is wandb's auto log-counter,
    #      bumped by EVERY `wandb.log(...)` including unrelated `cluster/*`
    #      preempt-watch pings — so it overcounts the actual training step.
    # The parquet history's `global_step` column is the truth: dense training-
    # step values logged with each `train/loss` row. Carry the max into the
    # manifest so cards on /runs show real progress on fresh running runs.
    gs_col = (table.column("global_step")
              if "global_step" in table.schema.names else None)
    last_train_step: int | None = None
    if gs_col is not None and table.num_rows:
        # Reverse-scan for the last non-null global_step (the most recent
        # training-step row, even if eval rows have been emitted after it).
        gs_arr = gs_col.to_pylist()
        for v in reversed(gs_arr):
            if v is not None:
                last_train_step = int(v)
                break
    # Backfill `summary` with the last non-null history value for the
    # training-stat fields wandb auto-flushes only at clean exit. Bin5's
    # trainer ended `failed` so the wandb-side summary lacks
    # train/loss + throughput/* — without this, the dashboard card loses
    # tr / MFU / EF and cost.json computes $0 (no device_kind to infer
    # hardware). Key set is shared with `scripts/runs-sync.py` via
    # `tomat.run_history.BACKFILL_KEYS`.
    if table.num_rows:
        tail_n = min(table.num_rows, 200)
        tail = table.slice(table.num_rows - tail_n, tail_n)
        for col_name in _BACKFILL_KEYS:
            if col_name in summary or col_name not in tail.schema.names:
                continue
            for v in reversed(tail.column(col_name).to_pylist()):
                if v is not None:
                    summary[col_name] = v
                    break
    manifest = {
        "schema_version": _RUN_PARQUET_SCHEMA_VERSION,
        "synced_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "run": {
            "id": r.id, "name": r.name,
            "project": r.project, "entity": r.entity,
            "state": r.state, "url": r.url, "created_at": r.created_at,
            "tags": list(r.tags or []), "group": r.group,
            "config": dict(r.config),
        },
        "summary": {k: v for k, v in summary.items()
                    if isinstance(v, (int, float, bool, str)) or v is None},
        "history": {
            "rows": table.num_rows,
            "step_min": int(step_col[0].as_py()) if table.num_rows else None,
            "step_max": int(step_col[-1].as_py()) if table.num_rows else None,
            "last_train_step": last_train_step,
            "ts_min": float(ts_col[0].as_py()) if table.num_rows and ts_col[0].is_valid else None,
            "ts_max": float(ts_col[-1].as_py()) if table.num_rows and ts_col[-1].is_valid else None,
        },
    }
    manifest_bytes = json.dumps(manifest, indent=2).encode()
    err(f"[sync] manifest: {len(manifest_bytes)} bytes,"
        f" step range [{manifest['history']['step_min']}, {manifest['history']['step_max']}]")

    if out_dir:
        d = Path(out_dir) / r.name
        d.mkdir(parents=True, exist_ok=True)
        (d / "raw.parquet").write_bytes(parquet_bytes)
        (d / "manifest.json").write_bytes(manifest_bytes)
        err(f"[sync] wrote local copy: {d}/")

    if dry_run:
        err("[sync] dry-run — skipping R2 upload")
        return

    parquet_key = f"{prefix}/{r.name}/raw.parquet"
    manifest_key = f"{prefix}/{r.name}/manifest.json"
    _r2_put_bytes(bucket, parquet_key, parquet_bytes, "application/octet-stream")
    _r2_put_bytes(bucket, manifest_key, manifest_bytes, "application/json")
    err(f"[sync] uploaded to s3://{bucket}/{prefix}/{r.name}/{{raw.parquet,manifest.json}}")
    print(f"{R2_ENDPOINT}/{bucket}/{parquet_key}")

    # Auto-populate cost.json (spec 46) — the dashboard's `$X MSRP` chip
    # reads this. Cheap to compute (one R2 GET for iris-state, optional
    # attempts sidecar GET for TPU runs; Modal runs reuse the manifest
    # we just built). Failures here must NOT abort runs sync — cost is
    # secondary to the parquet + manifest write.
    try:
        iris_state = _r2_get_json(bucket, "tomat/iris-state.json")
        _compute_one_cost(
            r.name,
            bucket=bucket,
            runs_prefix=prefix,
            attempts_prefix="tomat/iris-attempts",
            iris_state=iris_state,
            dry_run=False,
            manifest=manifest,
        )
    except Exception as e:
        err(f"[sync] WARN: cost compute failed for {r.name}: "
            f"{type(e).__name__}: {e}")

    # NOTE: pending-fires entries used to be pruned here once the manifest
    # landed. That was for the placeholder-card use case (hide the
    # placeholder once the real manifest exists), but the dashboard side
    # already filters those out via `visibleSet.has(fire.run_id)` in
    # RunsPage's placeholder build — so the prune was redundant for that.
    #
    # The run→fc-id binding in pending-fires IS still load-bearing: it
    # drives the run-detail Modal-icon deep-link (per RunHeaderRich's
    # `data.modalFcId`). Pruning here broke that link for every run whose
    # manifest had landed — so the link silently fell back to the
    # unfiltered calls tab. Keep the entry; `pending_fire_add` already
    # de-dupes per run_id (latest fire wins), so re-fires update in place.


@runs.command("wallclock-plot")
@click.argument("substr")
@click.option("-o", "--out", default=None,
              help="output PNG path (default: plots/wallclock/<run>.png)")
@click.option("-u", "--upload", is_flag=True,
              help="also wandb.log({summary/wallclock_overlay: Image(out)})")
def runs_wallclock_plot(substr: str, out: str | None, upload: bool):
    """Plot step count + loss over WALLCLOCK time, with markers at every
    sigterm / restart event.

    Useful for visualizing the cost of preempts: gaps in the step curve =
    time spent re-initing rather than training. Sigterm markers (gray) +
    cluster preempt-count steps (purple) show when each iris-side event
    landed in real time, regardless of where on the global step axis they
    fell.
    """
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.dates as mdates
    import matplotlib.pyplot as plt
    from datetime import datetime, timezone
    import wandb

    api = wandb.Api()
    r = require_one(match_runs(api, substr), substr)
    name = r.name

    def hist(key: str) -> list[tuple[float, float]]:
        """Return [(unix_ts, value)] pairs for KEY. wandb's `_timestamp`
        is absolute Unix epoch seconds (not relative to run start)."""
        out: list[tuple[float, float]] = []
        try:
            for row in r.scan_history(keys=["_timestamp", "_step", key]):
                v = row.get(key)
                if v is None:
                    continue
                ts = row.get("_timestamp")
                if ts is None:
                    continue
                out.append((float(ts), float(v)))
        except Exception:
            pass
        return out

    step_pts = hist("_step")        # treat _step itself as a "metric" — gives (ts, step)
    train_loss = hist("train/loss")
    preempts_total = hist("cluster/preemptions")
    starts = hist("lifecycle/trainer_started")
    sigterms = hist("lifecycle/sigterm_received")

    def to_dt(ts: float):
        return datetime.fromtimestamp(ts, tz=timezone.utc)

    fig, ax = plt.subplots(figsize=(12, 5.5))

    if step_pts:
        xs = [to_dt(t) for t, _ in step_pts]
        ys = [s for _, s in step_pts]
        ax.plot(xs, ys, lw=1.4, color="#1f77b4", label="step")
        ax.set_ylabel("step", color="#1f77b4")
        ax.tick_params(axis="y", labelcolor="#1f77b4")

    if train_loss:
        ax2 = ax.twinx()
        xs = [to_dt(t) for t, _ in train_loss]
        ys = [v for _, v in train_loss]
        ax2.plot(xs, ys, lw=0.6, color="#d62728", alpha=0.4, label="train/loss")
        ax2.set_ylabel("train/loss", color="#d62728")
        ax2.tick_params(axis="y", labelcolor="#d62728")
        ax2.set_yscale("log")

    # Vertical markers at sigterm + trainer_started events.
    for ts, _ in sigterms:
        ax.axvline(to_dt(ts), color="#7f7f7f", ls=":", lw=0.7, alpha=0.5)
    for ts, _ in starts:
        ax.axvline(to_dt(ts), color="#ff7f0e", ls="--", lw=0.9, alpha=0.7)
    # Mark each new value of cluster/preemptions (jumps in iris's count).
    last_p: float | None = None
    for ts, p in preempts_total:
        if last_p is not None and p > last_p:
            ax.axvline(to_dt(ts), color="#9467bd", ls="-", lw=0.6, alpha=0.4)
        last_p = p

    ax.xaxis.set_major_formatter(mdates.DateFormatter("%H:%M\n%m-%d"))
    ax.grid(alpha=0.3)
    n_sig = len(sigterms)
    n_start = len(starts)
    n_pre = sum(1 for i in range(1, len(preempts_total))
                if preempts_total[i][1] > preempts_total[i - 1][1]) if preempts_total else 0
    ax.set_title(f"{name}  ·  {n_sig} sigterms, {n_start} starts, "
                 f"{n_pre} cluster-preempt jumps")

    handles = []
    if step_pts: handles.append(plt.Line2D([], [], color="#1f77b4", label="step"))
    if train_loss: handles.append(plt.Line2D([], [], color="#d62728", alpha=0.6, label="train/loss"))
    handles += [
        plt.Line2D([], [], color="#ff7f0e", ls="--", label=f"trainer_started ({n_start})"),
        plt.Line2D([], [], color="#7f7f7f", ls=":", label=f"sigterm ({n_sig})"),
        plt.Line2D([], [], color="#9467bd", ls="-", alpha=0.5, label=f"cluster preempt ({n_pre})"),
    ]
    ax.legend(handles=handles, loc="lower right", fontsize=9, framealpha=0.85)
    fig.autofmt_xdate()

    out_path = Path(out) if out else PROJECT_ROOT / "plots" / "wallclock" / f"{name}.png"
    out_path.parent.mkdir(parents=True, exist_ok=True)
    fig.tight_layout()
    fig.savefig(out_path, dpi=130)
    plt.close(fig)
    print(f"wrote: {out_path}")
    print(f"  steps logged: {len(step_pts)}  range: "
          f"{step_pts[0][1] if step_pts else '-'} → {step_pts[-1][1] if step_pts else '-'}")
    print(f"  events: {n_start} starts, {n_sig} sigterms, {n_pre} cluster-preempt jumps")

    if upload:
        run = wandb.init(
            entity=WANDB_PROJECT.split("/")[0],
            project=WANDB_PROJECT.split("/")[-1],
            id=name, resume="allow",
        )
        run.summary["summary/wallclock_overlay"] = wandb.Image(str(out_path))
        run.finish()
        print(f"  uploaded to wandb run {name} as summary/wallclock_overlay")


