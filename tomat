def _wb_exec(query: str, **variables):
    """Execute a raw GraphQL query against wandb.

    Uses `requests` directly (wandb's bundled `wandb_gql` has a fragile
    transitive vendor layout that doesn't survive being imported by an
    external script). API key resolution mirrors `wandb.Api()` — env var,
    then `~/.netrc`.
    """
    import netrc
    import requests
    key = os.environ.get("WANDB_API_KEY")
    host = os.environ.get("WANDB_BASE_URL", "https://api.wandb.ai")
    if not key:
        try:
            auths = netrc.netrc().authenticators(host.split("//", 1)[-1])
            if auths:
                key = auths[2]
        except (FileNotFoundError, netrc.NetrcParseError):
            pass
    if not key:
        err("set WANDB_API_KEY or `wandb login`")
        sys.exit(1)
    r = requests.post(
        f"{host}/graphql",
        json={"query": query, "variables": variables or {}},
        auth=("api", key),
        timeout=30,
    )
    r.raise_for_status()
    body = r.json()
    if body.get("errors"):
        raise RuntimeError(json.dumps(body["errors"], indent=2))
    return body["data"]


@cli.group("cache")
def cache_grp():
    """Manage Levanter caches: build, mirror across regions, list."""


# Canonical source bucket (where cache-build originally produces the cache).
_CACHE_SRC_DEFAULT = "gs://marin-eu-west4/tomat"
# Target buckets we mirror the cache to so we have region-local data in
# every zone iris might schedule us into. Avoids the "cross-region IO
# halves MFU" problem when iris picks a zone we don't have cache in.
# Map: bucket → zone(s) it serves.
_CACHE_TARGETS = {
    "gs://marin-us-central1/tomat": ["us-central1-a (v5p)"],
    "gs://marin-us-east1/tomat":    ["us-east1-d (v6e)"],
    "gs://marin-us-east5/tomat":    ["us-east5-a (v5p)", "us-east5-b (v6e)"],
}

# Region → bucket map for spec 62 (region-strategy). Includes canonical
# eu-west4 source bucket as well, so eligibility check can consider it.
# Keys MUST match iris's region naming (g.region on ScalingGroup, which
# uses Google's official region names like `europe-west4`). The bucket
# names use Google's shorthand `eu-west4` — that's an inconsistency in
# Google's own naming, not a typo here.
_REGION_BUCKETS = {
    "europe-west4": "gs://marin-eu-west4/tomat",
    "us-east5":     "gs://marin-us-east5/tomat",
    "us-central1":  "gs://marin-us-central1/tomat",
    "us-east1":     "gs://marin-us-east1/tomat",
}


def _region_data_eligibility(data_labels: list[str]) -> dict[str, list[str]]:
    """For each region, return list of `data_labels` whose cache is fully present.

    Spec 62 §3 (`any` mode eligibility). A region is eligible for a fire if it
    has caches for ALL requested data_labels. We probe by `gsutil ls <bucket>/cache/<label>/`
    and check for any output.
    """
    present: dict[str, list[str]] = {r: [] for r in _REGION_BUCKETS}
    for region, region_bucket in _REGION_BUCKETS.items():
        for label in data_labels:
            cache_path = f"{region_bucket}/cache/{label}/"
            r = subprocess.run(
                ["gsutil", "ls", cache_path],
                capture_output=True, text=True, timeout=15,
            )
            if r.returncode == 0 and r.stdout.strip():
                present[region].append(label)
    return present


def _eligible_regions(data_labels: list[str]) -> list[str]:
    """Regions where ALL `data_labels` have cache present. Order = `_REGION_BUCKETS` keys."""
    present = _region_data_eligibility(data_labels)
    needed = set(data_labels)
    return [r for r in _REGION_BUCKETS if set(present[r]) >= needed]


def _ckpt_mirror_status(parent_label: str, dst_region: str) -> tuple[bool, int | None]:
    """Check whether `parent_label`'s latest step is already mirrored to `dst_region`.

    Returns (is_present, latest_step). is_present is True iff the dst-bucket has
    SOME step-N dir matching the latest step in the canonical bucket. Used by `auto`
    to skip a redundant mirror.
    """
    src_bucket = _resolve_run_bucket(parent_label)
    if src_bucket is None:
        return False, None
    src_root = f"{src_bucket}/results/{parent_label}/checkpoints/{parent_label}"
    listing = subprocess.run(
        ["gcloud", "storage", "ls", f"{src_root}/"],
        capture_output=True, text=True, timeout=30,
    )
    if listing.returncode != 0:
        return False, None
    available = sorted({
        int(m.group(1)) for m in re.finditer(r"step-(\d+)/?", listing.stdout)
    })
    if not available:
        return False, None
    latest = available[-1]
    dst_bucket = _REGION_BUCKETS.get(dst_region)
    if dst_bucket is None:
        return False, latest
    dst_step = f"{dst_bucket}/results/{parent_label}/checkpoints/{parent_label}/step-{latest}"
    probe = subprocess.run(
        ["gsutil", "ls", f"{dst_step}/"],
        capture_output=True, text=True, timeout=15,
    )
    return probe.returncode == 0 and bool(probe.stdout.strip()), latest


def _resolve_region_strategy(
    *,
    region_strategy: str | None,
    resume_mode: bool,
    data_labels: list[str],
    tpu: str,
    zone: str | None,
    region: str | None,
    parent_label: str | None,
    label: str,
) -> dict:
    """Spec 62 — resolve region-strategy + perform pre-flight.

    Returns a dict for `_record_train_fire_to_r2`'s manifest extension:
        {
            "region_strategy": "any" | "auto" | "explicit",
            "region_eligible": [...],          # data-label-eligible regions
            "region_picked": str | None,       # `auto` only
            "region_avail_snapshot": {...} | None,
            "pre_flight_mirrors": {...},
        }
    Mutates: nothing — caller reads `region_picked` / `region_eligible` to update
    the iris `--region`/`--zone` args.

    NOTE: pre-flight ckpt mirror is only run for `auto` mode resumes. From-scratch
    fires don't have a ckpt to mirror; `any` fires with multi-region eligibility
    don't mirror ckpts (would be N× ckpt size — opt-in only).
    """
    # Default per mode (spec 62 §3 final paragraph).
    if region_strategy is None:
        region_strategy = "auto" if resume_mode else "any"

    # Validation.
    if region_strategy == "any" and zone:
        raise click.UsageError(
            "--region-strategy any incompatible with --zone — use "
            "--region-strategy explicit to pin a single zone")
    if region_strategy == "explicit" and not (zone or region):
        raise click.UsageError(
            "--region-strategy explicit requires --zone or --region")

    info: dict = {
        "region_strategy": region_strategy,
        "region_eligible": [],
        "region_picked": None,
        "region_avail_snapshot": None,
        "pre_flight_mirrors": {},
    }

    if region_strategy == "explicit":
        # Caller drives everything; we just record the strategy.
        err(f"[region-strategy explicit] zone={zone!r} region={region!r}")
        return info

    # Build eligible region set from data-label cache presence.
    err(f"[region-strategy {region_strategy}] checking cache presence for "
        f"data_labels={data_labels}")
    eligible = _eligible_regions(data_labels)
    if not eligible:
        raise click.UsageError(
            f"no region has all caches for data_labels={data_labels}. "
            f"Run `tomat cache mirror -l '<label>'` to seed a region first, "
            f"or pass --region-strategy explicit to bypass eligibility check.")
    # If the caller passed --region as a filter, intersect.
    user_filter = [r.strip() for r in (region or "").split(",") if r.strip()]
    if user_filter:
        eligible = [r for r in eligible if r in user_filter]
        if not eligible:
            raise click.UsageError(
                f"no eligible regions after --region filter "
                f"{user_filter}; check data-label cache presence")
    err(f"[region-strategy {region_strategy}] eligible regions: {eligible}")
    info["region_eligible"] = eligible

    if region_strategy == "any":
        # Iris picks among eligible; no ckpt mirror (from-scratch).
        err(f"[region-strategy any] firing with --region {' --region '.join(eligible)}")
        return info

    # `auto` — probe + pick + pre-mirror.
    snapshot = _probe_iris_avail_by_region(tpu, eligible_regions=eligible)
    info["region_avail_snapshot"] = {
        "ready": snapshot,
        "tpu": tpu,
    }
    if not snapshot:
        # Fallback: no region has READY capacity right now. Pick the first
        # eligible region; iris's --queue / autoscaler will handle the wait.
        picked = eligible[0]
        err(f"[region-strategy auto] iris-avail returned 0 READY across "
            f"{eligible}; defaulting to {picked} (eligible[0])")
    else:
        # Highest READY; tie-break by eligible-list order.
        picked = max(eligible, key=lambda r: (snapshot.get(r, 0), -eligible.index(r)))
        err(f"[region-strategy auto] avail snapshot {snapshot} → picked {picked}")
    info["region_picked"] = picked

    # Pre-mirror parent ckpt to the picked region if we're resuming.
    if resume_mode and parent_label:
        present, latest = _ckpt_mirror_status(parent_label, picked)
        if present:
            err(f"[region-strategy auto] parent {parent_label}@step-{latest} "
                f"already in {picked}; skipping mirror")
            info["pre_flight_mirrors"]["ckpt"] = {
                "label": parent_label, "step": latest,
                "to": picked, "skipped_existing": True,
            }
        elif latest is None:
            err(f"[region-strategy auto] could not find parent {parent_label}'s "
                f"ckpts in any canonical bucket; skipping mirror")
        else:
            dst_bucket = _REGION_BUCKETS[picked]
            err(f"[region-strategy auto] mirroring {parent_label}@step-{latest} "
                f"→ {dst_bucket}")
            r = subprocess.run(
                [str(Path(__file__).resolve()), "ckpt", "mirror",
                 parent_label, "--to", dst_bucket, "-s", str(latest)],
                capture_output=False,
            )
            if r.returncode != 0:
                raise click.UsageError(
                    f"ckpt mirror failed (rc={r.returncode}); cannot fire in "
                    f"{picked} with stale parent ckpt — re-run after fixing or "
                    f"use --region-strategy explicit")
            info["pre_flight_mirrors"]["ckpt"] = {
                "label": parent_label, "step": latest,
                "to": picked, "skipped_existing": False,
            }
    return info


def _probe_iris_avail_by_region(
    tpu: str, eligible_regions: list[str] | None = None,
) -> dict[str, int]:
    """Probe iris autoscaler for READY counts per region for a given TPU shape.

    Returns: region → max READY count across all pools in that region for this TPU.
    Filters to `eligible_regions` if provided. Mirrors the regex matching in
    `tomat train --queue` (pool naming: `tpu_<chip>-<class>_<size>-<zone>`).
    """
    try:
        chip, size = tpu.rsplit("-", 1)
    except ValueError:
        chip, size = tpu, ""
    pool_re = re.compile(rf"^tpu_{re.escape(chip)}-\w+_{re.escape(size)}-(.+)$")
    probe = subprocess.run(
        [IRIS_BIN, "--cluster=marin", "rpc", "controller", "get-autoscaler-status"],
        cwd=str(MARIN_DIR), capture_output=True, text=True, timeout=90,
    )
    by_region: dict[str, int] = {}
    if probe.returncode != 0:
        err(f"[region-strategy] iris-avail probe failed: rc={probe.returncode}")
        return by_region
    try:
        data = json.loads(strip_iris_log(probe.stdout).strip())
    except Exception as e:
        err(f"[region-strategy] iris-avail parse failed: {e}")
        return by_region
    for p in _walk_pools(data):
        if p["status"] != "available" or p["ready"] <= 0:
            continue
        m = pool_re.match(p["name"])
        if not m:
            continue
        # Pool zone (e.g. `us-east5-b`). Region = strip trailing -<letter>.
        pool_zone = m.group(1)
        region = re.sub(r"-[a-z]$", "", pool_zone)
        if eligible_regions and region not in eligible_regions:
            continue
        by_region[region] = max(by_region.get(region, 0), p["ready"])
    return by_region


@cache_grp.command("mirror")
@click.option("-l", "--data-label", default="train-full-v3", help="data label whose cache to mirror. Comma-separated → mirrors the UNION cache at `<source>/cache/<+-joined>/` (commas in the flag value, `+` on disk).")
@click.option("-s", "--source", default=_CACHE_SRC_DEFAULT, show_default=True, help="canonical source bucket")
@click.option("-t", "--targets", default=None, help="comma-separated target bucket prefixes (default: all known regional targets)")
@click.option("--splits", default="train,validation", show_default=True, help="comma-separated split names under the cache root")
@click.option("-d", "--dry-run", is_flag=True, help="print rsync commands without running")
def cache_mirror(data_label: str, source: str, targets: str | None, splits: str, dry_run: bool):
    """Mirror `<source>/cache/<data_label>/{split}/` to each target via `gsutil rsync`.

    Idempotent — re-running skips files that already exist with matching size+md5.
    Sizes are typically dominated by `<split>/input_ids/` (~50 GB for train-full-v3).
    """
    tgt_list = (
        [t.strip() for t in targets.split(",") if t.strip()]
        if targets else list(_CACHE_TARGETS.keys())
    )
    split_list = [s.strip() for s in splits.split(",") if s.strip()]
    # Multi-shard union labels (commas in `--data-label`) live at
    # `cache/<a+b+c>/` on disk — same `+`-join as `train_tomat_tpu.py:
    # _label_for_path` so all three (build/mirror/train) agree.
    label_for_path = data_label.replace(",", "+")
    print(f"[cache mirror] data_label={data_label} source={source}")
    for tgt in tgt_list:
        note = _CACHE_TARGETS.get(tgt, ["(custom)"])
        print(f"  → {tgt}  ({', '.join(note)})")
    print(f"  splits: {split_list}")

    for tgt in tgt_list:
        for split in split_list:
            src = f"{source}/cache/{label_for_path}/{split}/"
            dst = f"{tgt}/cache/{data_label}/{split}/"
            cmd = ["gsutil", "-m", "rsync", "-r", src, dst]
            print()
            print(f"# {src} → {dst}")
            print(" ", " ".join(cmd))
            if dry_run:
                continue
            r = subprocess.run(cmd)
            if r.returncode != 0:
                err(f"[FAIL] gsutil rsync rc={r.returncode}; aborting mirror")
                sys.exit(r.returncode)


@cache_grp.command("build")
@click.option("-l", "--data-label", default="train-full-v3", help="data label whose cache to build. Comma-separated → builds the UNION cache at `<bucket>/cache/<+-joined>/` from all components' parquets.")
@click.option("--bucket", default=None, help=f"bucket where the cache should land (default: {GCS_BUCKET})")
@click.option("--lmq-path", default=None, help="TOMAT_LMQ_PATH (default = {bucket}/codecs/lmq-v2-16k.npz)")
@click.option("--cpu", default=16, type=int, help="iris --cpu")
@click.option("--memory", default="64GB", show_default=True, help="iris --memory")
@click.option("-n", "--job-name", default=None, help="iris --job-name override (default: `cache-build-<label>-<region>`; auto-shortened to `cache-build-<hash>-<region>` when the natural name exceeds 63 chars, the k8s DNS-label cap).")
@click.option("--zone", default=None, help="iris --zone (e.g. europe-west4-a); pin to keep the build local to the cache region.")
@click.option("--region", default=None, help="iris --region (e.g. europe-west4).")
@click.option("-e", "--env", "extra_env", multiple=True, help="extra env var KEY=VAL")
@click.option("-d", "--dry-run", is_flag=True, help="print iris cmd without firing")
def cache_build(
    data_label: str,
    bucket: str | None,
    lmq_path: str | None,
    cpu: int,
    memory: str,
    job_name: str | None,
    zone: str | None,
    region: str | None,
    extra_env: tuple[str, ...],
    dry_run: bool,
):
    """Build a Levanter cache from tokenized parquets without burning TPU time.

    Fires a CPU-only iris job that runs `train_tomat_tpu.py` with
    `TOMAT_BUILD_CACHE_ONLY=1` — short-circuits before `train_lm_main`,
    materializes `cache/<data_label>/{train,validation}/`, exits.

    Use this once per (data_label, bucket) — chains naturally after the
    Modal tokenize pipeline, decouples build from train, avoids the
    "trainer dies mid-build and leaves the cache half-built" failure mode.
    """
    bucket = bucket or GCS_BUCKET
    lmq_path = lmq_path or f"{bucket}/codecs/lmq-v2-16k.npz"
    wandb_key = os.environ.get("WANDB_API_KEY", "<WANDB_API_KEY>")
    # Comma-joined labels (multi-shard union) → `+`-joined for paths.
    # `_label_for_path` mirrors `train_tomat_tpu.py:_label_for_path` so the
    # cache lands at the SAME directory both ends would derive.
    label_for_path = data_label.replace(",", "+")
    region_suffix = bucket.rsplit('/', 1)[0].rsplit('-', 1)[-1]
    if job_name is None:
        natural = f"cache-build-{label_for_path}-{region_suffix}"
        # k8s DNS-label limit: 63 chars. Multi-shard unions exceed it
        # (4 × `train-full-v3*` shards → ~99 chars). Auto-shorten by
        # hashing the label and keeping the components count.
        if len(natural) <= 63:
            job_name = natural
        else:
            import hashlib
            parts = [p for p in data_label.split(",") if p.strip()]
            sha = hashlib.sha1(label_for_path.encode()).hexdigest()[:8]
            job_name = f"cache-build-{len(parts)}x-{sha}-{region_suffix}"
            print(f"[tomat cache build] natural job-name {natural!r} "
                  f"({len(natural)}>63 chars); using {job_name!r}")

    env_vars: list[tuple[str, str]] = [
        ("WANDB_API_KEY", wandb_key),
        ("TOMAT_BUCKET", bucket),
        ("TOMAT_LABEL", data_label),
        ("TOMAT_RESULTS_LABEL", job_name),
        ("TOMAT_MODEL", "200M"),       # only used to build the LmDataConfig; doesn't affect cache contents
        ("TOMAT_STEPS", "1"),          # ditto
        ("TOMAT_BATCH_SIZE", "128"),
        ("TOMAT_SEED", "42"),
        ("TOMAT_LMQ_PATH", lmq_path),
        ("TOMAT_DENSITY_LOSS_TYPE", "emd"),
        ("TOMAT_DENSITY_ONLY_LOSS", "1"),
        ("TOMAT_LR", "3e-4"),
        ("TOMAT_LR_SCHEDULE", "constant"),
        ("TOMAT_WARMUP", "0.05"),
        ("TOMAT_VAL_SEQS", "256"),
        ("TOMAT_PROFILE", "0"),
        ("TOMAT_GRADIENT_CHECKPOINTING", "1"),
        ("TOMAT_CACHE_DIR", f"{bucket}/cache/{label_for_path}/"),
        ("TOMAT_BUILD_CACHE_ONLY", "1"),
        ("MARIN_I_WILL_PAY_FOR_ALL_FEES", "1"),
    ]
    for kv in extra_env:
        if "=" not in kv:
            err(f"--env {kv!r}: expected KEY=VAL")
            sys.exit(1)
        k, v = kv.split("=", 1)
        env_vars.append((k, v))

    cmd = [
        IRIS_BIN, "--cluster=marin", "job", "run",
        "--cpu", str(cpu), "--memory", memory, "--disk", "100GB", "--enable-extra-resources", "--priority", "interactive",
    ]
    for z in (zone or "").split(","):
        if z := z.strip():
            cmd += ["--zone", z]
    for r in (region or "").split(","):
        if r := r.strip():
            cmd += ["--region", r]
    for k, v in env_vars:
        cmd += ["--env-vars", k, v]
    cmd += [
        "--no-wait", "--no-terminate-on-exit",
        "--job-name", job_name,
        "--", "python", "train_tomat_tpu.py",
    ]
    if dry_run:
        pretty = " ".join("'<WANDB_API_KEY>'" if a == wandb_key else a for a in cmd)
        print(f"# {job_name} (cache-build only)")
        print(f"  cd {MARIN_DIR}")
        print(f"  {pretty}")
        return
    if wandb_key == "<WANDB_API_KEY>":
        err("WANDB_API_KEY not set in env")
        sys.exit(1)
    r = subprocess.run(cmd, cwd=str(MARIN_DIR), capture_output=True, text=True)
    if r.returncode != 0:
        err(f"[FAIL launch {job_name}] rc={r.returncode}\n{r.stderr[-1000:]}")
        sys.exit(r.returncode)
    print(f"[launched cache-build {job_name} → {bucket}/cache/{label_for_path}/]")


@cli.group("ckpt")
def ckpt_grp():
    """Manage training-run checkpoints on GCS: mirror across regions, list, delete."""


def _resolve_run_bucket(run_label: str) -> str | None:
    """Find which canonical bucket a run's ckpts live in by checking each."""
    for bkt in (GCS_BUCKET, "gs://marin-us-east5/tomat",
                "gs://marin-us-central1/tomat", "gs://marin-us-east1/tomat"):
        path = f"{bkt}/results/{run_label}/checkpoints/{run_label}/"
        r = subprocess.run(
            ["gcloud", "storage", "ls", path],
            capture_output=True, text=True, timeout=30,
        )
        if r.returncode == 0 and r.stdout.strip():
            return bkt
    return None


@ckpt_grp.command("mirror")
@click.argument("run_label")
@click.option("--from", "src_bucket", default=None,
              help="source bucket (autodetected if omitted by ls'ing the canonical buckets)")
@click.option("--to", "dst_bucket", required=True,
              help="destination bucket (e.g. gs://marin-us-east5/tomat)")
@click.option("-s", "--step", default="latest",
              help="step to mirror: a positive int, 'latest', or 'all'. Default 'latest'.")
@click.option("-d", "--dry-run", is_flag=True, help="print gcloud commands without running")
def ckpt_mirror(run_label: str, src_bucket: str | None, dst_bucket: str, step: str, dry_run: bool):
    """Copy a run's checkpoint(s) from one bucket to another (one-shot, parallelized).

    Use case: when eval-side TPU capacity is in a different region than the
    training bucket, mirror the ckpt once instead of paying cross-region
    egress on every eval that loads it. See [[cross-region-eval-egress]].

    Examples:
      tomat ckpt mirror train-mg-3-cos-emd --to gs://marin-us-east5/tomat
      tomat ckpt mirror train-mg-1 -s 9999 --to gs://marin-us-east5/tomat
      tomat ckpt mirror cont33k -s all --to gs://marin-us-east5/tomat
    """
    if src_bucket is None:
        src_bucket = _resolve_run_bucket(run_label)
        if src_bucket is None:
            err(f"could not find {run_label!r} ckpts in any canonical bucket; "
                f"pass --from explicitly")
            sys.exit(1)
        err(f"[ckpt mirror] autodetected source: {src_bucket}")
    src_bucket = src_bucket.rstrip("/")
    dst_bucket = dst_bucket.rstrip("/")
    if src_bucket == dst_bucket:
        err(f"[ckpt mirror] src == dst ({src_bucket}); nothing to do")
        return

    src_ckpt_root = f"{src_bucket}/results/{run_label}/checkpoints/{run_label}"
    dst_ckpt_root = f"{dst_bucket}/results/{run_label}/checkpoints/{run_label}"

    # Enumerate step-* dirs on the source.
    listing = subprocess.run(
        ["gcloud", "storage", "ls", f"{src_ckpt_root}/"],
        capture_output=True, text=True, timeout=30,
    )
    if listing.returncode != 0:
        err(f"[ckpt mirror] failed to list {src_ckpt_root}/: {listing.stderr}")
        sys.exit(1)
    available = sorted({
        int(m.group(1)) for m in re.finditer(r"step-(\d+)/?", listing.stdout)
    })
    if not available:
        err(f"[ckpt mirror] no step-* ckpts at {src_ckpt_root}/")
        sys.exit(1)

    if step.lower() in ("latest", "final", "last"):
        chosen = [available[-1]]
    elif step.lower() == "all":
        chosen = available
    else:
        n = int(step)
        if n in available:
            chosen = [n]
        elif (n - 1) in available:
            err(f"[ckpt mirror] WARN: step-{n} not found; using step-{n-1} (Levanter OBO)")
            chosen = [n - 1]
        else:
            err(f"[ckpt mirror] step-{n} not found. Available (last 10): {available[-10:]}")
            sys.exit(1)

    print(f"[ckpt mirror] {run_label}: {src_bucket} → {dst_bucket}")
    print(f"  steps to copy: {chosen}")
    for s in chosen:
        # `gcloud storage cp -r src dst` semantics: `src` is treated as a
        # DIRECTORY and copied INTO `dst`. So `cp -r step-N/ step-N/`
        # produces `step-N/step-N/…`. Pass the *parent* as dst so gcloud
        # creates the step-N dir for us.
        src = f"{src_ckpt_root}/step-{s}"
        dst = f"{dst_ckpt_root}/"
        cmd = ["gcloud", "storage", "cp", "-r", src, dst]
        print()
        print(f"# step-{s}")
        print(" ", " ".join(cmd))
        if dry_run:
            continue
        r = subprocess.run(cmd)
        if r.returncode != 0:
            err(f"[FAIL] cp rc={r.returncode}; aborting mirror")
            sys.exit(r.returncode)
    if not dry_run:
        print(f"[ckpt mirror] done: {len(chosen)} step(s) copied")


@ckpt_grp.command("ls")
@click.argument("run_label")
@click.option("--bucket", "bucket_override", default=None,
              help="bucket to inspect (autodetect if omitted)")
def ckpt_ls(run_label: str, bucket_override: str | None):
    """List checkpoint steps + sizes for a run."""
    bkt = bucket_override or _resolve_run_bucket(run_label)
    if bkt is None:
        err(f"could not find {run_label!r}")
        sys.exit(1)
    base = f"{bkt}/results/{run_label}/checkpoints/{run_label}"
    listing = subprocess.run(
        ["gcloud", "storage", "ls", "--long", f"{base}/"],
        capture_output=True, text=True, timeout=30,
    )
    print(f"# {run_label} in {bkt}")
    steps = sorted({
        int(m.group(1)) for m in re.finditer(r"step-(\d+)/?", listing.stdout)
    })
    print(f"  {len(steps)} step-* dirs: {steps[:5]}{'...' if len(steps) > 10 else ''}{steps[-5:] if len(steps) > 10 else ''}")
    # Total size
    du = subprocess.run(
        ["gcloud", "storage", "du", "-s", f"{bkt}/results/{run_label}/"],
        capture_output=True, text=True, timeout=60,
    )
    print(f"  size: {du.stdout.strip()}")


@cli.group("fires")
def fires_grp():
    """Fire-script generators (spec 61, Phase 1.6).

    `tomat fires new --parent P [--name N]` emits a `scripts/fires/<N>.sh`
    with all knobs pre-filled from parent P's wandb config. The generated
    script calls `tomat train --resume --parent P …` so the FROZEN_ON_RESUME
    guard fires at submit time.

    LIMITATION (until Phase 2 lands): wandb config is itself overwritten on
    each resume, so reading from it may capture a CONTAMINATED state (the
    bin5 case: `bin5-extend-10k.sh` overwrote bin5's TS0123 mid-life config
    back to TS0). Generator emits a WARNING when this is suspected. With
    Phase 2's editable runs DB, the parent's actual prevailing config will
    be authoritative + uncontaminated."""


def _bin_path_for_fire_script() -> str:
    """Path to the python interpreter that should run `tomat train`."""
    return "/Users/ryan/c/oa/marin/.venv/bin/python"


def _check_parent_contamination(parent_run, parent_cfg: dict) -> list[str]:
    """Heuristic warnings about parent's wandb config trustworthiness.

    Wandb config is overwritten on each resume, so a run with N writes
    may have lost its mid-life state. We can't fully detect this, but we
    can surface signals:

      - Run state is 'crashed' or 'failed' (the last fire may have been
        an aborted experiment that contaminated config).
      - lifecycle/trainer_starts summary > 1 (multiple Levanter resumes
        have overwritten config in sequence).
    """
    warnings: list[str] = []
    state = (parent_run.state or "").lower() if hasattr(parent_run, "state") else ""
    if state in ("crashed", "failed"):
        warnings.append(
            f"parent state is {state!r} — its last fire may have been an "
            "aborted experiment whose config now reflects only the failed "
            "fire's settings, not the parent's prevailing state."
        )
    try:
        summary = parent_run.summary
        starts = summary.get("lifecycle/trainer_starts", 0)
        if isinstance(starts, (int, float)) and starts > 1:
            warnings.append(
                f"parent has {int(starts)} recorded `trainer_started` "
                "events — wandb config reflects the LAST fire only. "
                "If any prior fire used different knobs (data label, σ, "
                "etc.), they will NOT appear in the generated script."
            )
    except Exception:
        pass
    return warnings


@fires_grp.command("new")
@click.option("--parent", "parent_label", required=True,
              help="parent run-id this fire resumes from. Generator pulls "
                   "all FROZEN_ON_RESUME knobs from its wandb config.")
@click.option("-N", "--name", "fire_name", default=None,
              help="output script basename (no .sh). Defaults to `<parent>-cont-<utc>`.")
@click.option("-D", "--data-label", "data_label_override", default=None,
              help="override parent's data label (will require --allow-config-change "
                   "in the generated `tomat train` call).")
@click.option("-s", "--steps", "steps_override", default=None, type=int,
              help="override parent's num_train_steps. Required for resumes that "
                   "want to extend (parent.num_train_steps is the *original* horizon, "
                   "not necessarily the resume target).")
@click.option("--sigma", "sigma_override", default=None, type=int,
              help="override parent's TOMAT_MG_KL_SIGMA (will require "
                   "--allow-config-change=loss.kl_sigma in the train call).")
@click.option("--tpu", "tpu_override", default=None,
              help="override TPU shape (e.g. v5p-16). Defaults to parent's last "
                   "iris fire's TPU if discoverable; else v6e-16.")
@click.option("--zone", "zone_override", default=None,
              help="override iris --zone. Defaults to parent's last zone if "
                   "discoverable; else us-east5-b (v6e) / us-east5-a (v5p).")
@click.option("--print", "print_only", is_flag=True,
              help="print the generated script to stdout instead of writing.")
def fires_new(
    parent_label: str,
    fire_name: str | None,
    data_label_override: str | None,
    steps_override: int | None,
    sigma_override: int | None,
    tpu_override: str | None,
    zone_override: str | None,
    print_only: bool,
):
    """Generate a fire script that resumes from a parent run.

    Reads parent's wandb config + writes `scripts/fires/<name>.sh` invoking
    `tomat train --resume --parent <parent> …` with all knobs pre-filled.
    Drops the copy-paste-fire-script failure mode that caused the 4 bin5
    bugs this week. See spec 61 §1.6."""
    import datetime as _dt
    parent_run, parent_cfg = _fetch_parent_wandb_run(parent_label)
    if parent_run is None:
        err(f"--parent {parent_label!r}: no matching wandb run found.")
        sys.exit(1)
    # Heuristic contamination check.
    warnings = _check_parent_contamination(parent_run, parent_cfg)
    if warnings:
        err(f"[tomat fires new] WARNING: parent {parent_label!r} may have a "
            f"contaminated wandb config:")
        for w in warnings:
            err(f"  - {w}")
        err("  the generated script will reflect what's IN wandb config now, "
            "which may not be the parent's actual prevailing state. Verify "
            "knobs manually against the parent's earlier fire scripts / "
            "annotations.ts before firing.")
        err("")

    # Pull knobs from parent's wandb config. Map to CLI flag values.
    parent_cache_dir = _dot_get(parent_cfg, "data.cache_dir") or ""
    import re as _re
    pm = _re.search(r"/cache/([^/]+)/?$", parent_cache_dir.rstrip("/"))
    parent_data_label = (pm.group(1) if pm else "train-full-v3").replace("+", ",")
    parent_lr           = _dot_get(parent_cfg, "optimizer.learning_rate") or 3e-4
    parent_lr_schedule  = _dot_get(parent_cfg, "optimizer.lr_schedule")   or "constant"
    parent_warmup       = _dot_get(parent_cfg, "optimizer.warmup")        or 0.0
    parent_bs           = _dot_get(parent_cfg, "trainer.train_batch_size") or 128
    parent_steps        = _dot_get(parent_cfg, "trainer.num_train_steps")  or 10000
    # σ + loss-type are in TOMAT_* env-vars, captured by the trainer's new
    # wandb config write (task #269). Pre-#269 runs won't have these.
    parent_sigma = _dot_get(parent_cfg, "tomat.env.mg_kl_sigma")
    parent_loss  = _dot_get(parent_cfg, "tomat.env.mg_loss_type")
    parent_mode  = _dot_get(parent_cfg, "tomat.env.mg_mode")
    parent_prior = _dot_get(parent_cfg, "tomat.env.mg_mask_prior")

    # Resolve overrides + intended-deltas list.
    data_label = data_label_override or parent_data_label
    sigma = sigma_override or (int(parent_sigma) if parent_sigma else None)
    steps = steps_override or parent_steps
    # Default new-fire steps: parent's last clean step + some headroom.
    # (We can't easily resolve parent's last clean step here, so default to
    # parent.steps + 10% if no override.)
    if not steps_override:
        steps = int(parent_steps * 1.1)  # +10% extension
    tpu = tpu_override or "v6e-16"
    zone = zone_override or ("us-east5-a" if tpu.startswith("v5p") else "us-east5-b")
    # Auto fire-name if not given.
    if not fire_name:
        ts = _dt.datetime.utcnow().strftime("%Y%m%dT%H%M%S")
        fire_name = f"{parent_label.replace('train-mg-kl-', '').replace('train-mg-', '')}-cont-{ts}"
    new_label = fire_name if fire_name.startswith("train-") else f"train-mg-{fire_name}"
    # Identify intentional deltas (drive --allow-config-change).
    allow_keys: list[str] = []
    if data_label_override and data_label_override != parent_data_label:
        allow_keys.append("data.cache_dir")
    if sigma_override and sigma_override != parent_sigma:
        # σ isn't in FROZEN_ON_RESUME yet (it's in tomat.env not optimizer.*),
        # but mark it as intended.
        pass

    allow_flag = (f" --allow-config-change={','.join(allow_keys)}"
                  if allow_keys else "")
    # Build script body. We emit a tomat-train invocation, not raw iris,
    # so the FROZEN_ON_RESUME guard fires at submit time.
    PY = _bin_path_for_fire_script()
    sigma_line = f"    --env TOMAT_MG_KL_SIGMA={sigma} \\\n" if sigma else ""
    loss_line  = f"    --env TOMAT_MG_LOSS_TYPE={parent_loss} \\\n" if parent_loss else ""
    mode_line  = f"    --env TOMAT_MG_MODE={parent_mode} \\\n" if parent_mode else ""
    prior_line = f"    --env TOMAT_MG_MASK_PRIOR={parent_prior} \\\n" if parent_prior else ""

    script = f"""#!/bin/bash
# Auto-generated by `tomat fires new --parent {parent_label}`.
# Spec 61, Phase 1.6: parent-aware fire script. The `tomat train --parent`
# guard verifies parent's wandb config matches this fire's settings before
# iris-submitting; any drift outside `--allow-config-change` aborts.
#
# Parent: {parent_label}
#   data label:       {parent_data_label}
#   LR:               {parent_lr} ({parent_lr_schedule})
#   warmup:           {parent_warmup}
#   batch size:       {parent_bs}
#   sigma (if KL):    {parent_sigma}
#   loss type:        {parent_loss}
#
# Intended deltas vs parent: {allow_keys or 'none'}
#
# Verify the knobs above match the parent's PREVAILING config (not just
# its latest wandb-config overwrite) — wandb's config is itself
# overwritten on each resume, so old multi-fire parents (like bin5) may
# have a contaminated config. See spec 61 §2 for the eventual Phase 2
# fix (editable runs DB).
set -euo pipefail
cd "$(dirname "$0")/../.."

export WANDB_API_KEY="${{WANDB_API_KEY:-$(grep -E '^password' ~/.netrc 2>/dev/null | head -1 | awk '{{print $2}}')}}"

exec {PY} ./tomat train \\
    --resume \\
    --parent {parent_label}{allow_flag} \\
    -D {data_label} \\
    -m 200M \\
    -T {tpu} \\
    --zone {zone} \\
    -s {steps} \\
    -b {parent_bs} \\
    --lr {parent_lr} \\
    --lr-schedule {parent_lr_schedule} \\
    --warmup 0 \\
{mode_line}{prior_line}{loss_line}{sigma_line}    {new_label}
"""
    if print_only:
        print(script)
        return
    # Write to scripts/fires/<name>.sh.
    out_path = Path("scripts/fires") / f"{fire_name}.sh"
    if out_path.exists():
        err(f"[tomat fires new] {out_path} exists; refusing to overwrite. "
            f"pass `--print` to see the generated script.")
        sys.exit(1)
    out_path.parent.mkdir(parents=True, exist_ok=True)
    out_path.write_text(script)
    out_path.chmod(0o755)
    print(f"[tomat fires new] wrote {out_path} ({len(script)} bytes)")
    print(f"  parent: {parent_label}")
    print(f"  new label: {new_label}")
    print(f"  TPU: {tpu} ({zone}), steps: {steps}, bs: {parent_bs}, lr: {parent_lr}")
    print(f"  fire: {out_path}")


FIRES_PREFIX = "tomat/fires"
_FIRE_SCHEMA_VERSION = 1


def _git_sha(cwd: Path | None = None) -> str | None:
    """`git rev-parse HEAD` for `cwd` (or PROJECT_ROOT). None on any error."""
    try:
        r = subprocess.run(["git", "rev-parse", "HEAD"], cwd=cwd or PROJECT_ROOT,
                           capture_output=True, text=True, timeout=5)
        return r.stdout.strip() or None if r.returncode == 0 else None
    except Exception:
        return None


def _marin_pin() -> str | None:
    """Marin pin from tomat's uv.lock (NOT `marin/.git/HEAD`).

    The `marin/` dir in tomat is a working clone, not a submodule — running
    `git rev-parse HEAD` inside it walks up to tomat's own .git. The
    authoritative marin pin is the `marin-iris` source revision recorded in
    `uv.lock`.
    """
    lock = PROJECT_ROOT / "uv.lock"
    if not lock.exists():
        return None
    # Cheap regex over the lock file's `[[package]]` blocks. uv writes the
    # source rev as `source.git = "...git+...?rev=<SHA>"`.
    try:
        for chunk in lock.read_text().split("[[package]]"):
            if "marin-iris" not in chunk:
                continue
            m = re.search(r"\?rev=([0-9a-f]{7,40})", chunk)
            if m:
                return m.group(1)
    except Exception:
        pass
    return None


def _fire_id_from_manifest(manifest: dict) -> str:
    """`<UTC-isoformat>-<8-hex-shasum>` (deterministic per manifest body)."""
    import hashlib
    body = {k: v for k, v in manifest.items() if k != "fire_id"}
    canon = json.dumps(body, sort_keys=True, separators=(",", ":")).encode()
    sha = hashlib.sha256(canon).hexdigest()[:8]
    ts = manifest.get("fired_at") or datetime.datetime.now(datetime.timezone.utc)\
        .isoformat(timespec="seconds").replace("+00:00", "Z")
    # Strip `:` from the ts so the fire-id is a valid filename / key.
    return f"{ts.replace(':', '')}-{sha}"


def _record_train_fire_to_r2(
    *,
    label: str,
    parent_label: str | None,
    tpu: str,
    zone: str | None,
    steps: int,
    from_step: int | None,
    region_info: dict | None = None,
    bucket: str = None,
) -> str:
    """In-process equivalent of `tomat fires record` for `tomat train`.

    Same manifest shape as `fires_record` (so `fires ls/show` see both
    sources identically) — just skips re-spawning `tomat`. Substrate is
    always `iris` here (Modal train fires record from the Modal-side
    entrypoint script, not from this CLI path).

    Returns the fire_id on success; raises on R2 failure (caller wraps
    in try/except so the just-submitted iris job isn't disrupted).
    """
    if bucket is None:
        bucket = R2_BUCKET
    fired_at = datetime.datetime.now(datetime.timezone.utc)\
        .isoformat(timespec="seconds").replace("+00:00", "Z")
    manifest: dict = {
        "schema_version": _FIRE_SCHEMA_VERSION,
        "run_id": label,
        "parent_run_id": parent_label,
        "fired_at": fired_at,
        "fired_by": getpass.getuser(),
        "fired_host": platform.node(),
        "fire_argv": sys.argv,
        "git_sha": _git_sha(),
        "marin_pin": _marin_pin(),
        "substrate": "iris",
        "iris": {
            "job_id": f"/{getpass.getuser()}/{label}",
            **({"tpu": tpu} if tpu else {}),
            **({"zone": zone} if zone else {}),
            # Spec 62 — region-strategy fields. Always present (even if `info`
            # is None we record `strategy: "explicit"` as the conservative
            # interpretation, since pre-spec-62 callers behaved that way).
            **(region_info or {"region_strategy": "explicit"}),
        },
        "wandb": {
            "entity": WANDB_PROJECT.split("/")[0],
            "project": WANDB_PROJECT.split("/")[-1],
        },
        "horizon": {
            **({"resume_from_step": from_step} if from_step is not None else {}),
            "target_steps": steps,
        },
    }
    fire_id = _fire_id_from_manifest(manifest)
    manifest["fire_id"] = fire_id
    key = f"{FIRES_PREFIX}/{fire_id}/manifest.json"
    body = json.dumps(manifest, indent=1).encode("utf-8")
    _r2_put_bytes(bucket, key, body, "application/json")
    err(f"[tomat train] recorded fire to s3://{bucket}/{key} ({len(body)} bytes)")
    err(f"  fire_id: {fire_id}")
    return fire_id


@fires_grp.command("record")
@click.option("--run-id", "run_id", required=True,
              help="canonical run name (e.g. 'train-mg-kl-bin5-cont-from-80k-v6e')")
@click.option("--parent", "parent_run_id", default=None,
              help="canonical name of the parent run this fire resumes from. "
                   "Optional for from-scratch fires.")
@click.option("--substrate", type=click.Choice(["iris", "modal"]), required=True,
              help="iris (TPU job) or modal (Modal function call).")
@click.option("--iris-job-id", default=None,
              help="`/<user>/<label>` iris job path. Required for --substrate iris.")
@click.option("--iris-tpu", default=None,
              help="TPU shape (e.g. 'v6e-16'). Recorded for provenance.")
@click.option("--iris-zone", default=None,
              help="iris zone (e.g. 'us-east5-b').")
@click.option("--modal-app", default=None,
              help="Modal App name. Required for --substrate modal.")
@click.option("--modal-fc-id", default=None,
              help="Modal function_call_id. Required for --substrate modal.")
@click.option("--modal-fn", default=None,
              help="Modal function name (e.g. 'train_bakeoff_h200x8').")
@click.option("--wandb-entity", default="open-athena")
@click.option("--wandb-project", default=None,
              help="wandb project name (e.g. 'tomat-lmq-P19').")
@click.option("--wandb-run-id", default=None,
              help="wandb run id (the short hash, not the display name).")
@click.option("--resume-from-step", type=int, default=None,
              help="parent ckpt step we're resuming from (None for from-scratch).")
@click.option("--target-steps", type=int, default=None,
              help="trainer's `num_train_steps` for this fire (final horizon).")
@click.option("--intended-delta", "intended_deltas", multiple=True,
              help="key=from->to triple, repeatable. Example: "
                   "--intended-delta 'data.cache_dir=train-full-v3->train-full-v3,...shard3'")
@click.option("--notes", default=None, help="free-form human context.")
@click.option("-b", "--bucket", default=R2_BUCKET, help="R2 bucket")
@click.option("--dry-run", is_flag=True,
              help="print the manifest JSON instead of PUTing.")
def fires_record(
    run_id: str, parent_run_id: str | None, substrate: str,
    iris_job_id: str | None, iris_tpu: str | None, iris_zone: str | None,
    modal_app: str | None, modal_fc_id: str | None, modal_fn: str | None,
    wandb_entity: str, wandb_project: str | None, wandb_run_id: str | None,
    resume_from_step: int | None, target_steps: int | None,
    intended_deltas: tuple[str, ...], notes: str | None, bucket: str, dry_run: bool,
):
    """Write a fire-manifest record to R2 (spec 61 §2.1).

    A fire is one submission of a training (or eval) job to its execution
    substrate (iris OR Modal). Each fire's manifest is frozen at submit time
    and immutable thereafter; the parquet history that fire produces gets
    appended alongside it as the trainer runs.

    Calling convention: invoke right after `iris job run` / `modal run`
    succeeds (i.e. the submission landed). The manifest then carries the
    substrate's job-id, the parent linkage, and enough metadata to
    reconstruct what we tried to do — independent of whether the fire
    actually trained anything.

    Wire-in points:
        - `scripts/fires/*.sh` SHOULD call this post-`iris job run`.
        - `tomat train` will call this internally (Phase 2 follow-up).
    """
    if substrate == "iris" and not iris_job_id:
        raise click.UsageError("--substrate iris requires --iris-job-id")
    if substrate == "modal" and not (modal_app and modal_fc_id):
        raise click.UsageError(
            "--substrate modal requires both --modal-app and --modal-fc-id")
    # Parse intended deltas (key=from->to).
    deltas: dict[str, dict] = {}
    for entry in intended_deltas:
        if "=" not in entry or "->" not in entry:
            raise click.UsageError(
                f"--intended-delta {entry!r} must be 'key=from->to'")
        k, rest = entry.split("=", 1)
        frm, to = rest.split("->", 1)
        deltas[k.strip()] = {"from": frm, "to": to}
    fired_at = datetime.datetime.now(datetime.timezone.utc)\
        .isoformat(timespec="seconds").replace("+00:00", "Z")
    manifest: dict = {
        "schema_version": _FIRE_SCHEMA_VERSION,
        "run_id": run_id,
        "parent_run_id": parent_run_id,
        "fired_at": fired_at,
        "fired_by": getpass.getuser(),
        "fired_host": platform.node(),
        "fire_argv": sys.argv,
        "git_sha": _git_sha(),
        "marin_pin": _marin_pin(),
        "substrate": substrate,
    }
    if substrate == "iris":
        manifest["iris"] = {"job_id": iris_job_id}
        if iris_tpu:
            manifest["iris"]["tpu"] = iris_tpu
        if iris_zone:
            manifest["iris"]["zone"] = iris_zone
    else:
        manifest["modal"] = {"app_name": modal_app, "function_call_id": modal_fc_id}
        if modal_fn:
            manifest["modal"]["fn"] = modal_fn
    if wandb_project or wandb_run_id:
        manifest["wandb"] = {"entity": wandb_entity}
        if wandb_project:
            manifest["wandb"]["project"] = wandb_project
        if wandb_run_id:
            manifest["wandb"]["run_id"] = wandb_run_id
    if resume_from_step is not None or target_steps is not None:
        manifest["horizon"] = {}
        if resume_from_step is not None:
            manifest["horizon"]["resume_from_step"] = resume_from_step
        if target_steps is not None:
            manifest["horizon"]["target_steps"] = target_steps
    if deltas:
        manifest["intended_deltas"] = deltas
    if notes:
        manifest["notes"] = notes
    fire_id = _fire_id_from_manifest(manifest)
    manifest["fire_id"] = fire_id
    key = f"{FIRES_PREFIX}/{fire_id}/manifest.json"
    body = json.dumps(manifest, indent=1).encode("utf-8")
    if dry_run:
        print(f"[dry-run] would PUT s3://{bucket}/{key} ({len(body)} bytes)")
        print(body.decode())
        return
    _r2_put_bytes(bucket, key, body, "application/json")
    print(f"[fires record] wrote s3://{bucket}/{key} ({len(body)} bytes)")
    print(f"  fire_id: {fire_id}")
    print(f"  run_id: {run_id}")
    if parent_run_id:
        print(f"  parent: {parent_run_id}")
    print(f"  substrate: {substrate}")
    if substrate == "iris":
        print(f"  iris job: {iris_job_id}")
    else:
        print(f"  modal: {modal_app}::{modal_fn or '?'} fc={modal_fc_id}")


@fires_grp.command("ls")
@click.option("--run-id", "run_filter", default=None,
              help="filter to fires whose run_id matches this substring.")
@click.option("--parent", "parent_filter", default=None,
              help="filter to fires whose parent_run_id matches this substring.")
@click.option("--substrate", default=None,
              type=click.Choice(["iris", "modal"]),
              help="filter by execution substrate.")
@click.option("-n", "--limit", default=20, type=int,
              help="show last N fires (newest first; 0 = all).")
@click.option("-b", "--bucket", default=R2_BUCKET, help="R2 bucket")
@click.option("--json", "as_json", is_flag=True,
              help="emit one JSON object per fire (manifest body, suitable for jq).")
def fires_ls(
    run_filter: str | None, parent_filter: str | None,
    substrate: str | None, limit: int, bucket: str, as_json: bool,
):
    """List recorded fires (spec 61 §2.1).

    Walks `R2/openathena/tomat/fires/<fire-id>/manifest.json` and emits a
    one-row-per-fire table sorted by `fired_at` (newest first), or one JSON
    object per fire under `--json`.

    Filters compose with AND. Empty filter = all.
    """
    # List manifest.json keys under the fires prefix; each manifest sits at
    # `fires/<fire-id>/manifest.json`.
    keys = _r2_list_keys(bucket, FIRES_PREFIX + "/")
    keys = [k for k in keys if k.endswith("/manifest.json")]
    if not keys:
        err("[fires ls] no fires found")
        return
    rows: list[dict] = []
    for k in keys:
        m = _r2_get_json(bucket, k)
        if not isinstance(m, dict):
            err(f"[fires ls] skipping {k}: not a JSON object")
            continue
        if run_filter and run_filter not in (m.get("run_id") or ""):
            continue
        if parent_filter and parent_filter not in (m.get("parent_run_id") or ""):
            continue
        if substrate and m.get("substrate") != substrate:
            continue
        rows.append(m)
    rows.sort(key=lambda r: r.get("fired_at", ""), reverse=True)
    if limit > 0:
        rows = rows[:limit]
    if as_json:
        for r in rows:
            print(json.dumps(r))
        return
    if not rows:
        err("[fires ls] no fires match filters")
        return
    # Tabular output. Columns: fired_at | substrate | run_id | parent | id-tail
    w_run = max((len(r.get("run_id") or "") for r in rows), default=20)
    w_parent = max((len(r.get("parent_run_id") or "") for r in rows), default=10)
    print(f"{'fired_at':<20} {'sub':<5} {'run_id':<{w_run}} "
          f"{'parent_run_id':<{w_parent}} fire_id_tail")
    for r in rows:
        fid = r.get("fire_id") or ""
        tail = fid.split("-")[-1] if "-" in fid else fid
        print(f"{r.get('fired_at',''):<20} "
              f"{(r.get('substrate') or '?'):<5} "
              f"{(r.get('run_id') or ''):<{w_run}} "
              f"{(r.get('parent_run_id') or '-'):<{w_parent}} "
              f"{tail}")


@fires_grp.command("show")
@click.argument("fire_id")
@click.option("-b", "--bucket", default=R2_BUCKET, help="R2 bucket")
def fires_show(fire_id: str, bucket: str):
    """Print a fire's manifest JSON.

    `FIRE_ID` may be the full id (`<UTC>-<8hex>`) or just the 8-hex tail
    when unambiguous.
    """
    if "-" in fire_id and len(fire_id) > 10:
        key = f"{FIRES_PREFIX}/{fire_id}/manifest.json"
    else:
        # Resolve by tail (rare but handy when reading from logs).
        keys = _r2_list_keys(bucket, FIRES_PREFIX + "/")
        matches = [k for k in keys if k.endswith(f"-{fire_id}/manifest.json")]
        if len(matches) == 0:
            err(f"[fires show] no fire matches tail {fire_id!r}")
            sys.exit(1)
        if len(matches) > 1:
            err(f"[fires show] multiple fires match tail {fire_id!r}: "
                f"{[m.split('/')[-2] for m in matches]}")
            sys.exit(1)
        key = matches[0]
    m = _r2_get_json(bucket, key)
    if m is None:
        err(f"[fires show] {key} not found")
        sys.exit(1)
    print(json.dumps(m, indent=2))


