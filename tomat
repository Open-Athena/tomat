@runs.command("status")
@click.argument("substr", required=False)
def runs_status(substr: str | None):
    """Show state/MFU/step/loss for one or all matching runs."""
    import wandb

    api = wandb.Api()
    rs = match_runs(api, substr)
    if not rs:
        err(f"no runs match {substr!r}")
        sys.exit(1)
    summaries = _fetch_summaries(rs, _STATUS_KEYS)
    summaries.sort(key=lambda d: d["created_at"], reverse=True)
    one_line = substr is None or len(summaries) > 1
    # Prefer the actual training step (`global_step`) over wandb's
    # auto-incrementing row counter `_step`. When a run is thrashing on
    # preempts, every `trainer_started` / `cluster_preempt` lifecycle
    # marker fires a separate `log()` call that bumps `_step` without
    # advancing training — last seen: tz-11 showed `_step=3250` while
    # `max(global_step)` was actually 2500. Reporting `_step` overstates
    # progress dramatically in that case.
    #
    # wandb's `summary.global_step` is unreliable too: it captures the
    # LAST value the run logged, which is often a lifecycle marker
    # without `global_step` — comes back `None`. So we walk the history
    # backwards (newest first) for the most recent row that has a real
    # `global_step` value. Bounded to ~50 rows so the call stays fast.
    def _max_global_step(r) -> int | None:
        try:
            # `scan_history` doesn't take a "reverse" knob, but
            # `r.history(samples=N, pandas=False)` returns the last N rows
            # newest-first. Cheaper than scanning the full history.
            rows = r.history(samples=200, keys=["global_step"], pandas=False)
            return max(
                (int(row["global_step"]) for row in rows
                 if row.get("global_step") is not None),
                default=None,
            )
        except Exception:
            return None

    for d in summaries:
        step = d.get("global_step")
        if step is None:
            step = _max_global_step(d["_run"])
        if step is None:
            step = d.get("_step")
        if one_line:
            mfu = d.get("throughput/mfu")
            mfu_s = f"{mfu:5.2f}%" if isinstance(mfu, (int, float)) else "   -  "
            step_s = f"{step:>6}" if isinstance(step, int) else "     ?"
            runtime_h = (d["_runtime"] or 0) / 3600
            print(f"  [{d['state']:8s}] step={step_s} runtime={runtime_h:5.1f}h mfu={mfu_s}  {d['name']}")
        else:
            print(f"name:    {d['name']}")
            print(f"state:   {d['state']}")
            print(f"step:    {step}")
            print(f"runtime: {(d['_runtime'] or 0)/3600:.2f} hr")
            for k in _STATUS_KEYS:
                v = d.get(k)
                if v is not None:
                    print(f"  {k}: {v}")
            print(f"url:     {d['url']}")


def _scan_history_key(r, fk: str) -> list[tuple[int, float]]:
    return [
        (row["eval/mat_nmae/step"], row[fk])
        for row in r.scan_history(keys=["eval/mat_nmae/step", fk], page_size=200)
        if row.get("eval/mat_nmae/step") is not None and row.get(fk) is not None
    ]


def _per_mat_nemd(run_label: str, mat_set: str) -> dict[int, float]:
    """Pull nemd_mean per ckpt from GCS per-mat result JSONs.

    Returns mapping step → NEMD as a percentage (matching the wandb-side
    NMAE values, which are already in %).
    """
    import fsspec
    out: dict[int, float] = {}
    fs = fsspec.filesystem("gcs")
    base = f"marin-eu-west4/tomat/eval/results/{run_label}/{mat_set}"
    if not fs.exists(base):
        return out
    for path in fs.ls(base):
        name = path.rsplit("/", 1)[-1]
        if not (name.startswith("step-") and name.endswith(".json")):
            continue
        # Per-task fan-out (`tomat evals fire --num-tasks N`) produces
        # `step-<N>-task<i>.json`. Strip the optional `-task<i>` so all
        # tasks for the same step roll up together.
        stem = name[len("step-") : -len(".json")]
        if "-task" in stem:
            stem = stem.split("-task", 1)[0]
        try:
            step = int(stem)
        except ValueError:
            continue
        try:
            with fs.open(path, "r") as f:
                d = json.load(f)
            v = d.get("nemd_mean")
            if v is not None:
                out[step] = float(v) * 100.0
        except Exception:
            pass
    return out


@runs.command("nmae")
@click.argument("substr")
@click.option("-s", "--sets", default="val_200,train_200", help="comma-sep mat-sets to show")
def runs_nmae(substr: str, sets: str):
    """Show mat-NMAE + (when available) mat-NEMD curve as a step × {set} table.

    NMAE comes from wandb (`eval/mat_nmae/...` logged by the eval watchdog).
    NEMD comes from per-mat result JSONs in GCS (eval_mat_nmae.py writes both
    when the eval is re-fired with the post-EMD-patch evaluator).
    """
    import wandb

    api = wandb.Api()
    r = require_one(match_runs(api, substr), substr)
    set_list = sets.split(",")
    keys = [f"{s}/{m}" for s in set_list for m in ("mean", "median", "p99")]
    data: dict[int, dict[str, float]] = {}
    with ThreadPoolExecutor(max_workers=min(8, len(keys))) as ex:
        futures = {ex.submit(_scan_history_key, r, f"eval/mat_nmae/{k}"): k for k in keys}
        for fut in as_completed(futures):
            k = futures[fut]
            for s, v in fut.result():
                data.setdefault(s, {})[k] = v

    nemd_by_set: dict[str, dict[int, float]] = {s: _per_mat_nemd(r.name, s) for s in set_list}

    if not data and not any(nemd_by_set.values()):
        err(f"no eval/mat_nmae/* history or NEMD JSONs for {r.name}")
        sys.exit(0)

    print(f"mat-NMAE+NEMD for {r.name} ({len(data)} step points; NEMD where avail)")
    header = "  step  "
    for s in set_list:
        header += f"  {s:>20} NMAE m/med/p99  NEMD"
    print(header)
    all_steps = sorted(set(data) | set().union(*[set(d) for d in nemd_by_set.values()]))
    for step in all_steps:
        d = data.get(step, {})
        line = f"  {step:>5}  "
        for s in set_list:
            ne = nemd_by_set.get(s, {}).get(step)
            ne_s = fmt(ne) if ne is not None else "  -  "
            line += f"  {fmt(d.get(s + '/mean'))}/{fmt(d.get(s + '/median'))}/{fmt(d.get(s + '/p99'))}  {ne_s}"
        print(line)


@runs.command("submissions")
@click.option("-n", "--limit", type=int, default=20, help="show last N records")
@click.option("--label", default=None, help="filter to label substring")
@click.option("--json", "as_json", is_flag=True, help="print raw JSON one per line")
def runs_submissions(limit: int, label: str | None, as_json: bool):
    """Show local SubmissionRecord history (spec 42 Phase A).

    `tomat train` appends one record per successful iris fire to
    `~/.tomat/submissions.jsonl`. This view sorts by `invoked_at` desc and
    shows the queue-wait duration that wandb's `_runtime` hides.
    """
    if not SUBMISSIONS_PATH.exists():
        err(f"no submissions yet at {SUBMISSIONS_PATH}")
        return
    records: list[dict] = []
    with open(SUBMISSIONS_PATH) as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                records.append(json.loads(line))
            except json.JSONDecodeError as e:
                err(f"skipping malformed line: {e}")
    if label is not None:
        records = [r for r in records if label in r.get("label", "")]
    records.sort(key=lambda r: r.get("invoked_at") or 0, reverse=True)
    records = records[:limit]
    if as_json:
        for r in records:
            print(json.dumps(r))
        return
    if not records:
        print("(no matching records)")
        return
    print(f"{'invoked':19}  {'queue':>7}  {'tpu':14}  {'mode':12}  label")
    for r in records:
        ts = datetime.datetime.fromtimestamp(
            r["invoked_at"], tz=datetime.timezone.utc,
        ).strftime("%Y-%m-%d %H:%M:%S")
        qw = r.get("queue_wait_s") or 0
        qw_s = f"{int(qw // 60)}m{int(qw % 60):02d}s" if qw >= 60 else f"{qw:.1f}s"
        print(f"{ts}  {qw_s:>7}  {r.get('tpu', '?'):14}  "
              f"{r.get('mode', '?'):12}  {r.get('label', '?')}")


_TRAJ_DEFAULT_KEYS = "train/loss,eval/loss,throughput/mfu"


@runs.command("traj")
@click.argument("substr")
@click.option("-k", "--keys", default=_TRAJ_DEFAULT_KEYS,
              help="comma-sep metric keys to pull (default: train/loss,eval/loss,throughput/mfu)")
@click.option("-n", "--n-samples", default=20, type=int,
              help="evenly-spaced samples to print (first+last always included). Set 0 to print all.")
@click.option("--csv", is_flag=True, help="emit raw CSV (every row, no sampling)")
def runs_traj(substr: str, keys: str, n_samples: int, csv: bool):
    """Pull metric trajectory(ies) for the matching wandb run.

    Useful when "did training actually descend?" needs a concrete answer.
    With `--csv`, dumps every (step,key,value) for downstream plotting.
    Otherwise prints N evenly-spaced samples + first + last as a compact
    table, indexed by `global_step` (falls back to `_step` if missing).
    """
    import wandb

    api = wandb.Api()
    r = require_one(match_runs(api, substr), substr)
    key_list = [k.strip() for k in keys.split(",") if k.strip()]
    # scan_history can take a `keys` arg but it filters to rows containing
    # ALL listed keys — too strict (rare combined-row cadence). Scan all
    # rows and split per-key here.
    by_key: dict[str, list[tuple[int, float]]] = {k: [] for k in key_list}
    for row in r.scan_history(page_size=1000):
        step = row.get("global_step") or row.get("_step")
        if step is None:
            continue
        for k in key_list:
            v = row.get(k)
            if v is not None:
                by_key[k].append((step, v))
    for k in key_list:
        by_key[k].sort()
    counts = ", ".join(f"{k}={len(by_key[k])}" for k in key_list)
    err(f"{r.name}  ({counts})")

    if csv:
        print("step," + ",".join(key_list))
        # union of all steps that appeared for any key
        all_steps = sorted({s for k in key_list for s, _ in by_key[k]})
        per_key_idx = {k: dict(by_key[k]) for k in key_list}
        for s in all_steps:
            row = [str(s)]
            for k in key_list:
                v = per_key_idx[k].get(s)
                row.append(f"{v}" if v is not None else "")
            print(",".join(row))
        return

    # Pretty table: pick sample steps from the longest series, look up
    # nearest-earlier value for each key (so sparser series like eval/loss
    # still show alongside dense train/loss).
    densest = max(key_list, key=lambda k: len(by_key[k]))
    pts = by_key[densest]
    if not pts:
        err(f"no data for any of {keys!r} in {r.name}")
        sys.exit(1)
    if n_samples <= 0 or len(pts) <= n_samples + 2:
        sampled = pts
    else:
        n = len(pts)
        idxs = sorted(set([0, n - 1] + [int(i * n / n_samples) for i in range(1, n_samples)]))
        sampled = [pts[i] for i in idxs]
    sample_steps = [s for s, _ in sampled]

    def at_or_before(series: list[tuple[int, float]], step: int) -> float | None:
        lo, hi = 0, len(series) - 1
        if hi < 0 or series[0][0] > step:
            return None
        while lo < hi:
            mid = (lo + hi + 1) // 2
            if series[mid][0] <= step:
                lo = mid
            else:
                hi = mid - 1
        return series[lo][1]

    col_w = max(11, max(len(k) for k in key_list))
    header = f"{'step':>8s}  " + "  ".join(f"{k:>{col_w}s}" for k in key_list)
    print(header)
    for s in sample_steps:
        cells = []
        for k in key_list:
            v = at_or_before(by_key[k], s)
            cells.append(f"{v:>{col_w}.4f}" if isinstance(v, (int, float)) else f"{'-':>{col_w}s}")
        print(f"{s:>8d}  " + "  ".join(cells))


def _wandb_url(run_name: str, entity: str | None = None, project: str | None = None) -> str:
    """Compose a wandb run URL. Defaults to the primary project; callers
    holding a wandb.Run can pass `entity=r.entity, project=r.project` so
    archive (PrinceOA) runs link to the right place.
    """
    if entity and project:
        return f"{WANDB_BASE}/{entity}/{project}/runs/{run_name}"
    return f"{WANDB_BASE}/{WANDB_PROJECT}/runs/{run_name}"


def _iris_url(run_name: str) -> str:
    """Iris dashboard URL — path-encodes the leading / and any others."""
    from urllib.parse import quote
    return f"{IRIS_DASHBOARD}/#/job/{quote(f'/{IRIS_USER}/{run_name}', safe='')}"


def _latest_metric(r, key: str) -> tuple[int | None, float | None]:
    """Latest (step, value) for a given wandb metric key, or (None, None)."""
    pts = _scan_history_key(r, key)
    if not pts:
        return (None, None)
    return max(pts, key=lambda p: p[0])


