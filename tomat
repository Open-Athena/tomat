def err(*a, **k):
    print(*a, file=sys.stderr, **k)


def fmt(x):
    return f"{x:5.2f}" if isinstance(x, (int, float)) else "  -  "


def match_runs(api, substr: str | None):
    """Walk all configured wandb projects (primary + archive). Per-run
    `entity`/`project` attrs let callers route URLs/uploads correctly.

    Empty/new projects (no runs yet) raise `ValueError("Could not find
    project ...")` from wandb's lazy iterator — we swallow that.
    """
    runs: list = []
    seen: set[tuple[str, str]] = set()
    for path in WANDB_PROJECTS:
        try:
            project_runs = list(api.runs(path))
        except ValueError as e:
            if "Could not find project" in str(e):
                continue  # newly-created, no runs yet
            raise
        for r in project_runs:
            key = (r.entity, r.name)
            if key in seen:
                continue
            seen.add(key)
            runs.append(r)
    if substr is None:
        return runs
    return [r for r in runs if substr in r.name]


def require_one(runs, substr: str):
    if not runs:
        err(f"no runs match {substr!r}")
        sys.exit(1)
    if len(runs) > 1:
        err(f"multiple runs match {substr!r}:")
        for r in runs:
            err(f"  {r.name}")
        sys.exit(1)
    return runs[0]


def _resolve_eval_step_list(
    steps_arg: str,
    run_label: str,
    bucket: str = GCS_BUCKET,
    ckpt_leaf: str | None = None,
) -> list[int]:
    """Parse `evals fire -s ...` and reconcile with the actual GCS ckpts.

    Handles the recurring Levanter OBO (`num_train_steps=N` produces a final
    `step-(N-1)` ckpt) and supports `-s latest` for "whatever's freshest."
    Errors loudly if a requested step doesn't exist (vs the old behavior of
    silently submitting an iris job that fails ~minutes later on ckpt load).
    """
    leaf = ckpt_leaf or run_label
    base = f"{bucket}/results/{run_label}/checkpoints/{leaf}"
    try:
        listing = subprocess.run(
            ["gcloud", "storage", "ls", f"{base}/"],
            capture_output=True, text=True, timeout=30,
        ).stdout
    except Exception as e:
        err(f"[evals fire] WARN: GCS ls failed ({type(e).__name__}: {e}); "
            f"falling back to raw `-s` values without pre-flight")
        return [int(s.strip()) for s in steps_arg.split(",")]
    available = sorted({
        int(m.group(1)) for m in re.finditer(r"step-(\d+)/?", listing)
    })
    if not available:
        err(f"[evals fire] no `step-*` ckpts at {base}/ — has training started?")
        sys.exit(1)

    resolved: list[int] = []
    for raw in steps_arg.split(","):
        raw = raw.strip()
        if raw.lower() in ("latest", "final", "last"):
            chosen = available[-1]
            err(f"[evals fire] -s {raw} → step-{chosen} "
                f"(latest of {len(available)} ckpts on GCS)")
            resolved.append(chosen)
            continue
        n = int(raw)
        if n in available:
            resolved.append(n)
        elif (n - 1) in available:
            err(f"[evals fire] WARN: step-{n} not on GCS but step-{n-1} is; "
                f"using step-{n-1} (Levanter num_train_steps={n} → final "
                f"step-{n-1} OBO). Pass `-s {n-1}` or `-s latest` to silence.")
            resolved.append(n - 1)
        else:
            near = [a for a in available if abs(a - n) <= max(1000, n // 20)]
            err(f"[evals fire] step-{n} not found on GCS. "
                f"Nearby: {near[-10:]}; latest: step-{available[-1]}")
            sys.exit(1)
    return resolved


def iris_run(*args: str, capture: bool = True, timeout: int = 180) -> subprocess.CompletedProcess:
    """Invoke `uv run iris --cluster=marin job <args>` from marin/."""
    cmd = [IRIS_BIN, "--cluster=marin", "job", *args]
    return subprocess.run(
        cmd,
        cwd=str(MARIN_DIR),
        capture_output=capture,
        text=True,
        timeout=timeout,
    )


def strip_iris_log(text: str) -> str:
    """Drop iris's `I20...` log lines so output is parseable."""
    return "\n".join(l for l in text.split("\n") if not l.startswith("I20"))


# iris requires --prefix to be `/<user>/<jobname>` (2+ segments). We fan
# out across the conventional job-name prefixes used in tomat work.
DEFAULT_IRIS_PREFIXES = ("/ryan/tomat", "/ryan/train", "/ryan/eval")


def iris_list_lines(prefixes: tuple[str, ...] = DEFAULT_IRIS_PREFIXES, state: str | None = None) -> list[str]:
    """Pull `iris job list` lines across multiple prefixes, deduped.

    Note: SEQUENTIAL on purpose. Each `iris` invocation establishes its
    own SSH tunnel on local port 10000; running them concurrently makes
    them fight for the port and serializes anyway (worse — `iris ls`
    measured at 49 s parallel vs 6 s sequential).
    """
    seen: set[str] = set()
    out_lines: list[str] = []
    for p in prefixes:
        args = ["list", "--prefix", p]
        if state:
            args += ["--state", state]
        res = iris_run(*args)
        if res.returncode != 0:
            continue
        for line in strip_iris_log(res.stdout).split("\n"):
            if not line.strip() or "JOB ID" in line:
                continue
            jid = line.split()[0] if line else ""
            if not jid.startswith("/") or jid in seen:
                continue
            seen.add(jid)
            out_lines.append(line)
    return out_lines


